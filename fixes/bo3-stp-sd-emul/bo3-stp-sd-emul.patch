+/* madeira [stp-sd] rev=stp-sd-1: on unless env MADEIRA_STP_SD_EMUL = 0. Logs its state once. */
+static int ios_stp_sd_on( void )
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "MADEIRA_STP_SD_EMUL" );
+        on = !(e && e[0] == '0' && !e[1]);
+        dprintf( 2, "[stp-sd] rev=stp-sd-1 %s (S/D pair stores onto RX-forced alias pages; MADEIRA_STP_SD_EMUL = 0 turns it off)\n",
+                 on ? "on" : "off" );
+    }
+    return on;
+}
