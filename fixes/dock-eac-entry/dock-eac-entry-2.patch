diff -ru a/app/Madeira/DockStartProgram.swift b/app/Madeira/DockStartProgram.swift
--- a/app/Madeira/DockStartProgram.swift	2026-11-28 04:10:37.240818021 +0000
+++ b/app/Madeira/DockStartProgram.swift	2026-11-28 04:14:10.966813725 +0000
@@ -53,6 +53,29 @@
     /// DroidDeck PR #1039 (reads EasyAntiCheat/Settings.json); written here without its code. Not device-tested.
     /// Off: env.MADEIRA_DOCK_START_EAC_OFFLINE = 0, or pick Steam's own program.
     static let eacOffline: [Int: String] = [1245620: "Game/eldenring.exe"]
+    /// (dock-eac-entry-2) Easy Anti-Cheat games whose Steam launch configuration has its own entry for the game without
+    /// EAC, started by Valve's client in the game's own folder with that entry's own arguments (Steam's "Play ... Anti-Cheat
+    /// Disabled" choice on Windows). Madeira Dock asks Valve's client for that entry instead of the default one, so Steam keeps
+    /// running and no file is swapped. Halo MCC (976730): the default entry is mcclauncher.exe (EAC: "Failed to initialize Wine
+    /// helper buffer", run 4 log); the game exe MCC/Binaries/Win64/MCC-Win64-Shipping.exe needs its own folder's DLLs (run 2:
+    /// c0000135) and quits with exit code 1 when started without Steam (run 3; cause unproven). Offline play only.
+    /// Matched by program path (case and slash direction ignored); no match = Steam's default entry, as before.
+    /// Off: env.MADEIRA_DOCK_EAC_ENTRY = 0. Not device-tested.
+    static let eacOfflineEntry: [Int: String] = [976730: "mcc/binaries/win64/mcc-win64-shipping.exe"]
+    /// Set by the app at start (MadeiraApp.init) to read env.MADEIRA_DOCK_EAC_ENTRY (Foundation-only file, see above).
+    nonisolated(unsafe) static var eacEntryEnabled: () -> Bool = { true }
+    /// The launch entry index (config.launch key) of `appID`'s no-EAC entry among `entries` (index, executable as Steam
+    /// spells it), or nil when the game has none listed, the switch is off, or no entry names that program.
+    static func eacOfflineEntryIndex(_ appID: Int, entries: [(index: UInt32?, executable: String)]) -> UInt32? {
+        guard eacEntryEnabled(), let want = eacOfflineEntry[appID] else { return nil }
+        func norm(_ path: String) -> String {
+            var p = path.trimmingCharacters(in: .whitespaces).replacingOccurrences(of: "\\", with: "/").lowercased()
+            while p.hasPrefix("./") { p.removeFirst(2) }
+            while p.hasPrefix("/") { p.removeFirst() }
+            return p
+        }
+        return entries.first(where: { $0.index != nil && norm($0.executable) == want })?.index
+    }
     /// Set by the app at start (MadeiraApp.init) to read env.MADEIRA_DOCK_START_EAC_OFFLINE; this file stays
     /// Foundation-only so the host check (tests/host/check-dock-start-program.py) compiles it alone.
     nonisolated(unsafe) static var eacOfflineEnabled: () -> Bool = { true }
