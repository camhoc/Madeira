+    /// (dock-launch-entry-fallback) The launch entry Madeira Dock asks Steam for when `choose`
+    /// found no .exe on disk: the same candidates (Windows, outside beta branches, the game
+    /// itself, ranked as in `choose`), the best one's index, whatever its program is (a .bat
+    /// is Steam's to start). nil when there is none.
+    static func dockFallbackIndex(_ options: [SteamLaunchOption]) -> UInt32? {
+        var best: (rank: Int, order: Int, index: UInt32)? = nil
+        for (order, option) in options.enumerated() {
+            let type = option.type.lowercased()
+            guard let index = option.index, option.betaKey.isEmpty, !otherKinds.contains(type),
+                  option.requiredDLC == nil || option.requiredDLC == "" || option.requiredDLC == "0",
+                  option.oslist.isEmpty || option.oslist.lowercased().contains("windows") else { continue }
+            let kind = type == "default" ? 0 : (type.isEmpty || type == "none" ? 1 : 2)
+            let arch = option.osarch == "64" ? 0 : (option.osarch.isEmpty ? 1 : 2)
+            let rank = kind * 3 + arch
+            if best == nil || rank < best!.rank || (rank == best!.rank && order < best!.order) {
+                best = (rank, order, index)
+            }
+        }
+        return best?.index
+    }
+
