+    private static let linksSuffix = ".madeira-dlllinks"
+
+    /// Links the ".dll" files beside `source` into the folder of `target` (when the two folders differ),
+    /// skipping any name that already exists there. Earlier links of ours are removed first.
+    private static func linkDlls(of source: URL, for target: URL, enabled: Bool, files: FileManager) throws {
+        try removeDllLinks(for: target, files: files)
+        let from = source.deletingLastPathComponent().standardizedFileURL
+        let into = target.deletingLastPathComponent().standardizedFileURL
+        guard enabled, from.path != into.path else { return }
+        var made: [String] = []
+        // A failure part-way still lists the links made so far, so a restore removes them.
+        defer {
+            if !made.isEmpty { try? made.joined(separator: "\n").write(toFile: target.path + linksSuffix, atomically: true, encoding: .utf8) }
+        }
+        for name in try files.contentsOfDirectory(atPath: from.path).sorted() where name.lowercased().hasSuffix(".dll") {
+            let link = into.appendingPathComponent(name)
+            if files.fileExists(atPath: link.path) || isLink(link, files: files) { continue }
+            try files.createSymbolicLink(atPath: link.path,
+                                         withDestinationPath: relativePath(from: into, to: from.appendingPathComponent(name)))
+            made.append(name)
+        }
+    }
+
+    /// Takes out the links listed in "<launcher>.madeira-dlllinks" (only symbolic links, only plain names).
+    private static func removeDllLinks(for target: URL, files: FileManager) throws {
+        let list = target.path + linksSuffix
+        guard let text = try? String(contentsOfFile: list, encoding: .utf8) else { return }
+        let dir = target.deletingLastPathComponent()
+        for name in text.split(separator: "\n") where !name.contains("/") && !name.hasPrefix(".") {
+            let link = dir.appendingPathComponent(String(name))
+            if isLink(link, files: files) { try files.removeItem(at: link) }
+        }
+        try files.removeItem(atPath: list)
+    }
+
