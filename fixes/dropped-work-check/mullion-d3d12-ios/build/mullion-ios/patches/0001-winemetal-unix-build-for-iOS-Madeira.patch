+/* Madeira: iOS build of Mullion's winemetal unix side (LGPL-2.1+, like Mullion).
+ * Included first by winemetal_unix.c and cache.c. On macOS it only defines
+ * MLN_SDK_AT_LEAST, so the Mac build is unchanged.
+ *
+ * On iOS this file sits in the SAME app image as DXMT's winemetal, so:
+ * - ObjC classes are renamed (class names are process-global at runtime),
+ * - the call tables are renamed (build/mullion-ios/build.sh then hides every
+ *   other symbol with ld -r -exported_symbols_list),
+ * - the Mac-only headers are swapped for UIKit + small stubs. */
+#ifndef MULLION_IOS_H
+#define MULLION_IOS_H
+#include <TargetConditionals.h>
+
+#if TARGET_OS_IOS
+#include <Availability.h>
+/* the Mac SDK numbers Mullion tests map to the iOS SDK of the same year */
+#define MLN_SDK_AT_LEAST(mac) (__IPHONE_OS_VERSION_MAX_ALLOWED >= ((mac) == 150000 ? 180000 : (mac) == 160000 ? 260000 : (mac)))
+
+#define CacheReader MullionCacheReader
+#define CacheWriter MullionCacheWriter
+#define WMTListenerHold MullionListenerHold
+#define WMTSharedNameKeeper MullionSharedNameKeeper
+#define __wine_unix_call_funcs mullion_winemetal_unix_call_funcs
+#define __wine_unix_call_wow64_funcs mullion_winemetal_unix_call_wow64_funcs
+#else
+#define MLN_SDK_AT_LEAST(mac) (__MAC_OS_X_VERSION_MAX_ALLOWED >= (mac))
+#endif
+
+#endif
