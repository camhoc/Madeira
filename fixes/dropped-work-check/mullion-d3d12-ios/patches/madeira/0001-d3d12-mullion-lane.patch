+/* d3d12 = mullion (experimental; Mullion, github.com/dttdrv/mullion, LGPL-2.1+):
+ * this session's d3d12.dll, d3d12core.dll, dxgi.dll, d3d11.dll and d3d10core.dll
+ * are Mullion's (vulkan/mullion in the bundle, build/mullion-ios/build-pe.sh),
+ * Direct3D 12 straight on Metal with mesh shaders. They import mlnmetal.dll (Mullion's
+ * winemetal under another name), whose unix side is bound only in a build made with
+ * MADEIRA_MULLION=1 (build/ntdll-unix/virtual_ios.c). Mullion's D3D11 comes too, because
+ * its dxgi is not DXMT's. Unset or anything else changes nothing: every session relinks
+ * the farms first, so the next session gets madeira-d3d12 and DXMT again. Refused with
+ * d3d11 = dxvk (both would own dxgi.dll). x64 programs only. */
+static void madeira_setup_mullion(NSFileManager *fm, NSString *prefix, NSString *bundle, BOOL use_arm64ec)
+{
+    char v[32] = "";
+    NSString *win = [prefix stringByAppendingPathComponent:@"drive_c/windows"];
+    NSString *stack = [bundle stringByAppendingPathComponent:@"vulkan/mullion"];
+    NSArray<NSString *> *dlls = @[@"d3d12.dll", @"d3d12core.dll", @"dxgi.dll", @"d3d11.dll", @"d3d10core.dll",
+                                  @"mlnmetal.dll"];
+    NSArray<NSString *> *dirs = use_arm64ec ? @[@"system32", @"sysx64"] : @[@"sysx64"];
+    int linked = 0;
+
+    /* a previous session's Mullion links: mlnmetal.dll is in no farm, and a !use_arm64ec session's relink keeps a
+     * system32 link that still resolves, so remove every link into the bundle's Mullion folder */
+    for (NSString *dir in @[@"system32", @"sysx64"])
+        for (NSString *dll in dlls) {
+            NSString *path = [[win stringByAppendingPathComponent:dir] stringByAppendingPathComponent:dll];
+            NSString *dest = [fm destinationOfSymbolicLinkAtPath:path error:nil];
+            if (dest && [dest rangeOfString:@"/vulkan/mullion/"].location != NSNotFound)
+                [fm removeItemAtPath:path error:nil];
+        }
+    if (!madeira_cfg_get("d3d12", v, sizeof v) || strcasecmp(v, "mullion")) return;
+    if (madeira_d3d11_dxvk_wanted()) {
+        dprintf(STDERR_FILENO, "[mullion] d3d12 = mullion ignored with d3d11 = dxvk (both need their own dxgi.dll)\n");
+        return;
+    }
+    for (NSString *dll in dlls)
+        if (access([stack stringByAppendingPathComponent:dll].fileSystemRepresentation, R_OK) != 0) {
+            dprintf(STDERR_FILENO, "[mullion] d3d12 = mullion, but the bundle has no vulkan/mullion/%s "
+                    "(build/mullion-ios/build-pe.sh): madeira-d3d12 stays\n", dll.UTF8String);
+            return;
+        }
+    for (NSString *dir in dirs)
+        for (NSString *dll in dlls)
+            linked += madeira_link_vulkan_file(fm, [win stringByAppendingPathComponent:dir], dll,
+                                               [stack stringByAppendingPathComponent:dll]);
+    dprintf(STDERR_FILENO, "[mullion] on: D3D12, D3D10/11 and DXGI = Mullion (%d links in %s)\n", linked,
+            use_arm64ec ? "system32 + sysx64" : "sysx64");
+}
