+            return Expected;
+          } else {
+            // CAS managed to tear, we can't really solve this
+            // Continue down the path to let the guest know values weren't expected
+            Tear = true;
+            FEXCORE_TELEMETRY_SET(TYPE_CAS_32BIT_TEAR, 1);
