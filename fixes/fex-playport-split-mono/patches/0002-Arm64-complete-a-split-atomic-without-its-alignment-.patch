+    // ARM64 ex:
+    // ldr x0, [x1];
+    // add x0, x0, #1;
+    // str x0, [x1];
+    //
+    // x86-64 ex:
+    // inc qword [rax];
+    auto Current = AtomicVariable.load(std::memory_order_relaxed);
+    AtomicVariable.store(Current + Value, std::memory_order_relaxed);
