+    // FEX very specifically wants to use simple loadstore instructions for this
+    //
+    // ARM64 ex:
+    // ldr x0, [x1];
+    // sub x0, x0, #1;
+    // str x0, [x1];
+    //
+    // x86-64 ex:
+    // dec qword [rax];
+    auto Current = AtomicVariable.load(std::memory_order_relaxed);
+    AtomicVariable.store(Current - Value, std::memory_order_relaxed);
+    return Current;
+  }
