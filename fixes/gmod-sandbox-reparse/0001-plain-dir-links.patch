+/* env.MADEIRA_PLAIN_DIR_LINKS = 1: do not report directory symlinks / mount points as
+ * reparse points. Chromium's sandbox refuses file rules for paths crossing a reparse point. Default off. */
+static BOOL madeira_plain_dir_links(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *e = getenv( "MADEIRA_PLAIN_DIR_LINKS" );
+        cached = (e && e[0] == '1');
+    }
+    return cached;
+}
+
