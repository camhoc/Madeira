+bool
+msl_vs_position_float(const struct nir_to_msl_ctx *ctx, unsigned location)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("MADEIRA_KK_POS_FLOAT");
+      on = !(e && e[0] == '0' && e[1] == '\0');
