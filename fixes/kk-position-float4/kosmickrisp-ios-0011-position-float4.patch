+/* madeira [kk-pos-float]: a vertex shader's position output is always float4,
+ * as Metal's [[position]] requires; an integer store is bit-cast to float.
+ * env MADEIRA_KK_POS_FLOAT = 0 keeps the old behaviour (the output's own type). */
+bool msl_vs_position_float(const struct nir_to_msl_ctx *ctx, unsigned location);
+
