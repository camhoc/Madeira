+/* 1 (default): a commit whose caller is an Apple system image (RenderBox: SwiftUI's own render
+ * thread) is never held. Held, it left the main thread waiting on RenderBox in the scene-update
+ * watchdog (10 s) when Madeira went to the background: 0x8BADF00D, SIGKILL 31W. 0 = old behaviour. */
+static int mbg_skip_system = 1;
+
+void madeira_metal_gate_skip_system(int on) { mbg_skip_system = on; }
+
+static int mbg_caller_is_system(void *ra) {
+    Dl_info info;
