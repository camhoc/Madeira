+    /// Nov 27 2026). Off for this game: env.MADEIRA_WG_64BIT = 0.
+    static let planetCrafter = GameRecommendation(
+        id: "planet-crafter", title: "The Planet Crafter", version: 1,
+        config: """
+        # Madeira's recommended settings for The Planet Crafter.
+        # Reset to Recommended, at the bottom of the game's settings, brings them back.
+        env.MADEIRA_EC_HOOK_TRACE = 0
+        env.MADEIRA_WG_64BIT = 1
+        env.MADEIRA_WG_VIDEO_FORMAT = argb32
+        env.MADEIRA_D3D11_NO_VIDEO_DEVICE = 1
+        """)
