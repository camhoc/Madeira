+/* [pool-reserve] An exec-time reservation for the JIT pool (idea from Playport's wine_host.c,
+ * `host_pool_reserve`, GPL-3.0-or-later; written here from its description, not copied).
+ *
+ * The constructor below runs after dyld, libmalloc and iOS have mapped their own regions, and logs
+ * show them landing in the range the pool needs: a VM tag 1 malloc region at +0x1d00000 inside a
+ * 128MB block (0x141d00000 FFVII, 0x151d00000 Requiem, 0x14bd00000 Sentry 8A, 0x15dd00000 ph-rdr90),
+ * iOS Skywalk reservations (tag 87, 63-71MB), a ~103MB read-only mapping. A zero-filled static array
+ * is mapped with the executable image itself, before any of them, so it holds the range from exec.
+ * Untouched it costs no footprint (Playport measured the same on a phone).
+ *
+ * It starts where the image ends (the slide moves it: 0x1023..0x10a.. seen in our logs) and is
+ * sized to reach past the end of a 576MB window at 0x140000000 (0x164000000) at the highest slide
+ * yet stay under the lowest main-thread stack seen (0x16af64000).
+ *
+ * What this does with it:
+ *  - constructor(100) gives back [0x140000000, end) at once, so constructor(101) claims the window and
+ *    the run above it exactly as before (an array that covers 0x140000000 would make that claim fail);
+ *  - the part BELOW 0x140000000 stays held until StikJITHelper asks for it back, immediately before the
+ *    hole census (madeira_pool_reserve_release), when the census then finds it as one free run;
+ *  - with `pool-reserve = 0` (madeira.cfg) or `env.MADEIRA_POOL_RESERVE = 0`, the whole array is given
+ *    back in constructor(100): the old behaviour, so a build with this change can be A/B tested.
+ * Default: ON for the first device test only if the build thread decides so; see DEFAULT below. */
+#define MADEIRA_POOL_RESERVE_BYTES (1440ull << 20)
+static char madeira_pool_reserve[MADEIRA_POOL_RESERVE_BYTES] __attribute__((aligned(0x4000), used));
+unsigned long madeira_pool_reserve_lo, madeira_pool_reserve_hi;
+#define MADEIRA_POOL_RESERVE_DEFAULT 0   /* 0: off unless `pool-reserve = 1`; the A/B test turns it on */
+
+__attribute__((constructor(100), used)) static void madeira_pool_reserve_claim(void)
+{
+    const vm_address_t lo = (vm_address_t)madeira_pool_reserve, hi = lo + MADEIRA_POOL_RESERVE_BYTES;
+    const vm_address_t win = 0x140000000ul;
+    const char *e = getenv("MADEIRA_POOL_RESERVE");
+    int on = e ? !(e[0] == '0' && !e[1]) : madeira_cfg_bool("pool-reserve", MADEIRA_POOL_RESERVE_DEFAULT);
+    if (!on || lo >= win) {                       /* off, or the image sits too high: all of it back */
+        vm_deallocate(mach_task_self(), lo, MADEIRA_POOL_RESERVE_BYTES);
+        return;
+    }
+    if (hi > win)                                 /* the window and everything above it: back now */
+        vm_deallocate(mach_task_self(), win, hi - win);
+    madeira_pool_reserve_lo = lo;
+    madeira_pool_reserve_hi = hi > win ? win : hi;
+}
+
+/* Gives the held low part back (once). Returns its size, 0 when nothing was held; *lo gets its start. */
+unsigned long madeira_pool_reserve_release(unsigned long *lo)
+{
+    unsigned long a = madeira_pool_reserve_lo, n = madeira_pool_reserve_hi - madeira_pool_reserve_lo;
+    if (!a || !n) return 0;
+    if (lo) *lo = a;
+    madeira_pool_reserve_lo = madeira_pool_reserve_hi = 0;
+    vm_deallocate(mach_task_self(), a, n);
+    return n;
+}
