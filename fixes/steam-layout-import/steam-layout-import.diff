+    /// steam-layout-import: reads the chosen file and replaces the binds table; the line it returns is shown under the button.
+    private func importLayout(_ result: Result<URL, Error>) -> String {
+        guard let url = try? result.get() else { return "No file chosen." }
+        let scoped = url.startAccessingSecurityScopedResource()
+        defer { if scoped { url.stopAccessingSecurityScopedResource() } }
+        guard let data = try? Data(contentsOf: url), data.count < 2_000_000 else { return "That file could not be read." }
+        guard let layout = SteamLayoutImport.convert(String(decoding: data, as: UTF8.self)) else {
+            return "That is not a Steam Input layout (no controller_mappings block or no preset with bindings)."
+        }
+        if layout.binds.isEmpty { return SteamLayoutImport.summary(layout) + " Nothing changed." }
+        binds = layout.binds
+        return SteamLayoutImport.summary(layout)
+    }
+
     /// Anything to reset: a bound row or a vertical speed other than 1.
     var changed: Bool { !(binds ?? [:]).isEmpty || mouseVertical != nil }
     func reset() { binds = nil; mouseVertical = nil }
