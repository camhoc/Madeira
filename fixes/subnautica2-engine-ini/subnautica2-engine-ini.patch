+/// madeira-ue-ini-seed: an Unreal game's [SystemSettings] lines, written into its Saved/Config/Windows/Engine.ini in
+/// the prefix before each start. Subnautica 2 (a UE 5.6 shipping build) reads cvars only from that file: -dpcvars and
+/// -ini: are ignored in shipping builds (0.2.180 game log: the -dpcvars text is on "Command Line:" but no "Set CVar"
+/// line follows), and the game deletes Engine.ini while it runs, so the file has to be put back every start.
+/// The game's own config sets it:  env.MADEIRA_UE_INI_SEED = <Project>: key=value,key=value
+/// Missing, empty or 0 = off (nothing is written). Lines the file already has get the seed's value; others stay.
+/// Called from the Dock start and from a library launch, only while no session runs.
+enum UnrealIniSeed {
+    /// (project, [(key, value)]) or nil when off or malformed.
+    static func parse(_ raw: String?) -> (project: String, pairs: [(String, String)])? {
+        guard let raw = raw?.trimmingCharacters(in: .whitespaces), !raw.isEmpty, raw != "0",
+              let colon = raw.firstIndex(of: ":") else { return nil }
+        let project = raw[..<colon].trimmingCharacters(in: .whitespaces)
+        let allowed = CharacterSet.alphanumerics.union(CharacterSet(charactersIn: "_-."))
+        guard !project.isEmpty, project != ".", project != "..", project.unicodeScalars.allSatisfy({ allowed.contains($0) }) else { return nil }
+        var pairs: [(String, String)] = []
+        for item in raw[raw.index(after: colon)...].split(separator: ",") {
+            guard let eq = item.firstIndex(of: "=") else { continue }
+            let key = item[..<eq].trimmingCharacters(in: .whitespaces)
+            let value = item[item.index(after: eq)...].trimmingCharacters(in: .whitespaces)
+            guard !key.isEmpty, !key.contains("["), !key.contains("]"), !key.contains(";") else { continue }
+            pairs.append((key, value))
+        }
+        return pairs.isEmpty ? nil : (project, pairs)
+    }
+
+    @MainActor static func write(prefix: URL, gameConfig: String, label: String) {
+        guard let seed = parse(GameProfile.parse(gameConfig)["env.MADEIRA_UE_INI_SEED"]) else { return }
+        guard wine_process_is_running() == 0, wineserver_is_running() == 0 else {
+            LogStore.shared.log("[ue-ini-seed] \(label) project=\(seed.project) not written: a Wine session is running", level: .error); return
+        }
+        let fm = FileManager.default
+        let drive = prefix.appendingPathComponent("drive_c")
+        let users = GameConfigFolders.matches("users/*", drive: drive).filter {
+            let name = ($0 as NSString).lastPathComponent.lowercased()
+            return name != "public" && fm.fileExists(atPath: drive.appendingPathComponent($0).appendingPathComponent("AppData").path)
+        }
+        guard !users.isEmpty else {
+            LogStore.shared.log("[ue-ini-seed] \(label) project=\(seed.project) not written: no user folder in the prefix", level: .error); return
+        }
+        for user in users {
+            let folder = drive.appendingPathComponent(user).appendingPathComponent("AppData/Local/\(seed.project)/Saved/Config/Windows", isDirectory: true)
+            let file = folder.appendingPathComponent("Engine.ini")
+            do {
+                try fm.createDirectory(at: folder, withIntermediateDirectories: true)
+                let old = fm.contents(atPath: file.path)
+                let read = old.flatMap { IniFileText(data: $0) }
+                if old != nil && read == nil {
+                    LogStore.shared.log("[ue-ini-seed] \(label) \(user) not written: the existing Engine.ini could not be read as text; left as it is", level: .error); continue
+                }
+                var doc = IniDocument(text: read?.text ?? "")
+                for (key, value) in seed.pairs where doc.value(section: "SystemSettings", key: key) != value {
+                    doc.add(section: "SystemSettings", key: key, value: value)
+                }
+                guard let data = (read ?? IniFileText(data: Data()))?.data(doc.text) else {
+                    LogStore.shared.log("[ue-ini-seed] \(label) \(user) not written: text did not encode", level: .error); continue
+                }
+                if data == old {
+                    LogStore.shared.log("[ue-ini-seed] \(label) \(user)/.../\(seed.project)/Saved/Config/Windows/Engine.ini already has \(seed.pairs.count) settings")
+                    continue
+                }
+                try data.write(to: file, options: .atomic)
+                LogStore.shared.log("[ue-ini-seed] \(label) wrote \(seed.pairs.count) [SystemSettings] lines to \(user)/AppData/Local/\(seed.project)/Saved/Config/Windows/Engine.ini (was \(old == nil ? "missing" : "present"))")
+            } catch {
+                LogStore.shared.log("[ue-ini-seed] \(label) \(user) not written: \(error.localizedDescription)", level: .error)
+            }
+        }
+    }
+}
