+    /// The last `bytes` of a file as text lines (the log is appended to by several writers, so read it plainly).
+    private static func tailLines(_ url: URL, bytes: UInt64) -> [String] {
+        guard let h = try? FileHandle(forReadingFrom: url) else { return [] }
+        defer { try? h.close() }
+        let size = (try? h.seekToEnd()) ?? 0
+        try? h.seek(toOffset: size > bytes ? size - bytes : 0)
+        let text = String(decoding: (try? h.readToEnd()) ?? Data(), as: UTF8.self)
+        return text.split(separator: "\n", omittingEmptySubsequences: true).map(String.init)
+    }
