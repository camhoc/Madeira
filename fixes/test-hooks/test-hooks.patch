+    // MARK: command file (no links needed)
+
+    private static var commandTimer: DispatchSourceTimer?
+
+    /// The PC cannot always open madeira:// links on the iPad, so the same hooks run from a file: it writes
+    /// Documents/test-hooks/command.txt over AFC (house_arrest), one command on the first line:
+    ///   launch <appid> | quit | quit force | relaunch <appid> | status | export-logs [appid]
+    ///   | key <name>[+<name>] | tap <x>,<y> | config <appid> <key> = <value> | config <appid> unset <key>   (see runExtra)
+    /// Polled every 2 s on a background timer (so it works while a game runs); the file is deleted when read and the
+    /// outcome is written to Documents/test-hooks/command-result.txt ("<time> <command>: done" or an error).
+    /// A file older than 120 s is deleted unread. launch while a game is running is a relaunch (one game per app run).
+    /// Same gate as the links (iPad ID + env.MADEIRA_IPAD_TEST_HOOKS = 1): startCommandFile returns at once otherwise.
+    static func startCommandFile() {
+        guard enabled, commandTimer == nil, let dir = testDir else { return }
+        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let file = dir.appendingPathComponent("command.txt"), result = dir.appendingPathComponent("command-result.txt")
+        let t = DispatchSource.makeTimerSource(queue: DispatchQueue.global(qos: .utility))
+        t.schedule(deadline: .now() + 3, repeating: 2)
+        t.setEventHandler {
+            let fm = FileManager.default
+            guard fm.fileExists(atPath: file.path) else { return }
+            let age = ((try? fm.attributesOfItem(atPath: file.path)[.modificationDate] as? Date) ?? Date()).timeIntervalSinceNow
+            let text = (try? String(contentsOf: file, encoding: .utf8)) ?? ""
+            try? fm.removeItem(at: file)
+            let line = (text.split(whereSeparator: \.isNewline).first.map(String.init) ?? "").trimmingCharacters(in: .whitespaces)
+            let words = line.split(separator: " ").map(String.init)
+            func report(_ m: String) {
+                LogStore.shared.log("[ipad-hooks] command file: \(line): \(m)")
+                try? "\(ISO8601DateFormatter().string(from: Date())) \(line): \(m)\n".write(to: result, atomically: true, encoding: .utf8)
+            }
+            if age < -120 { report("ignored, file older than 120 s"); return }
+            switch words.first?.lowercased() {
+            case "key", "tap", "config":
+                // Input to the running game and per-game config edits (test-hooks); each returns what happened.
+                DispatchQueue.main.async { report(runExtra(words, line: line)) }
+                return
+            default: break
+            }
+            var link: String?
+            switch (words.first?.lowercased(), words.count) {
+            case ("launch", 2), ("relaunch", 2): if let a = Int(words[1]), a > 0 { link = "relaunch?steam=\(a)" }
+            case ("quit", 1): link = "quit"
+            case ("quit", 2) where words[1].lowercased() == "force": link = "quit?force=1"
+            case ("status", 1): link = "status"
+            case ("export-logs", 1): link = "export-logs"
+            case ("export-logs", 2): if let a = Int(words[1]), a > 0 { link = "export-logs?steam=\(a)" }
+            default: break
+            }
+            guard var host = link else { report("not understood"); return }
+            DispatchQueue.main.async {
+                // launch: a plain launch link when no game runs, else the relaunch path (a second game needs a new app run).
+                if words[0].lowercased() == "launch", LibraryModel.shared.current == nil { host = "launch?steam=\(words[1])" }
+                if let url = URL(string: "madeira://" + host) { _ = handle(url) }
+                report("done")
+            }
+        }
+        t.resume()
+        commandTimer = t
+        LogStore.shared.log("[ipad-hooks] command file armed: Documents/test-hooks/command.txt")
+    }
+
+    private static let keyCodes: [String: Int32] = [
+        "enter": 0x0D, "return": 0x0D, "esc": 0x1B, "escape": 0x1B, "space": 0x20, "tab": 0x09, "backspace": 0x08,
+        "up": 0x26, "down": 0x28, "left": 0x25, "right": 0x27, "ctrl": 0x11, "alt": 0x12, "shift": 0x10,
+    ]
+    private static func vk(_ name: String) -> Int32? {
+        let n = name.lowercased()
+        if let v = keyCodes[n] { return v }
+        if n.count >= 2, n.hasPrefix("f"), let k = Int(n.dropFirst()), (1...12).contains(k) { return Int32(0x6F + k) }
+        if n.count == 1, let c = n.uppercased().unicodeScalars.first, c.isASCII,
+           ("A"..."Z").contains(Character(c)) || ("0"..."9").contains(Character(c)) { return Int32(c.value) }
+        return nil
+    }
+
+    /// key <name>[+<name>...]  (e.g. key enter, key esc, key alt+f4)   tap <x>,<y>   (game coordinates, as winios_post_touch_*)
+    /// config <appid> <key> = <value>   config <appid> unset <key>   (the game's own config, GameProfiles.swift; applies at its next start).
+    /// Main thread. key and tap need a running game; the config file is copied to
+    /// Documents/test-hooks/config-backups/<appid>-<time>.cfg first, and the change is logged.
+    private static func runExtra(_ w: [String], line: String) -> String {
+        let model = LibraryModel.shared
+        switch w[0].lowercased() {
+        case "key":
+            guard w.count == 2, model.current != nil else { return "needs a running game: key <name>" }
+            let codes = w[1].split(separator: "+").map { vk(String($0)) }
+            guard !codes.isEmpty, !codes.contains(where: { $0 == nil }) else { return "unknown key" }
+            let keys = codes.compactMap { $0 }
+            for k in keys { winios_post_key(k, 1) }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.08) { for k in keys.reversed() { winios_post_key(k, 0) } }
+            return "done"
+        case "tap":
+            let xy = (w.count == 2 ? w[1] : "").split(separator: ",").compactMap { Int32($0) }
+            guard xy.count == 2, model.current != nil else { return "needs a running game: tap <x>,<y>" }
+            winios_post_touch_down(xy[0], xy[1])
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.08) { winios_post_touch_up(xy[0], xy[1]) }
+            return "done"
+        default:
+            return editConfig(line)
+        }
+    }
+
+    private static func editConfig(_ line: String) -> String {
+        // "config <appid> <key> = <value>" or "config <appid> unset <key>"; the value may contain spaces.
+        let parts = line.split(separator: " ", maxSplits: 2, omittingEmptySubsequences: true).map(String.init)
+        guard parts.count == 3, let app = Int(parts[1]), app > 0 else { return "not understood: config <appid> <key> = <value>" }
+        guard let entry = LibraryModel.shared.entries.first(where: { $0.steamAppID == app }) else { return "Steam app \(app) is not in the library" }
+        var key: String, value: String?
+        if parts[2].lowercased().hasPrefix("unset ") {
+            key = String(parts[2].dropFirst(6)).trimmingCharacters(in: .whitespaces); value = nil
+        } else if let eq = parts[2].firstIndex(of: "=") {
+            key = parts[2][..<eq].trimmingCharacters(in: .whitespaces)
+            value = parts[2][parts[2].index(after: eq)...].trimmingCharacters(in: .whitespaces)
+        } else { return "not understood: config <appid> <key> = <value>" }
+        guard !key.isEmpty, !key.contains(where: { $0.isWhitespace || $0 == "#" || $0 == "=" }),
+              !(value ?? "").contains(where: { $0.isNewline }) else { return "bad key or value" }
+        let file = GameProfile(windowsPath: entry.windowsPath)
+        let old = file.text
+        if let dir = testDir?.appendingPathComponent("config-backups", isDirectory: true) {
+            try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+            let stamp = DateFormatter(); stamp.dateFormat = "yyyyMMdd-HHmmss"
+            try? old.write(to: dir.appendingPathComponent("\(app)-\(stamp.string(from: Date())).cfg"), atomically: true, encoding: .utf8)
+        }
+        // Drop every line that sets this key (the native reader lets the last one win), then add the new one.
+        var lines = old.components(separatedBy: "\n").filter { l in
+            let t = l.trimmingCharacters(in: .whitespaces)
+            guard !t.hasPrefix("#"), let eq = t.firstIndex(of: "=") else { return true }
+            return t[..<eq].trimmingCharacters(in: .whitespaces) != key
+        }
+        while lines.last?.trimmingCharacters(in: .whitespaces).isEmpty == true { lines.removeLast() }
+        if let value { lines.append("\(key) = \(value)") }
+        file.text = lines.joined(separator: "\n")
+        LogStore.shared.log("[ipad-hooks] config \(entry.title) (\(app)): \(value.map { "\(key) = \($0)" } ?? "unset \(key)"); backup in test-hooks/config-backups")
+        return "done"
+    }
+
+    /// Per-run logs: Documents/logs/ already keeps the newest 40 session logs (LogStore.startSessionLog). At every app start
+    /// this also copies the previous run's madeira-log.prev.txt (written by LogStore at launch) to
+    /// Documents/test-hooks/runs/<time>-prev.txt, newest 20 kept, so one finished run is never lost to the next start.
+    static func keepPreviousRunLog() {
+        guard let dir = testDir, let docs = LogFiles.documents else { return }
+        let fm = FileManager.default
+        let prev = docs.appendingPathComponent("madeira-log.prev.txt")
+        guard fm.fileExists(atPath: prev.path) else { return }
+        let runs = dir.appendingPathComponent("runs", isDirectory: true)
+        try? fm.createDirectory(at: runs, withIntermediateDirectories: true)
+        let stamp = DateFormatter(); stamp.dateFormat = "yyyy-MM-dd_HH-mm-ss"
+        let mod = (try? fm.attributesOfItem(atPath: prev.path)[.modificationDate] as? Date) ?? Date()
+        let dest = runs.appendingPathComponent(stamp.string(from: mod) + "-prev.txt")
+        if !fm.fileExists(atPath: dest.path) { try? fm.copyItem(at: prev, to: dest) }
+        let old = ((try? fm.contentsOfDirectory(atPath: runs.path)) ?? []).sorted().dropLast(20)
+        for f in old { try? fm.removeItem(at: runs.appendingPathComponent(f)) }
     }
 
     private static func export(steam: Int?) {
