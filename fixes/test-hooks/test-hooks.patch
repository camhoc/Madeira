+    static func keepPreviousRunLog() {
+        guard let dir = testDir, let docs = LogFiles.documents else { return }
+        let fm = FileManager.default
+        let prev = docs.appendingPathComponent("madeira-log.prev.txt")
+        guard fm.fileExists(atPath: prev.path) else { return }
+        let runs = dir.appendingPathComponent("runs", isDirectory: true)
+        try? fm.createDirectory(at: runs, withIntermediateDirectories: true)
+        let stamp = DateFormatter(); stamp.dateFormat = "yyyy-MM-dd_HH-mm-ss"
+        let mod = (try? fm.attributesOfItem(atPath: prev.path)[.modificationDate] as? Date) ?? Date()
+        let dest = runs.appendingPathComponent(stamp.string(from: mod) + "-prev.txt")
+        if !fm.fileExists(atPath: dest.path) { try? fm.copyItem(at: prev, to: dest) }
+        let old = ((try? fm.contentsOfDirectory(atPath: runs.path)) ?? []).sorted().dropLast(20)
+        for f in old { try? fm.removeItem(at: runs.appendingPathComponent(f)) }
