+    /// madeira://quit asks the running game to close (Alt+F4, same as the in-game Quit); with no game it closes Madeira.
+    /// madeira://quit?force=1 closes Madeira at once (exit(0), the same exit as Close Madeira).
+    static func quit(force: Bool) {
+        guard enabled else { return }
+        DispatchQueue.main.async {
+            let model = LibraryModel.shared
+            if !force, model.current != nil {
+                LogStore.shared.log("[ipad-hooks] quit: asking the game to close")
+                model.requestQuit()
+            } else {
+                LogStore.shared.log("[ipad-hooks] quit: closing Madeira")
+                exit(0)
+            }
+        }
+    }
