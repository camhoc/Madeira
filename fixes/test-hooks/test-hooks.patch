+    /// madeira://relaunch?steam=<appid>: closes the game, then Madeira closes with that game queued (NextSteamApp), so the
+    /// next app run starts it by itself. iOS cannot reopen an app that exited: the PC opens Madeira again
+    /// (e.g. madeira://launch?steam=<appid> or just the app). Waits up to 20 s for the game to end, then closes anyway.
+    static func relaunch(steam app: Int) {
+        guard enabled else { return }
+        DispatchQueue.main.async {
+            let model = LibraryModel.shared
+            LogStore.shared.log("[ipad-hooks] relaunch: Steam app \(app) queued, closing Madeira")
+            NextSteamApp.set(app)
+            if model.current != nil { model.requestQuit() }
+            func closeWhenDone(_ left: Int) {
+                if model.current == nil || left <= 0 { exit(0) }
+                DispatchQueue.main.asyncAfter(deadline: .now() + 1) { closeWhenDone(left - 1) }
+            }
+            closeWhenDone(20)
+        }
+    }
