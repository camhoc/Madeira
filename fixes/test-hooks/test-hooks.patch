+    /// madeira://status: Documents/test-hooks/status.json (the PC reads it over AFC). Also written 15 s after app start.
+    /// "frames_in_tail" adds the "present N/s" figures of the [frame] lines in the last 512 KB of madeira-log.txt (one per second,
+    /// so it is a frame count only while env.MADEIRA_FRAME_STATS is on); "present_fps" is the newest of them.
+    static func writeStatus() {
+        guard enabled, let dir = testDir, let docs = LogFiles.documents else { return }
+        DispatchQueue.main.async {
+            let model = LibraryModel.shared
+            let entry = model.activeEntry
+            let game: [String: Any] = [
+                "running": model.current != nil,
+                "title": entry?.title ?? "",
+                "steam_app": entry?.steamAppID ?? 0,
+                "sessions_this_run": LibraryModel.sessionsThisRun,
+            ]
+            DispatchQueue.global(qos: .utility).async {
+                let tail = tailLines(docs.appendingPathComponent("madeira-log.txt"), bytes: 512 * 1024)
+                var presentFPS: Double?
+                var frames = 0.0
+                for line in tail where line.contains("[frame] ") {
+                    guard let r = line.range(of: "present ") else { continue }
+                    let num = line[r.upperBound...].prefix { "0123456789.".contains($0) }
+                    if let v = Double(num) { presentFPS = v; frames += v }
+                }
+                let sessions = ((try? FileManager.default.contentsOfDirectory(atPath: docs.appendingPathComponent("logs").path)) ?? [])
+                    .filter { $0.hasSuffix(".txt") }.sorted().suffix(5)
+                let out: [String: Any] = [
+                    "time": ISO8601DateFormatter().string(from: Date()),
+                    "app_uptime_s": Int(Date().timeIntervalSince(started)),
+                    "build": Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "",
+                    "game": game,
+                    "present_fps": presentFPS.map { $0 as Any } ?? NSNull(),
+                    "frames_in_tail": Int(frames),
+                    "last_log_lines": Array(tail.suffix(40)),
+                    "newest_session_logs": Array(sessions),
+                ]
+                try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+                if let data = try? JSONSerialization.data(withJSONObject: out, options: [.prettyPrinted, .sortedKeys]) {
+                    try? data.write(to: dir.appendingPathComponent("status.json"), options: .atomic)
+                }
+                LogStore.shared.log("[ipad-hooks] status written to Documents/test-hooks/status.json")
+            }
+        }
+    }
