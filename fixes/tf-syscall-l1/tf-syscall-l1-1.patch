+// MADEIRA [tf-syscall-l1]: see Arm64Emitter.h.
+bool IosTfSyscallL1Enabled() {
+  static const bool Enabled = [] {
+    const char* Env = getenv("MADEIRA_FEX_TF_SYSCALL_L1");
+    const bool On = !(Env && Env[0] == '0' && Env[1] == '\0');
+    LogMan::Msg::EFmt("[tf-syscall-l1] rev=tf-syscall-l1-1 {}", On ? "on" : "off (MADEIRA_FEX_TF_SYSCALL_L1=0)");
+    return On;
+  }();
+  return Enabled;
+}
