From 79aa8c701eb59390f0d1423d68698e846c78858c Mon Sep 17 00:00:00 2001
From: Russell Barton <barton5russell@gmail.com>
Date: Mon, 9 Nov 2026 21:14:05 +0000
Subject: [PATCH 1/3] ntdll iOS: with MADEIRA_SLEEP_KERNEL_APC=1 a
 non-alertable sleep runs queued I/O completions, as on Windows

On Windows an I/O completion (a kernel-mode APC) runs in any wait,
alertable or not; only user APCs need an alertable one. NtDelayExecution
makes an alertable sleep a server wait (SELECT_INTERRUPTIBLE |
SELECT_ALERTABLE), where the server delivers system APCs, but a
non-alertable sleep is a host select(). Elsewhere Wine's SIGUSR1
interrupts that select() to run a system APC; on iOS send_thread_signal
cannot reach the thread (Madeira's wineserver mach_ios.c,
get_process_port), so a completion queued for a sleeping thread waits
until the thread next enters the server, which a thread that only
sleeps never does. Far Cry 3 (through Ubisoft Connect) reads its
launcher pipe overlapped and then sleeps: the read never completes and
the game exits after 15 s.

With MADEIRA_SLEEP_KERNEL_APC=1 (default off) a non-alertable sleep
with a timeout, or an infinite one, is server_wait( NULL, 0,
SELECT_INTERRUPTIBLE, timeout ): the same wait as an alertable sleep
without SELECT_ALERTABLE, so system APCs run during it and user APCs
still do not, as on Windows. Sleep(0) and the yield before a timed sleep
are unchanged. Each such sleep costs one server round trip, so the
switch is per game. Read at each sleep. iOS only (WINE_IOS).

Device-tested on BCD (a fork of Madeira): Far Cry 3's pipe read
completes and the game runs.

Signed-off-by: Russell Barton <barton5russell@gmail.com>
---
 dlls/ntdll/unix/sync.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index cdee6eb..77bad7d 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -3625,6 +3625,19 @@ NTSTATUS WINAPI NtYieldExecution(void)
 /******************************************************************
  *		NtDelayExecution (NTDLL.@)
  */
+#ifdef WINE_IOS
+/* Madeira sleep-kernel-apc: with env.MADEIRA_SLEEP_KERNEL_APC = 1 a
+ * non-alertable sleep waits in the server with SELECT_INTERRUPTIBLE, so a system APC (an I/O completion) queued for
+ * the sleeping thread runs during the sleep, as on Windows; on iOS nothing can interrupt the host select(). Read at
+ * each sleep, so the value is the session's own. */
+static int madeira_sleep_kernel_apc(void)
+{
+    const char *e = getenv( "MADEIRA_SLEEP_KERNEL_APC" );
+
+    return e && e[0] == '1' && !e[1];
+}
+#endif
+
 NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeout )
 {
     unsigned int status = STATUS_SUCCESS;
@@ -3650,6 +3663,10 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
 
     if (!timeout || timeout->QuadPart == TIMEOUT_INFINITE)  /* sleep forever */
     {
+#ifdef WINE_IOS
+        if (madeira_sleep_kernel_apc())   /* sleep-kernel-apc */
+            for (;;) server_wait( NULL, 0, SELECT_INTERRUPTIBLE, NULL );
+#endif
         for (;;) select( 0, NULL, NULL, NULL, NULL );
     }
     else
@@ -3667,6 +3684,13 @@ NTSTATUS WINAPI NtDelayExecution( BOOLEAN alertable, const LARGE_INTEGER *timeou
            we only care about the result of the yield for zero timeouts */
         status = NtYieldExecution();
         if (!when) return status;
+#ifdef WINE_IOS
+        if (madeira_sleep_kernel_apc())   /* sleep-kernel-apc: system APCs run during the sleep */
+        {
+            server_wait( NULL, 0, SELECT_INTERRUPTIBLE, timeout );
+            return STATUS_SUCCESS;
+        }
+#endif
 
         for (;;)
         {
