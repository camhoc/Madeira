+/* wcp-import: a package a person imported for THIS game (WCPStore.swift) replaces the bundle's DLLs for one
+ * route. madeira.cfg / the game's own lines: d3d11-package = <name> (DXVK), d3d12-package = <name> (vkd3d-proton).
+ * Folder: <Application Support>/WCP/<name>/ with the DLLs named as in the bundle (dxvk-d3d11.dll, d3d12.dll...).
+ * Nothing in the prefix is written; the links are remade every session, so removing the folder is the undo.
+ * env.MADEIRA_WCP_IMPORT = 0 ignores the keys. Returns the bundle folder when unset, off, unsafe or incomplete. */
+static NSString *madeira_wcp_stack(NSString *key, NSArray<NSString *> *needed, NSString *fallback)
+{
+    char v[128] = "";
+    const char *off = getenv("MADEIRA_WCP_IMPORT");
+
+    if (off && !strcmp(off, "0")) return fallback;
+    if (!madeira_cfg_get(key.UTF8String, v, sizeof v) || !v[0]) return fallback;
+    if (strchr(v, '/') || strstr(v, "..")) return fallback;
+    NSString *base = NSSearchPathForDirectoriesInDomains(NSApplicationSupportDirectory, NSUserDomainMask, YES).firstObject;
+    NSString *dir = [[base stringByAppendingPathComponent:@"WCP"] stringByAppendingPathComponent:[NSString stringWithUTF8String:v]];
+    for (NSString *f in needed)
+        if (access([dir stringByAppendingPathComponent:f].fileSystemRepresentation, R_OK) != 0) {
+            dprintf(STDERR_FILENO, "[wcp] %s = %s: %s missing, bundle DLLs stay\n", key.UTF8String, v, f.UTF8String);
+            return fallback;
+        }
+    dprintf(STDERR_FILENO, "[wcp] %s = %s: using the imported package for this session\n", key.UTF8String, v);
+    return dir;
+}
