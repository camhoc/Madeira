+ * Copyright 2024 Alyssa Rosenzweig
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "compiler.h"
+
+/* Validatation doesn't make sense in release builds */
+#ifndef NDEBUG
+
+static inline uint32_t
+bi_index_size_32(bi_index idx)
+{
+   return idx.channels;
+}
+
+/* Represents a single 16-bit slice of an SSA var */
+struct var_offset {
+   uint32_t var;
+   uint8_t offset;
+   uint8_t defined;
+   uint8_t pad[2];
+};
+static_assert(sizeof(struct var_offset) == 8);
+
+static struct var_offset
+var_index(bi_index idx, uint32_t offset)
+{
+   assert(idx.type == BI_INDEX_NORMAL);
+
+   return (struct var_offset){
+      .var = idx.value,
+      .offset = offset,
+      .defined = true,
+   };
+}
+
+static struct var_offset
+var_undef()
+{
+   return (struct var_offset){.defined = false};
+}
+
+static bool
+vars_equal(struct var_offset x, struct var_offset y)
+{
+   return x.defined && y.defined && x.var == y.var && x.offset == y.offset;
+}
+
+/* Represents the contents of a single register file */
+struct regfile {
+   struct var_offset r[RA_CLASSES][BI_NUM_MODELED_REGS];
+};
+
+static void
+print_regfile(struct regfile *file, FILE *fp)
+{
+   fprintf(fp, "regfile: \n");
+   for (enum ra_class cls = 0; cls < RA_CLASSES; ++cls) {
+      for (unsigned r = 0; r < BI_NUM_MODELED_REGS; ++r) {
+         struct var_offset v = file->r[cls][r];
+
+         if (v.defined) {
+            fprintf(fp, "   %c%u = %u[%u]\n", cls == RA_MEM ? 'm' : 'h', r,
+                    v.var, v.offset);
+         }
+      }
+   }
+   fprintf(fp, "\n");
+}
+
+#define bi_validate_assert_eq(file, I, s, offs, a, b)                          \
+   do {                                                                        \
+      __typeof(a) va = (a);                                                    \
+      __typeof(b) vb = (b);                                                    \
+      if (!(va == vb)) {                                                       \
+         fprintf(stderr,                                                       \
+                 "failed to validate RA source %u offs %u: " #a " == " #b      \
+                 " (%u != %u) \n",                                             \
+                 s, offs, va, vb);                                             \
+         bi_print_instr(I, stderr);                                            \
+         print_regfile(file, stderr);                                          \
+         return false;                                                         \
+      }                                                                        \
+   } while (false);
+
+#define bi_validate_assert(file, I, s, offs, stmt)                             \
+   if (!(stmt)) {                                                              \
+      fprintf(stderr, "failed to validate RA source %u offs %u: " #stmt "\n",  \
+              s, offs);                                                        \
+      bi_print_instr(I, stderr);                                               \
+      print_regfile(file, stderr);                                             \
+      return false;                                                            \
+   }
+
+static void
+copy_reg(struct regfile *file, bi_index dst, bi_index src)
+{
+   assert(dst.type == BI_INDEX_REGISTER);
+   assert(src.type == BI_INDEX_REGISTER);
+
+   enum ra_class dst_cls = ra_class_for_index(dst);
+   enum ra_class src_cls = ra_class_for_index(src);
+
+   /* MEMMOV could be larger but those don't come in here rn. */
+   const unsigned width = 1;
+   for (uint8_t offs = 0; offs < width; ++offs) {
+      assert(dst.value + offs < ARRAY_SIZE(file->r[dst_cls]));
+      file->r[dst_cls][dst.value + offs] = file->r[src_cls][src.value + offs];
+   }
+}
+
+static void
+swap_regs(struct regfile *file, bi_index a, bi_index b)
+{
+   assert(a.type == BI_INDEX_REGISTER);
+   assert(b.type == BI_INDEX_REGISTER);
+
+   enum ra_class a_cls = ra_class_for_index(a);
+   enum ra_class b_cls = ra_class_for_index(b);
+
+   unsigned size = bi_index_size_32(a);
+   assert(size == bi_index_size_32(b));
+
+   for (uint8_t offs = 0; offs < size; ++offs) {
+      assert(a.value + offs < ARRAY_SIZE(file->r[a_cls]));
+      assert(b.value + offs < ARRAY_SIZE(file->r[b_cls]));
+
+      struct var_offset tmp = file->r[a_cls][a.value + offs];
+      file->r[a_cls][a.value + offs] = file->r[b_cls][b.value + offs];
+      file->r[b_cls][b.value + offs] = tmp;
+   }
+}
+
+static void
+record_dest(struct regfile *file, bi_index idx)
+{
+   assert(idx.type == BI_INDEX_NORMAL && idx.has_reg);
+   enum ra_class cls = ra_class_for_index(idx);
+
+   for (uint8_t offs = 0; offs < bi_index_size_32(idx); ++offs) {
+      assert(idx.reg + offs < ARRAY_SIZE(file->r[cls]));
+      file->r[cls][idx.reg + offs] = var_index(idx, offs);
+   }
+}
+
+static bool
+validate_dest(bi_context *ctx, bi_instr *I, unsigned s, struct regfile *file,
+              bi_index idx)
+{
+   assert(idx.type == BI_INDEX_NORMAL && idx.has_reg);
+   unsigned fixed_reg = bi_get_fixed_reg(ctx, I, s, false);
+
+   if (fixed_reg != BI_MAX_REGS) {
+      bi_validate_assert(file, I, s, 0, idx.has_reg);
+      bi_validate_assert(file, I, s, 0, idx.reg == fixed_reg);
+   }
+
+   unsigned alignment = MIN2(2, bi_channels(idx));
+   bool align_ok = idx.reg % alignment == 0;
+   bi_validate_assert(file, I, s, 0, align_ok);
+
+   return true;
+}
+
+static bool
+validate_src(bi_context *ctx, bi_instr *I, unsigned s, struct regfile *file,
+             bi_index idx)
+{
+   assert(idx.type == BI_INDEX_NORMAL && idx.has_reg);
+   enum ra_class cls = ra_class_for_index(idx);
+   unsigned fixed_reg = bi_get_fixed_reg(ctx, I, s, true);
+
+   for (uint8_t offs = 0; offs < bi_index_size_32(idx); ++offs) {
+      assert(idx.reg + offs < ARRAY_SIZE(file->r[cls]));
+      struct var_offset actual = file->r[cls][idx.reg + offs];
+
+      bi_validate_assert(file, I, s, offs, actual.defined);
+      bi_validate_assert_eq(file, I, s, offs, actual.var, idx.value);
+      bi_validate_assert_eq(file, I, s, offs, actual.offset, offs);
+
+      if (fixed_reg != BI_MAX_REGS) {
+         bi_validate_assert(file, I, s, offs, idx.reg == fixed_reg);
+      }
+   }
+
+   return true;
+}
+
+static bool
+validate_block(bi_context *ctx, bi_block *block, struct regfile *blocks)
+{
+   struct regfile *file = &blocks[block->index];
+   bool success = true;
+
+   /* Pathological shaders can end up with loop headers that have only a single
+    * predecessor and act like normal blocks. Validate them as such, since RA
+    * treats them as such implicitly. Affects:
+    *
+    * dEQP-VK.graphicsfuzz.spv-stable-mergesort-dead-code
+    */
+   bool loop_header = block->loop_header && bi_num_predecessors(block) > 1;
+
+   /* Initialize the register file based on predecessors. This only works in
+    * non-loop headers, since loop headers have unprocessed predecessors.
+    * However, loop headers phi-declare everything instead of using implicit
+    * live-in sources, so that's ok.
+    */
+   if (!loop_header) {
+      bool first_pred = true;
+      bi_foreach_predecessor(block, pred) {
+         struct regfile *pred_file = &blocks[(*pred)->index];
+
+         for (enum ra_class cls = 0; cls < RA_CLASSES; ++cls) {
+            for (unsigned r = 0; r < BI_NUM_MODELED_REGS; ++r) {
+               if (first_pred)
+                  file->r[cls][r] = pred_file->r[cls][r];
+               else if (!vars_equal(file->r[cls][r], pred_file->r[cls][r]))
+                  file->r[cls][r] = var_undef();
+            }
+         }
+
+         first_pred = false;
+      }
+   }
+
+   bi_foreach_instr_in_block(block, I) {
+      /* Phis are special since they happen along the edge */
+      if (I->op != BI_OPCODE_PHI) {
+         bi_foreach_ssa_src(I, s) {
+            success &= validate_src(ctx, I, s, file, I->src[s]);
+         }
+      }
+
+      bi_foreach_ssa_dest(I, d) {
+         record_dest(file, I->dest[d]);
+         success &= validate_dest(ctx, I, d, file, I->dest[d]);
+      }
+
+      /* Lowered live range splits don't have SSA associated, handle
+       * directly at the register level.
+       */
+      if ((I->op == BI_OPCODE_MOV_I32 || I->op == BI_OPCODE_MEMMOV) &&
+          I->dest[0].type == BI_INDEX_REGISTER &&
+          I->src[0].type == BI_INDEX_REGISTER) {
+
+         copy_reg(file, I->dest[0], I->src[0]);
+      } else if (I->op == BI_OPCODE_SWAP) {
+         swap_regs(file, I->src[0], I->src[1]);
+      } else if (I->op == BI_OPCODE_PHI &&
+                 I->dest[0].type == BI_INDEX_REGISTER) {
+         /* Register-only phis which resolve to the same variable in all blocks.
+          * This is generated for edge case live range splits.
+          */
+         assert(!I->dest[0].memory);
+         assert(!loop_header);
+         for (uint8_t offs = 0; offs < bi_index_size_32(I->dest[0]); ++offs) {
+            bool all_same = true;
+            bool first = true;
+            struct var_offset same = var_undef();
+            bi_foreach_predecessor(block, pred) {
+               unsigned idx = bi_predecessor_index(block, *pred);
+               bi_index src = I->src[idx];
+
+               assert(!src.memory);
+               if (src.type != BI_INDEX_REGISTER) {
+                  all_same = false;
+                  first = false;
+                  continue;
+               }
+
+               struct regfile *pred_file = &blocks[(*pred)->index];
+               struct var_offset var = pred_file->r[RA_GPR][src.value + offs];
+               all_same &= first || vars_equal(var, same);
+               same = var;
+               first = false;
+            }
+
+            if (all_same) {
+               file->r[RA_GPR][I->dest[0].value + offs] = same;
+            }
+         }
+      } else if (I->op == BI_OPCODE_PHI && I->dest[0].has_reg && !loop_header) {
+         /* Phis which resolve to the same variable in all blocks.
+          * This is generated for live range splits.
+          */
+         enum ra_class cls = ra_class_for_index(I->dest[0]);
+         for (uint8_t offs = 0; offs < bi_index_size_32(I->dest[0]); ++offs) {
+            bool all_same = true;
+            bool first = true;
+            struct var_offset same = var_undef();
+            bi_foreach_predecessor(block, pred) {
+               unsigned idx = bi_predecessor_index(block, *pred);
+               bi_index src = I->src[idx];
+
+               assert(ra_class_for_index(src) == cls);
+               if (!src.has_reg) {
+                  all_same = false;
+                  first = false;
+                  continue;
+               }
+
+               struct regfile *pred_file = &blocks[(*pred)->index];
+               struct var_offset var = pred_file->r[cls][src.reg + offs];
+               all_same &= first || vars_equal(var, same);
+               same = var;
+               first = false;
+            }
+
+            if (all_same && I->dest[0].value == I->src[0].value) {
+               file->r[cls][I->dest[0].reg + offs] = same;
+            }
+         }
+      }
+   }
+
+   /* After processing a block, process the block's source in its successors'
+    * phis. These happen on the edge so we have all the information here, even
+    * with backedges.
+    */
+   bi_foreach_successor(block, succ) {
+      unsigned idx = bi_predecessor_index(succ, block);
+
+      bi_foreach_phi_in_block(succ, phi) {
+         if (phi->src[idx].type == BI_INDEX_NORMAL) {
+            success &= validate_src(ctx, phi, idx, file, phi->src[idx]);
+         }
+      }
+   }
+
+   return success;
+}
+
+void
+bi_validate_ra(bi_context *ctx)
+{
+   bool succ = true;
+   struct regfile *blocks = calloc(ctx->num_blocks, sizeof(*blocks));
+
+   bi_foreach_block(ctx, block) {
+      succ &= validate_block(ctx, block, blocks);
+   }
+
+   if (!succ) {
+      bi_print_shader(ctx, stderr);
+      UNREACHABLE("invalid RA");
+   }
+
+   free(blocks);
+}
+
+#endif /* NDEBUG */

