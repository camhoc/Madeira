+bi_validate_block_order(bi_context *ctx, const char *after)
+{
+   bool fail = false;
+   int last_index = -1;
+
+   bi_foreach_block(ctx, block) {
+      if ((int)block->index <= last_index) {
+         fprintf(stderr, "Out-of-order block index %d vs %d after %s\n",
+                 block->index, last_index, after);
+         fail = true;
+      }
+
+      last_index = block->index;
+
+      int last_pred_index = -1;
+      bi_foreach_predecessor(block, pp) {
+         bi_block *p = *pp;
+         if ((int)p->index <= last_pred_index) {
+            fprintf(
+               stderr,
+               "Out-of-order predecessor index %d before %d in block %d after %s\n",
+               last_pred_index, p->index, block->index, after);
+            fail = true;
+         }
+         last_pred_index = p->index;
+      }
+   }
+
+   return !fail;
+}
