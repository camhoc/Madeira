--- src/panfrost/compiler/bifrost/bi_lower_parallel_copy.c
+++ src/panfrost/compiler/bifrost/bi_lower_parallel_copy.c
@@ -0,0 +1,296 @@
+/*
+ * Copyright 2025 Arm Ltd.
+ * Copyright 2022 Alyssa Rosenzweig
+ * Copyright 2021 Valve Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "bi_builder.h"
+#include "compiler.h"
+
+static void
+mov_lowered(bi_builder *b, bi_index dst, bi_index src)
+{
+   assert(dst.type == BI_INDEX_REGISTER);
+   assert(!dst.memory);
+
+   if (src.type == BI_INDEX_CONSTANT && b->shader->arch >= 9) {
+      bi_index zero = bi_fau(BIR_FAU_IMMEDIATE | 0, false);
+      bi_iadd_imm_i32_to(b, dst, zero, src.value);
+   } else {
+      bi_mov_i32_to(b, dst, src);
+   }
+}
+
+/*
+ * Emits code for
+ *
+ *    for (int i = 0; i < n; ++i)
+ *       registers[dests[i]] = registers[srcs[i]];
+ *
+ * ...with all copies happening in parallel.
+ *
+ * That is, emit machine instructions equivalent to a parallel copy. This is
+ * used to lower not only parallel copies but also collects and splits, which
+ * also have parallel copy semantics.
+ *
+ * We only handle register-register copies, not general bi_index sources. This
+ * suffices for its internal use for register allocation.
+ */
+
+static void
+do_copy(bi_builder *b, const struct bi_copy *copy)
+{
+   assert(copy->src.channels == 1);
+
+   bi_index dst =
+      copy->dest_mem ? bi_memory_register(copy->dest) : bi_register(copy->dest);
+   dst.channels = 1;
+
+   bi_index scratch_reg = bi_register(BI_RA_PCOPY_TMP_FIRST);
+   scratch_reg.channels = 1;
+
+   if (copy->dest_mem && copy->src.memory) {
+      /* Memory-memory copies need to be lowered to memory-register and
+       * register-memory, using a reserved scratch register.
+       */
+      bi_memmov_to(b, scratch_reg, copy->src);
+      bi_memmov_to(b, dst, scratch_reg);
+   } else if (copy->src.memory) {
+      bi_memmov_to(b, dst, copy->src);
+   } else if (copy->dest_mem) {
+      bi_index src = copy->src;
+
+      /* Source needs to be in a GPR */
+      if (src.type != BI_INDEX_REGISTER) {
+         mov_lowered(b, scratch_reg, src);
+         src = scratch_reg;
+      }
+
+      bi_memmov_to(b, dst, src);
+   } else {
+      mov_lowered(b, dst, copy->src);
+   }
+}
+
+static void
+do_swap(bi_builder *b, const struct bi_copy *copy)
+{
+   assert(copy->src.type == BI_INDEX_REGISTER && "only GPRs are swapped");
+   assert(copy->src.channels == 1);
+
+   if (copy->dest == copy->src.value)
+      return;
+
+   bi_index x =
+      copy->dest_mem ? bi_memory_register(copy->dest) : bi_register(copy->dest);
+   x.channels = 1;
+   bi_index y = copy->src;
+   assert(x.memory == y.memory);
+
+   /* Memory-memory swaps lowered here, GPR swaps lowered later */
+   if (x.memory) {
+      bi_index temp1 = bi_register(BI_RA_PCOPY_TMP_FIRST);
+      bi_index temp2 = bi_register(BI_RA_PCOPY_TMP_FIRST + 1);
+      temp1.channels = 1;
+      temp2.channels = 1;
+
+      bi_memmov_to(b, temp1, x);
+      bi_memmov_to(b, temp2, y);
+      bi_memmov_to(b, y, temp1);
+      bi_memmov_to(b, x, temp2);
+   } else {
+      bi_swap(b, x, y);
+   }
+}
+
+struct copy_ctx {
+   /* Number of copies being processed */
+   unsigned entry_count;
+
+   /* For each physreg, the number of pending copy entries that use it as a
+    * source. Once this drops to zero, then the physreg is unblocked and can
+    * be moved to.
+    */
+   unsigned physreg_use_count[BI_NUM_MODELED_REGS];
+
+   /* For each physreg, the pending copy_entry that uses it as a dest. */
+   struct bi_copy *physreg_dest[BI_NUM_MODELED_REGS];
+
+   struct bi_copy entries[BI_NUM_MODELED_REGS];
+};
+
+static bool
+entry_blocked(struct bi_copy *entry, struct copy_ctx *ctx)
+{
+   /* Copies are scalarized, so it's enough to look only at one register. */
+   return ctx->physreg_use_count[entry->dest] != 0;
+}
+
+static bool
+is_real(struct bi_copy *entry)
+{
+   return entry->src.type == BI_INDEX_REGISTER &&
+          entry->dest_mem == entry->src.memory;
+}
+
+static void
+bi_emit_parallel_copies_for_class(bi_builder *b, struct bi_copy *copies,
+                                  unsigned num_copies, bool cls)
+{
+   /* Filter for the copies of the correct class.
+    * Here we could also split large copies into smaller ones, should we need
+    * to in the future.
+    */
+   struct bi_copy *copies2 = calloc(sizeof(copies[0]), num_copies * 2);
+   unsigned num_copies2 = 0;
+
+   for (unsigned i = 0; i < num_copies; ++i) {
+      struct bi_copy copy = copies[i];
+
+      /* Filter by class */
+      if (copy.dest_mem != cls)
+         continue;
+
+      assert(copy.dest < BI_NUM_MODELED_REGS);
+
+      copies2[num_copies2++] = copy;
+   }
+
+   copies = copies2;
+   num_copies = num_copies2;
+
+   /* Set up the bookkeeping */
+   struct copy_ctx _ctx = {.entry_count = num_copies};
+   struct copy_ctx *ctx = &_ctx;
+
+   memset(ctx->physreg_dest, 0, sizeof(ctx->physreg_dest));
+   memset(ctx->physreg_use_count, 0, sizeof(ctx->physreg_use_count));
+
+   for (unsigned i = 0; i < ctx->entry_count; i++) {
+      struct bi_copy *entry = &copies[i];
+
+      ctx->entries[i] = *entry;
+
+      if (is_real(entry))
+         ctx->physreg_use_count[entry->src.value]++;
+
+      /* Copies should not have overlapping destinations. */
+      assert(!ctx->physreg_dest[entry->dest]);
+      ctx->physreg_dest[entry->dest] = &ctx->entries[i];
+   }
+
+   bool progress = true;
+   while (progress) {
+      progress = false;
+
+      /* Step 1: resolve paths in the transfer graph. This means finding
+       * copies whose destination aren't blocked by something else and then
+       * emitting them, continuing this process until every copy is blocked
+       * and there are only cycles left.
+       *
+       * TODO: We should note that src is also available in dest to unblock
+       * cycles that src is involved in.
+       */
+
+      for (unsigned i = 0; i < ctx->entry_count; i++) {
+         struct bi_copy *entry = &ctx->entries[i];
+         if (!entry->done && !entry_blocked(entry, ctx)) {
+            entry->done = true;
+            progress = true;
+            do_copy(b, entry);
+
+            if (is_real(entry))
+               ctx->physreg_use_count[entry->src.value]--;
+            ctx->physreg_dest[entry->dest] = NULL;
+         }
+      }
+
+      /* Step 2: Find and split partially blocked copies.
+       * All copies are 32bit -> not applicable atm. */
+   }
+
+   /* Step 3: resolve cycles through swapping.
+    *
+    * At this point, the transfer graph should consist of only cycles.
+    * The reason is that, given any physreg n_1 that's the source of a
+    * remaining entry, it has a destination n_2, which (because every
+    * copy is blocked) is the source of some other copy whose destination
+    * is n_3, and so we can follow the chain until we get a cycle. If we
+    * reached some other node than n_1:
+    *
+    *  n_1 -> n_2 -> ... -> n_i
+    *          ^             |
+    *          |-------------|
+    *
+    *  then n_2 would be the destination of 2 copies, which is illegal
+    *  (checked above in an assert). So n_1 must be part of a cycle:
+    *
+    *  n_1 -> n_2 -> ... -> n_i
+    *  ^                     |
+    *  |---------------------|
+    *
+    *  and this must be only cycle n_1 is involved in, because any other
+    *  path starting from n_1 would also have to end in n_1, resulting in
+    *  a node somewhere along the way being the destination of 2 copies
+    *  when the 2 paths merge.
+    *
