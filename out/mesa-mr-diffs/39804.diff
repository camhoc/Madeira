+      fail = true;
+   }
+
+   if (fail) {
+      bi_print_shader(ctx, stderr);
+      exit(1);
+   }
+}
+
+void
+bi_validate_channels(bi_context *ctx)
+{
+   if (bifrost_debug & BIFROST_DBG_NOVALIDATE)
+      return;
+
+   /* First, remember the current channels values. */
+   uint8_t *channels = calloc(ctx->ssa_alloc, sizeof(uint8_t));
+   bi_foreach_instr_global(ctx, I) {
+      bi_foreach_ssa_dest(I, d) {
+         assert(channels[I->dest[d].value] == 0 && "SSA broken");
+         channels[I->dest[d].value] = bi_channels(I->dest[d]);
+      }
+   }
+
+   /* Then recalculate the channels. */
+   bi_record_sizes(ctx);
+
+   /* Finally, compare new numbers against the old ones. They should match. */
+   bool fail = false;
+   bi_foreach_instr_global(ctx, I) {
+      bi_foreach_ssa_dest(I, d) {
+         bi_index idx = I->dest[d];
+         if (bi_channels(idx) != channels[idx.value]) {
+            fprintf(stderr,
+                    "channel mismatch, old = %u != new = %u in dest %u at ",
+                    channels[idx.value], bi_channels(idx), d);
+            bi_print_instr(I, stderr);
+            fail = true;
+         }
+      }
+   }
+
+   free(channels);
+
    if (fail) {
       bi_print_shader(ctx, stderr);
       exit(1);

