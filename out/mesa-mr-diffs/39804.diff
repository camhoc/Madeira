+#include "bi_builder.h"
+#include "bi_debug.h"
+#include "bi_test.h"
+#include "compiler.h"
+
+#include <vector>
+#include <gtest/gtest.h>
+
+struct RaTestParams {
+   uint32_t arch;
+   uint32_t n_pressure_vals;
+   bool force_spill_debug = false;
+};
+
+class Ra : public testing::TestWithParam<RaTestParams> {
+ protected:
+   Ra()
+   {
+      if (GetParam().force_spill_debug)
+         bifrost_debug |= BIFROST_DBG_SPILL;
+      else
+         bifrost_debug &= ~BIFROST_DBG_SPILL;
+
+      mem_ctx = ralloc_context(NULL);
+      b = bit_builder(mem_ctx);
+      pressure_vals = {};
+   }
+
+   ~Ra()
+   {
+      ralloc_free(mem_ctx);
+   }
+
+   void SetUp() override
+   {
+      b->shader->arch = GetParam().arch;
+      load_pressure_vals(GetParam().n_pressure_vals);
+   }
+
+   bi_index TMP()
+   {
+      return bi_temp(b->shader);
+   }
+
+   bi_index IMMn(uint8_t n)
+   {
+      if (n == 1)
+         return bi_iadd_imm_i32(b, bi_zero(), 0);
+      else {
+         bi_index c = bi_temp(b->shader);
+         std::vector<bi_index> srcs;
+
+         for (uint8_t i = 0; i < n; ++i)
+            srcs.push_back(IMMn(1));
+
+         bi_instr *I = bi_collect_i32_to(b, c, n);
+
+         for (uint8_t i = 0; i < n; ++i)
+            I->src[i] = srcs[i];
+
+         return c;
+      }
+   }
+
+   void USE(const bi_index idx, uint8_t n)
+   {
+      bi_unused(b, idx, n);
+   }
+
+   std::vector<bi_index> SPLIT(const bi_index src, uint8_t n)
+   {
+      bi_instr *I = bi_split_i32_to(b, n, src);
+
+      std::vector<bi_index> dsts;
+      dsts.reserve(n);
+
+      for (uint8_t i = 0; i < n; ++i) {
+         dsts.push_back(TMP());
+         I->dest[i] = dsts[dsts.size() - 1];
+      }
+
+      return dsts;
+   }
+
+   void load_pressure_vals(uint32_t n)
+   {
+      /* Load a number of single register values to increase the base pressure
+       * before the actual tested instruction is encountered.
+       */
+      for (uint32_t i = 0; i < n; ++i)
+         pressure_vals.push_back(IMMn(1));
+   }
+
+   void use_pressure_vals()
+   {
+      for (const bi_index &val : pressure_vals)
+         USE(val, 1);
+   }
+
+   void exec()
+   {
+      /* Use pressure values at the very end so they are live until the end. */
+      use_pressure_vals();
+
+      /* Set correct liveness info. */
+      bi_compute_liveness_ssa(b->shader);
+
+      /* Calls bi_validate_ra internally. We don't check anything else extra. */
+      bi_register_allocate_ssa(b->shader);
+   }
+
+   void *mem_ctx;
+   bi_builder *b;
+   std::vector<bi_index> pressure_vals;
+};
+
+static const RaTestParams params[] = {
+   {7, 0},  {7, 16},  {7, BI_MAX_REGS},  {7, BI_MAX_REGS * 2},
+   {10, 0}, {10, 16}, {10, BI_MAX_REGS}, {10, BI_MAX_REGS * 2},
+   {10, BI_MAX_REGS, /* force spill */ true},
+};
+
+INSTANTIATE_TEST_SUITE_P(Ra, Ra, testing::ValuesIn(params));
+
+TEST_P(Ra, Basic)
+{
+   bi_index res = bi_fadd_f32(b, IMMn(1), IMMn(1));
+   USE(res, 1);
+   exec();
+}
+
+TEST_P(Ra, BLEND)
+{
+   bi_register_format regfmt = BI_REGISTER_FORMAT_AUTO;
+   bi_index res =
+      bi_blend(b, IMMn(4), IMMn(1), IMMn(1), IMMn(1), bi_null(), regfmt, 4, 0);
+   USE(res, 1);
+   exec();
+}
+
+TEST_P(Ra, BLEND_DUAL)
+{
+   bi_register_format regfmt = BI_REGISTER_FORMAT_AUTO;
+   bi_index res =
+      bi_blend(b, IMMn(4), IMMn(1), IMMn(1), IMMn(1), IMMn(4), regfmt, 4, 4);
+   USE(res, 1);
+   exec();
+}
+
+TEST_P(Ra, BLEND_DUAL_live_through)
+{
+   bi_register_format regfmt = BI_REGISTER_FORMAT_AUTO;
+   bi_index src1 = IMMn(1);
+   bi_index src2 = IMMn(4);
+   bi_index res =
+      bi_blend(b, src2, src1, IMMn(1), IMMn(1), IMMn(4), regfmt, 4, 4);
+   USE(res, 1);
+   res = bi_blend(b, IMMn(4), src1, IMMn(1), IMMn(1), src2, regfmt, 4, 4);
+   USE(res, 1);
+   exec();
+}
+
+TEST_P(Ra, ACMPXCHG_I32)
+{
+   /* Reads 2, writes 1. */
+   unsigned sr_count = 2;
+   bi_index res = TMP();
+   bi_instr *I =
+      bi_acmpxchg_i32_to(b, res, IMMn(sr_count), IMMn(1), IMMn(1), BI_SEG_NONE);
+   unsigned sr_write = bi_count_write_registers(I, 0);
+   GTEST_ASSERT_EQ(sr_write, 1);
+   USE(res, sr_write);
+
+   exec();
+}
+
+TEST_P(Ra, ATOM_RETURN_I32)
+{
+   /* Reads 1, writes 1 or 2. */
+   unsigned sr_count = b->shader->arch < 9 ? 2 : 1;
+   bi_index res = TMP();
+   bi_instr *I = bi_atom_return_i32_to(b, res, IMMn(1), IMMn(1), IMMn(1),
+                                       BI_ATOM_OPC_AADD, sr_count);
+   unsigned sr_write = bi_count_write_registers(I, 0);
+   GTEST_ASSERT_EQ(sr_write, sr_count);
+   USE(res, sr_write);
+
+   exec();
+}
+
+TEST_P(Ra, ACMPXCHG_I64)
+{
+   /* Reads 4, writes 2. */
+   unsigned sr_count = 4;
+   bi_index res = TMP();
+   bi_instr *I =
+      bi_acmpxchg_i64_to(b, res, IMMn(sr_count), IMMn(1), IMMn(1), BI_SEG_NONE);
+   unsigned sr_write = bi_count_write_registers(I, 0);
+   GTEST_ASSERT_EQ(sr_write, 2);
+   USE(res, sr_write);
+
+   exec();
+}
+
+TEST_P(Ra, ATOM_RETURN_I64)
+{
+   /* Reads 2, writes 2 or 4. */
+   unsigned sr_count = b->shader->arch < 9 ? 4 : 2;
+   bi_index res = TMP();
+   bi_instr *I = bi_atom_return_i64_to(b, res, IMMn(2), IMMn(1), IMMn(1),
+                                       BI_ATOM_OPC_AADD, sr_count);
+   unsigned sr_write = bi_count_write_registers(I, 0);
+   GTEST_ASSERT_EQ(sr_write, sr_count);
+   USE(res, sr_write);
+
+   exec();
+}
+
+TEST_P(Ra, ATEST)
+{
+   bi_index coverage = bi_preload(b, 60);
+   bi_index res = bi_atest(b, coverage, bi_fau(BIR_FAU_ZERO, false),
+                           bi_fau(BIR_FAU_ATEST_PARAM, false));
+   USE(res, 1);
+
+   exec();
+}

