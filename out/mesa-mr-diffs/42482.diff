+
+/*
+ * Compute the register-pressure ceiling that the shader's occupancy already
+ * permits. Occupancy is bounded by registers and shared memory.
+ * We compute how many whole workgroups fit under each limit, take the
+ * smaller, and return the register budget available at that occupancy.
+ *
+ * Returns 0 for non-compute shaders and for shaders already at
+ * the register limit for a single workgroup.
+ */
+static signed
+calculate_occupancy_ceiling(agx_context *ctx)
+{
+   if (!mesa_shader_stage_is_compute(ctx->stage))
+      return 0;
+
+   unsigned threads_per_wg;
+   if (ctx->nir->info.workgroup_size_variable) {
+      threads_per_wg = 1024;
+   } else {
+      threads_per_wg = ctx->nir->info.workgroup_size[0] *
+                       ctx->nir->info.workgroup_size[1] *
+                       ctx->nir->info.workgroup_size[2];
+   }
+
+   unsigned demand = calculate_register_demand(ctx);
+
+   /* Already at the register limit for one workgroup */
+   if (demand >= agx_max_registers_for_occupancy(threads_per_wg))
+      return 0;
+
+   /* reg_wgs is how many whole workgroups can be resident given the register
+    * demand. Numerator is the max number of threads that can run concurrently
+    * on a core given the current program's register demand. Denominator is the
+    * shader's required number of threads per workgroup. */
+   unsigned reg_wgs =
+      agx_occupancy_for_register_count(demand).max_threads / threads_per_wg;
+
+   /* shmem_wgs is how many whole workgroups can be resident given shared
+    * memory: the core's shared memory divided by each workgroup's shared_size.
+    * With no shared memory, registers are the only limit. */
+   unsigned shmem_wgs = ctx->nir->info.shared_size
+                           ? AGX_CORE_SHARED_BYTES / ctx->nir->info.shared_size
+                           : reg_wgs;
+   unsigned wgs = MIN2(reg_wgs, shmem_wgs);
+
+   signed ceiling = agx_max_registers_for_occupancy(wgs * threads_per_wg);
+   return ceiling;
+}
