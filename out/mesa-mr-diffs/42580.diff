+/* Find NoContraction-decorated float ops so we know which opaque helpers to
+ * emit. We only emit the helpers we actually use. */
+static void
+gather_nocontract(struct nir_to_msl_ctx *ctx)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(ctx->shader);
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_alu)
+            continue;
+         nir_alu_instr *alu = nir_instr_as_alu(instr);
+         if (!nir_alu_instr_no_contract(alu))
+            continue;
+         switch (alu->op) {
+         case nir_op_fmul:
+            ctx->uses_nocontract_fmul = true;
+            break;
+         case nir_op_fadd:
+            ctx->uses_nocontract_fadd = true;
+            break;
+         case nir_op_fsub:
+            ctx->uses_nocontract_fsub = true;
+            break;
+         default:
+            break;
+         }
+      }
+   }
+}
