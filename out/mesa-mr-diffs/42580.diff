+/* SPIR-V's NoContraction decoration forbids fusing the decorated multiply or
+ * add into a fused multiply-add. Metal's FAST/RELAXED math modes will happily
+ * form an FMA across a separate multiply and add, so the decorated operations
+ * are routed through these opaque [[clang::optnone]] helpers. The optimizer
+ * cannot see through them, so the multiply and add each round independently.
+ * This mirrors what SPIRV-Cross emits for MSL. */
+static void
+emit_nocontraction_helpers(struct nir_to_msl_ctx *ctx)
+{
+   if (ctx->uses_nocontract_fmul)
+      P(ctx, "template<typename T> [[clang::optnone]] T opaqueFMul(T l, T r) { "
+             "return fma(l, r, T(0)); }\n");
+   if (ctx->uses_nocontract_fadd)
+      P(ctx, "template<typename T> [[clang::optnone]] T opaqueFAdd(T l, T r) { "
+             "return fma(T(1), l, r); }\n");
+   if (ctx->uses_nocontract_fsub)
+      P(ctx, "template<typename T> [[clang::optnone]] T opaqueFSub(T l, T r) { "
+             "return fma(T(-1), r, l); }\n");
+}
