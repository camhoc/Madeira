+# Native two-argument arctangent.  See the ftan/fasin/facos/fatan comment in
+# the unop section and spirv_to_nir_options::native_trig.
+binop("fatan2", tfloat, "", "bit_size == 64 ? atan2(src0, src1) : atan2f(src0, src1)")
+
