 unop("fcos", tfloat, "bit_size == 64 ? cos(src0) : cosf(src0)")
 
+# Native inverse-trig / tangent opcodes.  These are normally lowered to
+# arithmetic by vtn (see the nir_acos()/nir_asin()/nir_atan()/
+# nir_ftan_lowered() builder helpers).  A backend whose target ISA exposes the corresponding
+# hardware transcendentals (e.g. Metal's <metal_math>) can ask the SPIR-V
+# front-end to keep them as opcodes via
+# spirv_to_nir_options::native_trig and map them directly, which avoids
+# the polynomial approximation and lets the result benefit from the native ones.
+unop("ftan", tfloat, "bit_size == 64 ? tan(src0) : tanf(src0)")
+unop("fasin", tfloat, "bit_size == 64 ? asin(src0) : asinf(src0)")
+unop("facos", tfloat, "bit_size == 64 ? acos(src0) : acosf(src0)")
+unop("fatan", tfloat, "bit_size == 64 ? atan(src0) : atanf(src0)")
+
 # dfrexp
 unop_convert("frexp_exp", tint32, tfloat, "frexp(src0, &dst);", valid_fp_math_ctrl = preserve_inf + preserve_nan + exact)
