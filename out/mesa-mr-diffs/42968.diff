-   outputs[rt] = store->src[0].ssa;
+   ctx->src1[rt] = store->src[0].ssa;
+   ctx->src1_type[rt] = nir_intrinsic_src_type(store);
    nir_instr_remove(&store->instr);
    return true;
 }
 
+/*
+ * If dual blending is active and src0 is not written, we still need to perform
+ * blending with the undefined value. Insert dummy stores that will be lowered
+ * to the final blend.
+ */
+static bool
+insert_missing_dual_src0(nir_shader *nir, struct ctx *ctx)
+{
+   bool progress = false;
+
+   nir_function_impl *entrypoint = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_at(nir_after_impl(entrypoint));
+
+   for (unsigned rt = 0; rt < 8; rt++) {
+      if (!ctx->has_src0[rt] && ctx->src1[rt]) {
+         nir_alu_type out_type = ctx->src1_type[rt];
+         unsigned out_size = nir_alu_type_get_type_size(out_type);
+
+         nir_store_output(&b, nir_imm_zero(&b, 4, out_size), nir_imm_int(&b, 0),
+                          .src_type = out_type,
+                          .io_semantics.location = FRAG_RESULT_DATA0 + rt,
+                          .io_semantics.dual_source_blend_index = 0);
+
+         progress = true;
+      }
+   }
+
+   return progress;
+}
