+TEST(U64IntervalTreeTest, AddressSpaceBoundaries)
+{
+    static const struct u64interval intervals[] = {
+        { 0x100000000ull, 0x1000000ffull },
+        { 0x100000080ull, 0x100000180ull },
+        { 0x200000000ull, 0x200000100ull },
+        { UINT64_MAX - 0x100, UINT64_MAX - 1 },
+    };
+    struct u64interval_test_node nodes[ARRAY_SIZE(intervals)];
+    struct rb_tree tree;
+
+    rb_tree_init(&tree);
+
+    for (unsigned i = 0; i < ARRAY_SIZE(intervals); i++) {
+        nodes[i].node.interval = intervals[i];
+        u64interval_tree_insert(&tree, &nodes[i].node);
+        rb_tree_validate(&tree);
+    }
+
+    EXPECT_EQ(0u, count_u64interval_matches(&tree, 0, UINT32_MAX));
+    EXPECT_EQ(2u, count_u64interval_matches(&tree, 0x100000090ull,
+                                            0x100000090ull));
+    EXPECT_EQ(1u, count_u64interval_matches(&tree, 0x100000170ull,
+                                            0x100000170ull));
+    EXPECT_EQ(1u, count_u64interval_matches(&tree, 0x200000080ull,
+                                            0x200000080ull));
+    EXPECT_EQ(1u, count_u64interval_matches(&tree, UINT64_MAX - 0x80,
+                                            UINT64_MAX - 0x80));
+    EXPECT_EQ(4u, count_u64interval_matches(&tree, 0, UINT64_MAX));
+
+    u64interval_tree_remove(&tree, &nodes[0].node);
+    rb_tree_validate(&tree);
+    EXPECT_EQ(1u, count_u64interval_matches(&tree, 0x100000090ull,
+                                            0x100000090ull));
+
+    for (unsigned i = 1; i < ARRAY_SIZE(intervals); i++) {
+        u64interval_tree_remove(&tree, &nodes[i].node);
+        rb_tree_validate(&tree);
+    }
+
+    EXPECT_TRUE(rb_tree_is_empty(&tree));
+}

