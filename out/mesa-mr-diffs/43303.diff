+enum mtl_index_type
+vk_index_type_to_mtl_index_type(enum VkIndexType index_type)
+{
+   switch (index_type) {
+   case VK_INDEX_TYPE_UINT16:
+      return MTL_INDEX_TYPE_UINT16;
+   case VK_INDEX_TYPE_UINT32:
+      return MTL_INDEX_TYPE_UINT32;
+   default:
+      UNREACHABLE("Unsupported VkIndexType");
+   }
+}
+
+enum mtl_attribute_format
+vk_acceleration_structure_vertex_format_to_mtl_attribute_format(
+   enum VkFormat format)
+{
+   /* Only 2-, 3- and 4-component formats can express a triangle vertex
+    * position, and those are the ones
+    * MTLAccelerationStructureTriangleGeometryDescriptor.vertexFormat accepts.
+    */
+   switch (format) {
+   case VK_FORMAT_R32G32B32A32_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_FLOAT4;
+   case VK_FORMAT_R32G32B32_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_FLOAT3;
+   case VK_FORMAT_R32G32_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_FLOAT2;
+   case VK_FORMAT_R16G16B16A16_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_HALF4;
+   case VK_FORMAT_R16G16B16_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_HALF3;
+   case VK_FORMAT_R16G16_SFLOAT:
+      return MTL_ATTRIBUTE_FORMAT_HALF2;
+   case VK_FORMAT_R16G16_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_SHORT2_NORMALIZED;
+   case VK_FORMAT_R16G16B16_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_SHORT3_NORMALIZED;
+   case VK_FORMAT_R16G16B16A16_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_SHORT4_NORMALIZED;
+   case VK_FORMAT_R16G16_UNORM:
+      return MTL_ATTRIBUTE_FORMAT_USHORT2_NORMALIZED;
+   case VK_FORMAT_R16G16B16_UNORM:
+      return MTL_ATTRIBUTE_FORMAT_USHORT3_NORMALIZED;
+   case VK_FORMAT_R16G16B16A16_UNORM:
+      return MTL_ATTRIBUTE_FORMAT_USHORT4_NORMALIZED;
+   case VK_FORMAT_R8G8B8A8_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_CHAR4_NORMALIZED;
+   case VK_FORMAT_R8G8B8_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_CHAR3_NORMALIZED;
+   case VK_FORMAT_R8G8_SNORM:
+      return MTL_ATTRIBUTE_FORMAT_CHAR2_NORMALIZED;
+   default:
+      return MTL_ATTRIBUTE_FORMAT_INVALID;
+   }
+}
+
+bool
+vk_acceleration_structure_vertex_format_supported(enum VkFormat format)
+{
+   return vk_acceleration_structure_vertex_format_to_mtl_attribute_format(
+             format) != MTL_ATTRIBUTE_FORMAT_INVALID;
+}

