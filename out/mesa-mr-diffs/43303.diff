+static int
+u64interval_cmp(struct u64interval a, struct u64interval b)
+{
+    if (a.end < b.start)
+        return -1;
+    else if (b.end < a.start)
+        return 1;
+    else
+        return 0;
+}
+
+static int
+u64interval_node_cmp(const struct rb_node *_a, const struct rb_node *_b)
+{
+    const struct u64interval_node *a = rb_node_data(struct u64interval_node, _a, node);
+    const struct u64interval_node *b = rb_node_data(struct u64interval_node, _b, node);
+
+    if (a->interval.start < b->interval.start)
+        return 1;
+    else if (a->interval.start > b->interval.start)
+        return -1;
+    else
+        return 0;
+}
+
+static int
+u64interval_search_cmp(const struct rb_node *_node, const void *_interval)
+{
+    const struct u64interval_node *node = rb_node_data(struct u64interval_node, _node, node);
+    const struct u64interval *interval = _interval;
+
+    return u64interval_cmp(node->interval, *interval);
+}
+
+static bool
+u64interval_max_cmp(const struct rb_node *_node, const void *data)
+{
+    const struct u64interval_node *node = rb_node_data(struct u64interval_node, _node, node);
+    const struct u64interval *interval = data;
+
+    return node->max_end >= interval->start;
+}
+
+static void
+u64interval_update_max(struct rb_node *_node)
+{
+    struct u64interval_node *node = rb_node_data(struct u64interval_node, _node, node);
+    node->max_end = node->interval.end;
+    if (node->node.left) {
+        struct u64interval_node *left = rb_node_data(struct u64interval_node, node->node.left, node);
+        node->max_end = MAX2(node->max_end, left->max_end);
+    }
+    if (node->node.right) {
+        struct u64interval_node *right = rb_node_data(struct u64interval_node, node->node.right, node);
+        node->max_end = MAX2(node->max_end, right->max_end);
+    }
+}
+
+void
+u64interval_tree_insert(struct rb_tree *tree, struct u64interval_node *node)
+{
+    rb_augmented_tree_insert(tree, &node->node, u64interval_node_cmp,
+                             u64interval_update_max);
+}
+
+void
+u64interval_tree_remove(struct rb_tree *tree, struct u64interval_node *node)
+{
+    rb_augmented_tree_remove(tree, &node->node, u64interval_update_max);
+}
+
+struct u64interval_node *
+u64interval_tree_first(struct rb_tree *tree, struct u64interval interval)
+{
+    if (!tree->root)
+        return NULL;
+
+    struct rb_node *node =
+        rb_node_min_intersecting(tree->root, &interval, u64interval_search_cmp,
+                                 u64interval_max_cmp);
+
+    return node ? rb_node_data(struct u64interval_node, node, node) : NULL;
+}
+
+struct u64interval_node *
+u64interval_node_next(struct u64interval_node *node,
+                      struct u64interval interval)
+{
+    struct rb_node *next =
+        rb_node_next_intersecting(&node->node, &interval, u64interval_search_cmp,
+                                  u64interval_max_cmp);
+
+    return next ? rb_node_data(struct u64interval_node, next, node) : NULL;
+}
