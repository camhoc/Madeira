+#ifndef KK_ACCELERATION_STRUCTURE
+#define KK_ACCELERATION_STRUCTURE 1
+
+#include "kosmickrisp/bridge/mtl_acceleration_structure.h"
+#include "kosmickrisp/bridge/mtl_format.h"
