@@ -149,3 +346,268 @@ kk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
          encoder, pInfo->addressRange.address, local_size);
    }
 }
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdTraceRaysKHR(
+   VkCommandBuffer commandBuffer,
+   const VkStridedDeviceAddressRegionKHR *pRaygenShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pMissShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pHitShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pCallableShaderBindingTable,
+   uint32_t width, uint32_t height, uint32_t depth)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   struct kk_descriptor_state *desc = &cmd->state.rt.descriptors;
+   if (width == 0 || height == 0 || depth == 0)
+      return;
+
+   /* The fourth word is the worker count for each Metal dispatch.  The launch
+    * is split into chunks so each worker handles one logical ray and the
+    * bounded scratch allocation is reused between chunks.
+    */
+   struct kk_ptr launch_size = kk_pool_alloc(cmd, 16, 256u);
+   if (unlikely(!launch_size.gpu))
+      return;
+
+   size_t scratch_per_thread = kk_rt_scratch_stride(cmd);
+   kk_set_rt_scratch_stride(cmd, scratch_per_thread);
+
+   size_t total_threads = (size_t)width * (size_t)height * (size_t)depth;
+   size_t worker_threads = MIN2(total_threads, (size_t)UINT32_MAX);
+   if (scratch_per_thread > 0) {
+      worker_threads =
+         MIN2(worker_threads, kk_rt_worker_count(scratch_per_thread));
+      size_t total_scratch_size = scratch_per_thread * worker_threads;
+      if (!kk_ensure_rt_scratch(cmd, total_scratch_size))
+         return;
+   }
+
+   assert(worker_threads > 0 && worker_threads <= UINT32_MAX);
+   uint32_t *dims = launch_size.cpu;
+   dims[0] = width;
+   dims[1] = height;
+   dims[2] = depth;
+   dims[3] = (uint32_t)worker_threads;
+
+   // Point ray_launch_size_addr to this device buffer
+   desc->root.rt.ray_launch_size_addr = launch_size.gpu;
+   desc->root_dirty = true;
+
+   kk_set_rt_sbt_root(desc, pRaygenShaderBindingTable, pMissShaderBindingTable,
+                      pHitShaderBindingTable, pCallableShaderBindingTable);
+
+   cmd->state.rt.local_size.x = 32;
+   cmd->state.rt.local_size.y = 1;
+   cmd->state.rt.local_size.z = 1;
+
+   for (size_t launch_base = 0; launch_base < total_threads;
+        launch_base += worker_threads) {
+      size_t chunk_threads = MIN2(worker_threads, total_threads - launch_base);
+
+      desc->root_dirty |= desc->root.rt.ray_launch_base != launch_base;
+      desc->root_dirty |= desc->root.rt.ray_launch_count != chunk_threads;
+      desc->root.rt.ray_launch_base = launch_base;
+      desc->root.rt.ray_launch_count = chunk_threads;
+      kk_flush_rt_state(cmd);
+
+      struct mtl_size grid_size = {
+         .x = MIN2(worker_threads, chunk_threads),
+         .y = 1,
+         .z = 1,
+      };
+      mtl_compute_encoder *enc = cs_get_compute(cmd, true);
+      kk_rt_scratch_acquire(cmd, enc);
+      mtl_dispatch_threads(enc, grid_size, cmd->state.rt.local_size);
+      kk_rt_scratch_release(cmd);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdTraceRaysIndirectKHR(
+   VkCommandBuffer commandBuffer,
+   const VkStridedDeviceAddressRegionKHR *pRaygenShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pMissShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pHitShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pCallableShaderBindingTable,
+   VkDeviceAddress indirectDeviceAddress)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_descriptor_state *desc = &cmd->state.rt.descriptors;
+
+   /* Flatten the Vulkan launch into one-dimensional Metal threadgroups. */
+   cmd->state.rt.local_size.x = 32;
+   cmd->state.rt.local_size.y = 1;
+   cmd->state.rt.local_size.z = 1;
+
+   uint32_t max_worker_threads;
+   if (!kk_prepare_rt_indirect_scratch(cmd, &max_worker_threads))
+      return;
+
+   // Allocate output buffers for conversion shader
+   struct kk_ptr mtl_indirect = kk_pool_alloc(cmd, 12, 256u);
+   struct kk_ptr launch_size = kk_pool_alloc(cmd, 16, 256u);
+   if (unlikely(!mtl_indirect.gpu || !launch_size.gpu))
+      return;
+
+   // Convert Vulkan indirect buffer format to Metal format using conversion
+   // shader
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+
+   mtl_compute_pipeline_state *conversion_pipeline =
+      kk_device_lib_pipeline(dev, KK_LIB_CONVERT_TRACE_RAYS_INDIRECT);
+   mtl_compute_set_pipeline_state(encoder, conversion_pipeline);
+
+   /* Buffer[0] (In): Vulkan indirect buffer (VkTraceRaysIndirectCommandKHR) */
+   mtl_set_address(cmd->argument_table, indirectDeviceAddress, 0u);
+
+   /* Buffer[1] (Out): Metal indirect buffer
+    * (MTLDispatchThreadgroupsIndirectArguments) */
+   mtl_set_address(cmd->argument_table, mtl_indirect.gpu, 1u);
+
+   /* Buffer[2] (Out): original Vulkan launch dimensions */
+   mtl_set_address(cmd->argument_table, launch_size.gpu, 2u);
+
+   /* Buffer[3] (In): Conversion params (threadgroup size) */
+   struct {
+      uint32_t threadgroup_size_x;
+      uint32_t threadgroup_size_y;
+      uint32_t threadgroup_size_z;
+      uint32_t max_worker_threads;
+   } params = {
+      .threadgroup_size_x = cmd->state.rt.local_size.x,
+      .threadgroup_size_y = cmd->state.rt.local_size.y,
+      .threadgroup_size_z = cmd->state.rt.local_size.z,
+      .max_worker_threads = max_worker_threads,
+   };
+   struct kk_ptr params_gpu =
+      kk_pool_upload(cmd, &params, sizeof(params), 256u);
+   if (unlikely(!params_gpu.gpu))
+      return;
+   mtl_set_address(cmd->argument_table, params_gpu.gpu, 3u);
+
+   /* Dispatch conversion shader (single thread) */
+   struct mtl_size grid_size = {.x = 1, .y = 1, .z = 1};
+   struct mtl_size local_size = {.x = 1, .y = 1, .z = 1};
+   mtl_dispatch_threads(encoder, grid_size, local_size);
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                    MTL_STAGE_DISPATCH);
+
+   kk_set_rt_sbt_root(desc, pRaygenShaderBindingTable, pMissShaderBindingTable,
+                      pHitShaderBindingTable, pCallableShaderBindingTable);
+
+   // Set ray_launch_size_addr to the GPU-produced indirect dimensions.
+   desc->root.rt.ray_launch_size_addr = launch_size.gpu;
+   desc->root.rt.ray_launch_base = 0;
+   desc->root.rt.ray_launch_count = 0;
+   desc->root_dirty = true;
+
+   kk_flush_rt_state(cmd);
+
+   // Get new encoder after state flush
+   encoder = cs_get_compute(cmd, true);
+
+   // Dispatch ray tracing using converted Metal indirect buffer
+   kk_rt_scratch_acquire(cmd, encoder);
+   mtl_dispatch_threadgroups_with_indirect_buffer(encoder, mtl_indirect.gpu,
+                                                  cmd->state.rt.local_size);
+   kk_rt_scratch_release(cmd);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdTraceRaysIndirect2KHR(VkCommandBuffer commandBuffer,
+                            VkDeviceAddress indirectDeviceAddress)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_descriptor_state *desc = &cmd->state.rt.descriptors;
+
+   cmd->state.rt.local_size.x = 32;
+   cmd->state.rt.local_size.y = 1;
+   cmd->state.rt.local_size.z = 1;
+
+   uint32_t max_worker_threads;
+   if (!kk_prepare_rt_indirect_scratch(cmd, &max_worker_threads))
+      return;
+
+   struct kk_ptr mtl_indirect = kk_pool_alloc(cmd, 12, 256u);
+   struct kk_ptr launch_size = kk_pool_alloc(cmd, 16, 256u);
+   if (unlikely(!mtl_indirect.gpu || !launch_size.gpu))
+      return;
+
+   desc->root.rt.ray_launch_size_addr = launch_size.gpu;
+   desc->root.rt.ray_launch_base = 0;
+   desc->root.rt.ray_launch_count = 0;
+   desc->root_dirty = true;
+
+   /* Upload the complete root first.  The conversion shader patches the SBT
+    * fields in that GPU copy without reading GPU-written indirect data on the
+    * CPU timeline.
+    */
+   kk_flush_rt_state(cmd);
+   uint64_t root_addr = desc->root.addr;
+   if (unlikely(!root_addr))
+      return;
+
+   mtl_compute_encoder *encoder = cs_get_compute(cmd, true);
+   mtl_compute_pipeline_state *conversion_pipeline =
+      kk_device_lib_pipeline(dev, KK_LIB_CONVERT_TRACE_RAYS_INDIRECT2);
+   mtl_compute_set_pipeline_state(encoder, conversion_pipeline);
+
+   mtl_set_address(cmd->argument_table, indirectDeviceAddress, 0u);
+   mtl_set_address(cmd->argument_table, mtl_indirect.gpu, 1u);
+   mtl_set_address(cmd->argument_table, launch_size.gpu, 2u);
+
+   struct {
+      uint32_t threadgroup_size_x;
+      uint32_t max_worker_threads;
+      uint32_t raygen_address_offset;
+      uint32_t miss_address_offset;
+      uint32_t hit_address_offset;
+      uint32_t callable_address_offset;
+      uint32_t raygen_stride_offset;
+      uint32_t miss_stride_offset;
+      uint32_t hit_stride_offset;
+      uint32_t callable_stride_offset;
+   } params = {
+      .threadgroup_size_x = cmd->state.rt.local_size.x,
+      .max_worker_threads = max_worker_threads,
+      .raygen_address_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_raygen_addr),
+      .miss_address_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_miss_addr),
+      .hit_address_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_hit_addr),
+      .callable_address_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_callable_addr),
+      .raygen_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_raygen_rec_stride),
+      .miss_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_miss_rec_stride),
+      .hit_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_hit_rec_stride),
+      .callable_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_callable_rec_stride),
+   };
+   struct kk_ptr params_gpu =
+      kk_pool_upload(cmd, &params, sizeof(params), 256u);
+   if (unlikely(!params_gpu.gpu))
+      return;
+   mtl_set_address(cmd->argument_table, params_gpu.gpu, 3u);
+   mtl_set_address(cmd->argument_table, root_addr, 4u);
+
+   struct mtl_size conversion_grid = {.x = 1, .y = 1, .z = 1};
+   struct mtl_size conversion_local = {.x = 1, .y = 1, .z = 1};
+   mtl_dispatch_threads(encoder, conversion_grid, conversion_local);
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                    MTL_STAGE_DISPATCH);
+
+   /* Restore the ray-tracing pipeline and root binding after conversion. */
+   kk_flush_rt_state(cmd);
+   encoder = cs_get_compute(cmd, true);
+   kk_rt_scratch_acquire(cmd, encoder);
+   mtl_dispatch_threadgroups_with_indirect_buffer(encoder, mtl_indirect.gpu,
+                                                  cmd->state.rt.local_size);
+   kk_rt_scratch_release(cmd);
+}

