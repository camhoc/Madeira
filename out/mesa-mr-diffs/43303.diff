+static MTL4BufferRange
+mtl4_buffer_range(mtl_buffer *buffer, uint64_t offset)
+{
+   if (!buffer)
+      return MTL4BufferRangeMake(0, 0);
+
+   /* Offsets are accumulated from several independent sources, so an
+    * out-of-range one must resolve to an empty range rather than wrap the
+    * subtraction into a near-2^64 length. */
+   uint64_t length = mtl_buffer_get_length(buffer);
+   uint64_t remaining = offset < length ? length - offset : 0;
+
+   return MTL4BufferRangeMake(mtl_buffer_get_gpu_address(buffer) + offset,
+                              remaining);
+}
+
+struct mtl_acceleration_structure_triangle_geometry_descriptor *
+mtl_new_acceleration_structure_triangle_geometry_descriptor(
+   uint32_t triangle_count, enum mtl_index_type index_type,
+   mtl_buffer *index_buffer, uint64_t index_buffer_offset,
+   enum mtl_attribute_format vertex_format, mtl_buffer *vertex_buffer,
+   uint64_t vertex_buffer_offset, uint64_t vertex_stride, bool is_opaque,
+   mtl_buffer *transform_buffer, uint64_t transform_buffer_offset)
+{
+   @autoreleasepool {
+      MTL4AccelerationStructureTriangleGeometryDescriptor *descriptor =
+         [MTL4AccelerationStructureTriangleGeometryDescriptor new];
+      descriptor.triangleCount = triangle_count;
+      descriptor.indexType = (MTLIndexType)index_type;
+      descriptor.indexBuffer =
+         mtl4_buffer_range(index_buffer, index_buffer_offset);
+      descriptor.vertexFormat = (MTLAttributeFormat)vertex_format;
+      descriptor.vertexBuffer =
+         mtl4_buffer_range(vertex_buffer, vertex_buffer_offset);
+      descriptor.vertexStride = vertex_stride;
+      descriptor.transformationMatrixBuffer =
+         mtl4_buffer_range(transform_buffer, transform_buffer_offset);
+      /* VkTransformMatrixKHR is a row-major float[3][4]. Metal defaults to
+       * reading the same 12 floats as a column-major float4x3, so tell it the
+       * matrix is row-major. */
+      descriptor.transformationMatrixLayout = MTLMatrixLayoutRowMajor;
+      descriptor.opaque = is_opaque;
+      return (
+         mtl_acceleration_structure_triangle_geometry_descriptor *)descriptor;
+   }
+}
+
+struct mtl_acceleration_structure_bounding_box_geometry_descriptor *
+mtl_new_acceleration_structure_bounding_box_geometry_descriptor(
+   uint32_t bounding_box_count, mtl_buffer *bounding_box_buffer,
+   uint64_t bounding_box_buffer_offset, uint64_t bounding_box_stride,
+   bool is_opaque)
+{
+   @autoreleasepool {
+      MTL4AccelerationStructureBoundingBoxGeometryDescriptor *descriptor =
+         [MTL4AccelerationStructureBoundingBoxGeometryDescriptor new];
+      descriptor.boundingBoxCount = bounding_box_count;
+      descriptor.boundingBoxBuffer =
+         mtl4_buffer_range(bounding_box_buffer, bounding_box_buffer_offset);
+      descriptor.boundingBoxStride = bounding_box_stride;
+      descriptor.opaque = is_opaque;
+      return (mtl_acceleration_structure_bounding_box_geometry_descriptor *)
+         descriptor;
+   }
+}
+
+struct mtl_primitive_acceleration_structure_descriptor *
+mtl_new_primitive_acceleration_structure_descriptor(
+   mtl_acceleration_structure_geometry_descriptor **geometries,
+   uint32_t geometry_count, bool allow_refit)
+{
+   @autoreleasepool {
+      MTL4PrimitiveAccelerationStructureDescriptor *descriptor =
+         [MTL4PrimitiveAccelerationStructureDescriptor new];
+      descriptor.usage = allow_refit ? MTLAccelerationStructureUsageRefit
+                                     : MTLAccelerationStructureUsageNone;
+      NSMutableArray<MTL4AccelerationStructureGeometryDescriptor *>
+         *mtl_geometries = [NSMutableArray arrayWithCapacity:geometry_count];
+      for (uint32_t i = 0; i < geometry_count; i++) {
+         [mtl_geometries
+            addObject:(MTL4AccelerationStructureGeometryDescriptor *)
+                         geometries[i]];
+      }
+      descriptor.geometryDescriptors = mtl_geometries;
+      return (mtl_primitive_acceleration_structure_descriptor *)descriptor;
+   }
+}
+
+struct mtl_instance_acceleration_structure_descriptor *
+mtl_new_instance_acceleration_structure_descriptor(
+   uint32_t instance_count, mtl_buffer *instance_descriptor_buffer,
+   bool allow_refit)
+{
+   @autoreleasepool {
+      MTL4InstanceAccelerationStructureDescriptor *descriptor =
+         [MTL4InstanceAccelerationStructureDescriptor new];
+      descriptor.usage = allow_refit ? MTLAccelerationStructureUsageRefit
+                                     : MTLAccelerationStructureUsageNone;
+      descriptor.instanceCount = instance_count;
+      descriptor.instanceDescriptorType =
+         MTLAccelerationStructureInstanceDescriptorTypeIndirect;
+      descriptor.instanceDescriptorBuffer =
+         mtl4_buffer_range(instance_descriptor_buffer, 0);
+      return (mtl_instance_acceleration_structure_descriptor *)descriptor;
+   }
+}
+
+struct mtl_acceleration_structure_sizes
+mtl_calculate_acceleration_structure_sizes(
+   mtl_device *device, mtl_acceleration_structure_descriptor *descriptor)
+{
+   struct mtl_acceleration_structure_sizes return_sizes;
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLAccelerationStructureDescriptor *desc =
+         (MTLAccelerationStructureDescriptor *)descriptor;
+      MTLAccelerationStructureSizes sizes =
+         [dev accelerationStructureSizesWithDescriptor:desc];
+      return_sizes.acceleration_structure_size =
+         sizes.accelerationStructureSize;
+      return_sizes.build_scratch_buffer_size = sizes.buildScratchBufferSize;
+      return_sizes.refit_scratch_buffer_size = sizes.refitScratchBufferSize;
+      return return_sizes;
+   }
+}
