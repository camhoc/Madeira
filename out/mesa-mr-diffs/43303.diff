+mtl_compute_pipeline_state *
+mtl_new_compute_pipeline_state_with_linked_function(
+   mtl_compiler *compiler, mtl_function_descriptor *function,
+   mtl_function_descriptor *linked_function,
+   uint64_t max_total_threads_per_threadgroup, uint64_t max_call_stack_depth)
+{
+   @autoreleasepool {
+      id<MTL4Compiler> comp = (id<MTL4Compiler>)compiler;
+      MTL4ComputePipelineDescriptor *desc =
+         [[MTL4ComputePipelineDescriptor new] autorelease];
+      desc.computeFunctionDescriptor = (MTL4FunctionDescriptor *)function;
+      desc.maxTotalThreadsPerThreadgroup = max_total_threads_per_threadgroup;
+
+      MTL4StaticLinkingDescriptor *linking =
+         [[MTL4StaticLinkingDescriptor new] autorelease];
+      linking.functionDescriptors =
+         @[(MTL4FunctionDescriptor *)linked_function];
+      desc.staticLinkingDescriptor = linking;
+
+      MTL4PipelineStageDynamicLinkingDescriptor *dynamic_linking = nil;
+      if (max_call_stack_depth > 0) {
+         dynamic_linking =
+            [[MTL4PipelineStageDynamicLinkingDescriptor new] autorelease];
+         dynamic_linking.maxCallStackDepth = max_call_stack_depth;
+      }
+
+      NSError *error = nil;
+      id<MTLComputePipelineState> pipeline =
+         [comp newComputePipelineStateWithDescriptor:desc
+                            dynamicLinkingDescriptor:dynamic_linking
+                                 compilerTaskOptions:nil
+                                               error:&error];
+      if (pipeline == nil) {
+         const char *message =
+            error ? error.localizedDescription.UTF8String : "unknown error";
+         fprintf(stderr,
+                 "Failed to create linked MTLComputePipelineState: %s\n",
+                 message);
+      }
+
+      return pipeline;
+   }
