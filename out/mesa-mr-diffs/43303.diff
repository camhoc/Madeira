@@ -0,0 +1,247 @@
+/*
+ * Copyright 2025 Schrödinger, Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_acceleration_structure.h"
+#include "kk_buffer.h"
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_entrypoints.h"
+#include "kk_instance.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "kosmickrisp/bridge/mtl_buffer.h"
+#include "kosmickrisp/bridge/mtl_heap.h"
+
+#include "kosmickrisp/bridge/vk_to_mtl_map.h"
+#include "vulkan/vulkan_core.h"
+#include "vk_physical_device.h"
+
+void
+kk_acceleration_structure_track_metadata_buffer(
+   struct kk_acceleration_structure *accel, mtl_buffer *buffer)
+{
+   if (buffer)
+      util_dynarray_append(&accel->metadata_buffers, buffer);
+}
+
+void
+kk_acceleration_structure_retire_metadata_buffers(
+   struct kk_cmd_buffer *cmd, struct kk_acceleration_structure *accel)
+{
+   util_dynarray_foreach(&accel->metadata_buffers, mtl_buffer *, buffer) {
+      kk_cmd_buffer_retire_buffer(cmd, *buffer);
+   }
+   util_dynarray_clear(&accel->metadata_buffers);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_CreateAccelerationStructureKHR(
+   VkDevice device, const VkAccelerationStructureCreateInfoKHR *pCreateInfo,
+   const VkAllocationCallbacks *pAllocator,
+   VkAccelerationStructureKHR *pAccelerationStructure)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   VkResult result;
+
+   struct kk_acceleration_structure *acceleration_structure =
+      vk_object_zalloc(&dev->vk, pAllocator, sizeof(*acceleration_structure),
+                       VK_OBJECT_TYPE_ACCELERATION_STRUCTURE_KHR);
+
+   if (!acceleration_structure)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   util_dynarray_init(&acceleration_structure->metadata_buffers, NULL);
+
+   VK_FROM_HANDLE(vk_buffer, buffer, pCreateInfo->buffer);
+   acceleration_structure->vk.buffer = buffer;
+   acceleration_structure->vk.offset = pCreateInfo->offset;
+   acceleration_structure->vk.size = pCreateInfo->size;
+
+   acceleration_structure->heap = mtl_new_heap(
+      dev->mtl_handle, pCreateInfo->size, MTL_RESOURCE_STORAGE_MODE_PRIVATE);
+   if (!acceleration_structure->heap) {
+      result = vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      goto fail;
+   }
+
+   /* Add heap to residency set for GPU access */
+   kk_device_add_allocation_to_residency_set(dev, acceleration_structure->heap);
+
+   acceleration_structure->mtl_handle = mtl_new_acceleration_structure(
+      acceleration_structure->heap, pCreateInfo->size, 0u);
+   if (!acceleration_structure->mtl_handle) {
+      result = vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      goto fail_heap;
+   }
+
+   acceleration_structure->gpu_resource_id =
+      mtl_acceleration_structure_get_gpu_resource_id(
+         acceleration_structure->mtl_handle);
+
+   /* IRRuntimeAccelerationStructureGPUHeader + bespoke data for Vulkan */
+   struct acceleration_structure_header header = {
+      .acceleration_structure_resource_id =
+         acceleration_structure->gpu_resource_id,
+      .address_of_instance_contributions = 0, // NULL for now
+      .pad0 = {0},
+      .dispatch_thread_groups_indirect_arguments = {0},
+      .padding_for_alignment = 0,
+      .sbt_offsets_buffer_address = 0,
+      .instance_count = 0,
+      .geometry_count = 0,
+      .geometry_flags_buffer_address = 0,
+      .instance_geom_flags_buffers_address = 0,
+      .instance_flags_address = 0,
+   };
+
+   acceleration_structure->header_buffer = mtl_new_buffer_with_length_on_device(
+      dev->mtl_handle, sizeof(header), MTL_RESOURCE_STORAGE_MODE_SHARED);
+   if (!acceleration_structure->header_buffer) {
+      result = vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      goto fail_acceleration_structure;
+   }
+
+   /* Add header buffer to residency set for GPU access */
+   kk_device_add_allocation_to_residency_set(
+      dev, acceleration_structure->header_buffer);
+
+   void *header_data = mtl_get_contents(acceleration_structure->header_buffer);
+   if (!header_data) {
+      result = vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      goto fail_header;
+   }
+   memcpy(header_data, &header, sizeof(header));
+
+   acceleration_structure->header_address =
+      mtl_buffer_get_gpu_address(acceleration_structure->header_buffer);
+
+   /* Only bottom-level structures are ever named by an instance descriptor,
+    * so keeping top-level ones out of the registry keeps the lookup table the
+    * instance-conversion shader searches as small as it can be. */
+   if (pCreateInfo->type != VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR)
+      kk_blas_registry_add(dev, acceleration_structure);
+
+   *pAccelerationStructure =
+      kk_acceleration_structure_to_handle(acceleration_structure);
+   return VK_SUCCESS;
+
+fail_header:
+   kk_device_remove_allocation_from_residency_set(
+      dev, acceleration_structure->header_buffer);
+   mtl_release(acceleration_structure->header_buffer);
+fail_acceleration_structure:
+   mtl_release(acceleration_structure->mtl_handle);
+fail_heap:
+   kk_device_remove_allocation_from_residency_set(dev,
+                                                  acceleration_structure->heap);
+   mtl_release(acceleration_structure->heap);
+fail:
+   util_dynarray_fini(&acceleration_structure->metadata_buffers);
+   vk_object_free(&dev->vk, pAllocator, acceleration_structure);
+   return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_DestroyAccelerationStructureKHR(
+   VkDevice device, VkAccelerationStructureKHR accelerationStructure,
+   const VkAllocationCallbacks *pAllocator)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   struct kk_acceleration_structure *accel =
+      kk_acceleration_structure_from_handle(accelerationStructure);
+   if (!accel)
+      return;
+
+   kk_blas_registry_remove(dev, accel);
+
+   /* Lock to prevent concurrent access during destruction */
+   simple_mtx_lock(&dev->as_serialization_lock);
+
+   /* Serialization registers this AS both under its header address and under
+    * the device address of every blob it was serialized into, so drop every
+    * entry that points at it rather than just the header key. Otherwise a
+    * later deserialize from one of those blobs dereferences freed memory. */
+   hash_table_u64_foreach(dev->as_serialization_map, entry) {
+      if (entry.data == accel)
+         _mesa_hash_table_u64_remove(dev->as_serialization_map, entry.key);
+   }
+
+   if (accel->header_buffer) {
+      kk_device_remove_allocation_from_residency_set(dev, accel->header_buffer);
+      mtl_release(accel->header_buffer);
+      accel->header_buffer = NULL;
+   }
+
+   util_dynarray_foreach(&accel->metadata_buffers, mtl_buffer *, buffer) {
+      kk_device_remove_allocation_from_residency_set(dev, *buffer);
+      mtl_release(*buffer);
+   }
+   util_dynarray_fini(&accel->metadata_buffers);
+
+   /* Release Metal acceleration structure */
+   if (accel->mtl_handle) {
+      mtl_release(accel->mtl_handle);
+      accel->mtl_handle = NULL;
+   }
+
+   /* Remove heap from residency set and release */
+   if (accel->heap) {
+      kk_device_remove_allocation_from_residency_set(dev, accel->heap);
+      mtl_release(accel->heap);
+      accel->heap = NULL;
+   }
+
+   simple_mtx_unlock(&dev->as_serialization_lock);
+
+   vk_object_free(&dev->vk, pAllocator, accel);
+}
+
+VKAPI_ATTR VkDeviceAddress VKAPI_CALL
+kk_GetAccelerationStructureDeviceAddressKHR(
+   VkDevice device, const VkAccelerationStructureDeviceAddressInfoKHR *pInfo)
+{
+   VK_FROM_HANDLE(kk_acceleration_structure, as, pInfo->accelerationStructure);
+
+   /* Header address rather than device address since this can be placed
+    * in a buffer for dynamic indexing.
+    */
+   return as->header_address;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_BuildAccelerationStructuresKHR(
+   VkDevice _device, VkDeferredOperationKHR deferredOperation,
+   uint32_t infoCount,
+   const VkAccelerationStructureBuildGeometryInfoKHR *pInfos,
+   const VkAccelerationStructureBuildRangeInfoKHR *const *ppBuildRangeInfos)
+{
+   UNREACHABLE("Unimplemented");
+   return VK_ERROR_FEATURE_NOT_PRESENT;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_GetDeviceAccelerationStructureCompatibilityKHR(
+   VkDevice device, const VkAccelerationStructureVersionInfoKHR *pVersionInfo,
+   VkAccelerationStructureCompatibilityKHR *pCompatibility)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   struct kk_instance *instance =
+      (struct kk_instance *)dev->vk.physical->instance;
+   const struct {
+      uint64_t registry_id;
+      uint64_t pad;
+   } accel_struct_compat = {
+      .registry_id = mtl_device_get_registry_id(dev->mtl_handle),
+   };
+   STATIC_ASSERT(sizeof(accel_struct_compat) == VK_UUID_SIZE);
+
+   bool compat = memcmp(pVersionInfo->pVersionData, instance->driver_build_sha,
+                        VK_UUID_SIZE) == 0 &&
+                 memcmp(pVersionInfo->pVersionData + VK_UUID_SIZE,
+                        &accel_struct_compat, VK_UUID_SIZE) == 0;
+   *pCompatibility =
+      compat ? VK_ACCELERATION_STRUCTURE_COMPATIBILITY_COMPATIBLE_KHR
+             : VK_ACCELERATION_STRUCTURE_COMPATIBILITY_INCOMPATIBLE_KHR;
+}

