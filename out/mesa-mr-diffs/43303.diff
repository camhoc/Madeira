+TEST(U64IntervalTreeTest, InsertAndSearch)
+{
+    const uint64_t offset = 1ull << 32;
+    struct u64interval_test_node nodes[ARRAY_SIZE(test_numbers) / 2];
+    struct rb_tree tree;
+
+    rb_tree_init(&tree);
+
+    for (unsigned i = 0; 2 * i < ARRAY_SIZE(test_numbers); i++) {
+        nodes[i].node.interval.start =
+            offset + MIN2(test_numbers[2 * i], test_numbers[2 * i + 1]);
+        nodes[i].node.interval.end =
+            offset + MAX2(test_numbers[2 * i], test_numbers[2 * i + 1]);
+        u64interval_tree_insert(&tree, &nodes[i].node);
+        rb_tree_validate(&tree);
+        validate_u64interval_search(&tree, nodes, 0, i,
+                                    offset, offset + 100);
+        validate_u64interval_search(&tree, nodes, 0, i,
+                                    offset, offset + 50);
+        validate_u64interval_search(&tree, nodes, 0, i,
+                                    offset + 50, offset + 100);
+        validate_u64interval_search(&tree, nodes, 0, i,
+                                    offset, offset + 2);
+    }
+
+    for (unsigned i = 0; 2 * i < ARRAY_SIZE(test_numbers); i++) {
+        u64interval_tree_remove(&tree, &nodes[i].node);
+        rb_tree_validate(&tree);
+        validate_u64interval_search(&tree, nodes, i + 1,
+                                    ARRAY_SIZE(test_numbers) / 2 - 1,
+                                    offset, offset + 100);
+        validate_u64interval_search(&tree, nodes, i + 1,
+                                    ARRAY_SIZE(test_numbers) / 2 - 1,
+                                    offset, offset + 50);
+        validate_u64interval_search(&tree, nodes, i + 1,
+                                    ARRAY_SIZE(test_numbers) / 2 - 1,
+                                    offset + 50, offset + 100);
+        validate_u64interval_search(&tree, nodes, i + 1,
+                                    ARRAY_SIZE(test_numbers) / 2 - 1,
+                                    offset, offset + 2);
+    }
+}
