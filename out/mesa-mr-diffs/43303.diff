+
+   if (desc->root.addr)
+      mtl_set_address(cmd->argument_table, desc->root.addr, 0u);
+
+   mtl_set_address(cmd->argument_table, dev->samplers.table.bo->gpu, 1u);
+
+   mtl_compute_set_pipeline_state(enc, cmd->state.rt.pipeline_state);
+
