+
+#include "kk_private.h"
+
+#include "util/u_dynarray.h"
+#include "vk_acceleration_structure.h"
+
+struct kk_cmd_buffer;
+
+struct acceleration_structure_header {
+   /* Metal runtime fields - do not modify */
+   uint64_t acceleration_structure_resource_id;
+   uint64_t address_of_instance_contributions;
+   uint64_t pad0[4]; /* Reserved by Metal */
+   uint32_t dispatch_thread_groups_indirect_arguments[3];
+
+   /* Extra data for Vulkan features not in Metal */
+   uint32_t padding_for_alignment; /* Just in case -- padding to next 64 bits */
+   uint64_t sbt_offsets_buffer_address; /* GPU address of SBT offsets buffer
+                                           (uint32_t array) - TLAS only */
+   uint32_t instance_count;             /* Number of instances in TLAS */
+   uint32_t geometry_count;             /* Number of geometries in BLAS */
+   uint64_t
+      geometry_flags_buffer_address; /* GPU address of geometry flags buffer
+                                        (uint8_t array) - BLAS only */
+   uint64_t
+      instance_geom_flags_buffers_address; /* GPU address of per-instance
+                                              geometry flags buffers (uint64_t
+                                              array) - TLAS only */
+   uint64_t instance_flags_address; /* GPU address of instance opacity flags
+                                       (uint8_t array: bit0=FORCE_OPAQUE,
+                                       bit1=FORCE_NON_OPAQUE) - TLAS only */
+};
+
+struct kk_acceleration_structure {
+   struct vk_acceleration_structure vk;
+
+   /* MTL handle for AS */
+   mtl_acceleration_structure *mtl_handle;
+
+   /* Heap where AS is backed */
+   mtl_heap *heap;
+
+   /* GPU Resource ID of the Acceleration Structure */
+   uint64_t gpu_resource_id;
+
+   /* Side-buffer for SBT offsets (indexed by instance_id) */
+   /* Content: maps instance_id -> sbt_offset (uint32_t) */
+   mtl_buffer *instance_sbt_offsets_buffer;
+
+   /* [TLAS] Content: maps instance_id -> geometry_flags_buffer_address
+    * (uint64_t) */
