+/* Resolves a buffer plus offset into the range Metal should see.  An offset
+ * past the end of the buffer yields an empty range instead of wrapping the
+ * length subtraction around to a near-2^64 value. */
+static MTL4BufferRange
+mtl4_scratch_range(mtl_buffer *buffer, uint64_t offset)
+{
+   if (!buffer)
+      return MTL4BufferRangeMake(0, 0);
+
+   uint64_t length = mtl_buffer_get_length(buffer);
+   uint64_t remaining = offset < length ? length - offset : 0;
+
+   return MTL4BufferRangeMake(mtl_buffer_get_gpu_address(buffer) + offset,
+                              remaining);
+}
