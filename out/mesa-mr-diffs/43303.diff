+}
+
+uint32_t
+kk_blas_registry_count(struct kk_device *dev)
+{
+   simple_mtx_lock(&dev->blas_registry_lock);
+   uint32_t count = util_dynarray_num_elements(
+      &dev->blas_registry, struct kk_acceleration_structure *);
+   simple_mtx_unlock(&dev->blas_registry_lock);
+   return count;
+}
+
+void
+kk_as_serialization_purge_range(struct kk_device *dev, uint64_t start,
+                                uint64_t end)
+{
+   simple_mtx_lock(&dev->as_serialization_lock);
+   hash_table_u64_foreach(dev->as_serialization_map, entry) {
+      if (entry.key >= start && entry.key <= end)
+         _mesa_hash_table_u64_remove(dev->as_serialization_map, entry.key);
+   }
+   simple_mtx_unlock(&dev->as_serialization_lock);
+}
+
+static int
+kk_blas_lookup_entry_compare(const void *a, const void *b)
+{
+   uint64_t lhs = ((const struct kk_blas_lookup_entry *)a)->address;
+   uint64_t rhs = ((const struct kk_blas_lookup_entry *)b)->address;
+
+   return (lhs > rhs) - (lhs < rhs);
+}
+
+bool
+kk_blas_registry_snapshot(struct kk_device *dev,
+                          struct kk_blas_lookup_entry *entries,
+                          uint32_t entry_capacity, uint32_t *out_count)
+{
+   simple_mtx_lock(&dev->blas_registry_lock);
+   uint32_t count = util_dynarray_num_elements(
+      &dev->blas_registry, struct kk_acceleration_structure *);
+   *out_count = count;
+
+   if (count > entry_capacity) {
+      simple_mtx_unlock(&dev->blas_registry_lock);
+      return false;
+   }
+
+   uint32_t index = 0;
+   util_dynarray_foreach(&dev->blas_registry,
+                         struct kk_acceleration_structure *, ptr_ptr) {
+      entries[index++] = (struct kk_blas_lookup_entry){
+         .address = (*ptr_ptr)->header_address,
+         .resource_id = (*ptr_ptr)->gpu_resource_id,
+      };
+   }
+   simple_mtx_unlock(&dev->blas_registry_lock);
+
+   /* The instance-conversion shader binary searches this table, so it has to
+    * be ordered by address. Header addresses are unique per structure. */
+   qsort(entries, count, sizeof(*entries), kk_blas_lookup_entry_compare);
+   return true;
 }

