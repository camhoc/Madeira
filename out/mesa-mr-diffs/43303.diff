+void
+mtl_build_acceleration_structure(
+   mtl_acceleration_structure_encoder *encoder,
+   mtl_acceleration_structure *dst_as,
+   mtl_acceleration_structure_descriptor *descriptor,
+   mtl_buffer *scratch_buffer, uint64_t scratch_buffer_offset)
+{
+   @autoreleasepool {
+      id<MTL4ComputeCommandEncoder> enc =
+         (id<MTL4ComputeCommandEncoder>)encoder;
+      id<MTLAccelerationStructure> dst = (id<MTLAccelerationStructure>)dst_as;
+      MTL4BufferRange scratch =
+         mtl4_scratch_range(scratch_buffer, scratch_buffer_offset);
+      [enc buildAccelerationStructure:dst
+                           descriptor:(MTL4AccelerationStructureDescriptor *)
+                                         descriptor
+                        scratchBuffer:scratch];
+   }
+}
