+static bool
+kk_ensure_rt_scratch(struct kk_cmd_buffer *cmd, size_t size)
+{
+   if (size == 0)
+      return true;
+
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_bo *scratch_bo = cmd->state.rt.scratch_bo;
+   if (!scratch_bo || cmd->state.rt.scratch_bo_size < size) {
+      /* The GPU may still use the old buffer for an earlier dispatch recorded
+       * in this command buffer.
+       */
+      if (scratch_bo) {
+         util_dynarray_append(&cmd->large_bos, scratch_bo);
+         cmd->state.rt.scratch_bo = NULL;
+         cmd->state.rt.scratch_bo_size = 0;
+      }
+
+      VkResult result =
+         kk_alloc_bo(dev, &cmd->vk.base, size, 256u, &scratch_bo);
+      if (result != VK_SUCCESS) {
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return false;
+      }
+
+      cmd->state.rt.scratch_bo = scratch_bo;
+      cmd->state.rt.scratch_bo_size = size;
+
+      /* Nothing recorded so far can be using this allocation. */
+      cmd->state.rt.scratch_hazard = false;
+   }
+
+   struct kk_descriptor_state *desc = &cmd->state.rt.descriptors;
+   desc->root.rt.scratch_buffer_addr = scratch_bo->gpu;
+   desc->root_dirty = true;
+   return true;
+}
