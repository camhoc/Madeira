@@ -0,0 +1,52 @@
+/*
+ * Copyright 2025 Schrödinger, Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+/**
+ * @file kk_nir_lower_sbt.c
+ * @brief Shader binding table offsets within the root descriptor table
+ *
+ * The MSL backend reads the SBT base addresses and record strides straight out
+ * of the root descriptor buffer, so all this file provides is the mapping from
+ * SBT fields to their offsets in struct kk_root_descriptor_table.
+ */
+
+#include "kk_nir_lower_sbt.h"
+
+#include "kk_cmd_buffer.h"
+
+struct shader_binding_table_info
+kk_nir_lower_sbt_options_kk(void)
+{
+   struct shader_binding_table_info options = {
+      .sbt_buffer_binding = 0,
+      .raygen_addr_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_raygen_addr),
+      .miss_addr_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_miss_addr),
+      .hit_addr_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_hit_addr),
+      .callable_addr_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_callable_addr),
+      .raygen_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_raygen_rec_stride),
+      .miss_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_miss_rec_stride),
+      .hit_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_hit_rec_stride),
+      .callable_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.sbt_callable_rec_stride),
+      .ray_launch_size_addr_offset =
+         offsetof(struct kk_root_descriptor_table, rt.ray_launch_size_addr),
+      .ray_launch_base_offset =
+         offsetof(struct kk_root_descriptor_table, rt.ray_launch_base),
+      .ray_launch_count_offset =
+         offsetof(struct kk_root_descriptor_table, rt.ray_launch_count),
+      .scratch_buffer_addr_offset =
+         offsetof(struct kk_root_descriptor_table, rt.scratch_buffer_addr),
+      .scratch_buffer_stride_offset =
+         offsetof(struct kk_root_descriptor_table, rt.scratch_buffer_stride),
+   };
+   return options;
+}

