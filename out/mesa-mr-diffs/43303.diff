+      return;
+
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH,
+                                    MTL_STAGE_DISPATCH);
+   cmd->state.rt.scratch_hazard = false;
+}
+
+static void
+kk_rt_scratch_release(struct kk_cmd_buffer *cmd)
+{
+   cmd->state.rt.scratch_hazard = cmd->state.rt.scratch_bo != NULL;
+}
+
+static size_t
+kk_rt_scratch_stride(struct kk_cmd_buffer *cmd)
+{
+   assert(cmd->state.rt.pipeline && "Ray tracing pipeline must be bound");
+
+   const struct kk_rt_pipeline *pipeline = cmd->state.rt.pipeline;
+   size_t compiled_size =
+      ALIGN_POT(pipeline->scratch_buffer_size, KK_RT_SCRATCH_STRIDE_ALIGN);
+   if (compiled_size == 0)
+      return 0;
+
+   /* Only pipelines that declared the dynamic state consult the value the
+    * application supplied; everything else uses the compiled layout. */
+   if (!pipeline->dynamic_stack_size || !cmd->state.rt.stack_size_set)
+      return compiled_size;
+
+   /* Requests at or above the compiled layout cannot address any additional
+    * data. */
+   if (cmd->state.rt.stack_size >= compiled_size)
+      return compiled_size;
+
+   /* The application sizes its request from the group stack sizes the driver
+    * reports, which do not include the hit attribute prefix the traversal
+    * loop writes at the deepest callee frame.  Metal also requires the
+    * per-worker frames to stay naturally aligned. */
+   size_t requested_size =
+      ALIGN_POT((size_t)cmd->state.rt.stack_size + KK_RAY_HIT_ATTRIBS_SIZE,
+                KK_RT_SCRATCH_STRIDE_ALIGN);
+
+   return MIN2(requested_size, compiled_size);
+}
+
+static size_t
+kk_rt_worker_count(size_t scratch_per_thread)
+{
+   assert(scratch_per_thread > 0);
+
+   return MAX2((size_t)1, (size_t)(KK_RT_SCRATCH_BUDGET / scratch_per_thread));
+}
+
+static void
+kk_set_rt_scratch_stride(struct kk_cmd_buffer *cmd, size_t stride)
+{
+   struct kk_descriptor_state *desc = &cmd->state.rt.descriptors;
+   desc->root_dirty |= desc->root.rt.scratch_buffer_stride != stride;
+   desc->root.rt.scratch_buffer_stride = stride;
+}
+
+static bool
+kk_prepare_rt_indirect_scratch(struct kk_cmd_buffer *cmd,
+                               uint32_t *max_worker_threads)
+{
+   size_t scratch_per_thread = kk_rt_scratch_stride(cmd);
+   kk_set_rt_scratch_stride(cmd, scratch_per_thread);
+
+   *max_worker_threads = UINT32_MAX;
+   if (scratch_per_thread == 0)
+      return true;
+
+   size_t worker_threads = kk_rt_worker_count(scratch_per_thread);
+   *max_worker_threads = (uint32_t)MIN2(worker_threads, (size_t)UINT32_MAX);
+
+   return kk_ensure_rt_scratch(cmd, scratch_per_thread * *max_worker_threads);
+}
+
+/* Stores the SBT device addresses and strides for shader access. The callable
+ * region is optional, so a missing one reads as a zeroed region. */
+static void
+kk_set_rt_sbt_root(
+   struct kk_descriptor_state *desc,
+   const VkStridedDeviceAddressRegionKHR *pRaygenShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pMissShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pHitShaderBindingTable,
+   const VkStridedDeviceAddressRegionKHR *pCallableShaderBindingTable)
+{
+   const VkDeviceAddress callable_addr =
+      pCallableShaderBindingTable ? pCallableShaderBindingTable->deviceAddress
+                                  : 0;
+
+   desc->root_dirty |=
+      desc->root.rt.sbt_raygen_addr != pRaygenShaderBindingTable->deviceAddress;
+   desc->root_dirty |=
+      desc->root.rt.sbt_miss_addr != pMissShaderBindingTable->deviceAddress;
+   desc->root_dirty |=
+      desc->root.rt.sbt_hit_addr != pHitShaderBindingTable->deviceAddress;
+   desc->root_dirty |= desc->root.rt.sbt_callable_addr != callable_addr;
+
+   desc->root.rt.sbt_raygen_addr = pRaygenShaderBindingTable->deviceAddress;
+   desc->root.rt.sbt_miss_addr = pMissShaderBindingTable->deviceAddress;
+   desc->root.rt.sbt_hit_addr = pHitShaderBindingTable->deviceAddress;
+   desc->root.rt.sbt_callable_addr = callable_addr;
+
+   desc->root.rt.sbt_raygen_rec_stride = pRaygenShaderBindingTable->stride;
+   desc->root.rt.sbt_miss_rec_stride = pMissShaderBindingTable->stride;
+   desc->root.rt.sbt_hit_rec_stride = pHitShaderBindingTable->stride;
+   desc->root.rt.sbt_callable_rec_stride =
+      pCallableShaderBindingTable ? pCallableShaderBindingTable->stride : 0;
+}
+
