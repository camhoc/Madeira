+struct u64interval_test_node {
+    struct u64interval_node node;
+};
+
+static unsigned
+count_u64interval_matches(struct rb_tree *tree, uint64_t start, uint64_t end)
+{
+    struct u64interval interval = { start, end };
+    uint64_t previous_start = 0;
+    unsigned count = 0;
+
+    u64interval_tree_foreach (struct u64interval_test_node, n, interval,
+                              tree, node) {
+        EXPECT_LE(n->node.interval.start, end);
+        EXPECT_GE(n->node.interval.end, start);
+        EXPECT_GE(n->node.interval.start, previous_start);
+
+        previous_start = n->node.interval.start;
+        count++;
+    }
+
+    return count;
+}
+
+static void
+validate_u64interval_search(struct rb_tree *tree,
+                            struct u64interval_test_node *nodes,
+                            int first_node, int last_node,
+                            uint64_t start, uint64_t end)
+{
+    unsigned expected_count = 0;
+
+    for (int i = first_node; i <= last_node; i++) {
+        if (nodes[i].node.interval.start <= end &&
+            nodes[i].node.interval.end >= start)
+            expected_count++;
+    }
+
+    EXPECT_EQ(expected_count, count_u64interval_matches(tree, start, end));
+}
