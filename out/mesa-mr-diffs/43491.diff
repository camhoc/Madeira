@@ -17,6 +17,80 @@
 
 #include "vk_cmd_queue.h"
 
+static void
+metal3_presentation_callback(void *data)
+{
+   mtl_release(data);
+}
+
+static void
+metal3_submit(struct kk_queue *queue, struct vk_queue_submit *submit)
+{
+   mtl_command_buffer *cmd = mtl3_new_command_buffer(queue->mtl3_handle);
+   for (struct vk_sync_wait *wait = submit->waits,
+                            *end = submit->waits + submit->wait_count;
+        wait != end; ++wait) {
+      struct kk_sync_timeline *sync =
+         container_of(wait->sync, struct kk_sync_timeline, base);
+      mtl3_encode_wait_for_event(cmd, sync->mtl_handle, wait->wait_value);
+   }
+
+   /* We know present command buffers only contain a few pipeline barriers and a
+    * single copy command, find the single copy command in the command buffer. */
+   struct kk_cmd_buffer *cmd_buffer =
+      container_of(submit->command_buffers[0], struct kk_cmd_buffer, vk);
+   struct vk_cmd_queue *cmd_queue = &cmd_buffer->vk.cmd_queue;
+   list_for_each_entry(struct vk_cmd_queue_entry, command, &cmd_queue->cmds,
+                       cmd_link) {
+      switch (command->type) {
+      case VK_CMD_COPY_IMAGE: {
+         const struct vk_cmd_copy_image *copy = &command->u.copy_image;
+         VK_FROM_HANDLE(kk_image, src, copy->src_image);
+         VK_FROM_HANDLE(kk_image, dst, copy->dst_image);
+         for (uint32_t i = 0u; i < copy->region_count; ++i) {
+            const VkImageCopy *region = &copy->regions[i];
+            const VkExtent3D extent_px =
+               vk_image_sanitize_extent(&src->vk, region->extent);
+            size_t src_slice = region->srcSubresource.baseArrayLayer;
+            size_t src_level = region->srcSubresource.mipLevel;
+            struct mtl_origin src_origin =
+               vk_offset_3d_to_mtl_origin(&region->srcOffset);
+            struct mtl_size size = {.x = extent_px.width,
+                                    .y = extent_px.height,
+                                    .z = extent_px.depth};
+            size_t dst_slice = region->dstSubresource.baseArrayLayer;
+            size_t dst_level = region->dstSubresource.mipLevel;
+            struct mtl_origin dst_origin =
+               vk_offset_3d_to_mtl_origin(&region->dstOffset);
+
+            mtl3_copy_from_texture_to_texture(cmd, src->planes[0].mtl_handle,
+                                              src_slice, src_level, src_origin,
+                                              size, dst->planes[0].mtl_handle,
+                                              dst_slice, dst_level, dst_origin);
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+
+   mtl3_present_drawable(cmd, cmd_buffer->drawable);
+
+   for (uint32_t i = 0u; i < submit->signal_count; ++i) {
+      struct vk_sync_signal *signal = &submit->signals[i];
+      struct kk_sync_timeline *sync =
+         container_of(signal->sync, struct kk_sync_timeline, base);
+      mtl3_encode_signal_for_event(cmd, sync->mtl_handle, signal->signal_value);
+   }
+
+   mtl3_add_completed_handler(cmd, metal3_presentation_callback,
+                              cmd_buffer->drawable);
+   cmd_buffer->drawable = NULL;
+
+   mtl3_commit(cmd);
+}
+
