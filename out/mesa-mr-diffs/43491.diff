+/*
+ * Copyright 2026 LunarG, Inc.
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl3_backend.h"
+
+#include <Metal/MTLDevice.h>
+#include <Metal/MTLCommandQueue.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+/* MTLCommandQueue */
+mtl_command_queue *
+mtl3_new_command_queue(mtl_device *device)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      return [dev newCommandQueueWithMaxCommandBufferCount:256];
+   }
+}
+
+mtl_command_buffer *
+mtl3_new_command_buffer(mtl_command_queue *queue)
+{
+   @autoreleasepool {
+      id<MTLCommandQueue> q = (id<MTLCommandQueue>)queue;
+      return [[q commandBuffer] retain];
+   }
+}
+
+void
+mtl3_encode_wait_for_event(mtl_command_buffer *cmd, mtl_event *event,
+                           uint64_t value)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> c = (id<MTLCommandBuffer>)cmd;
+      id<MTLEvent> e = (id<MTLEvent>)event;
+      return [c encodeWaitForEvent:e value:value];
+   }
+}
+
+void
+mtl3_encode_signal_for_event(mtl_command_buffer *cmd, mtl_event *event,
+                             uint64_t value)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> c = (id<MTLCommandBuffer>)cmd;
+      id<MTLEvent> e = (id<MTLEvent>)event;
+      return [c encodeSignalEvent:e value:value];
+   }
+}
+
+void
+mtl3_copy_from_texture_to_texture(mtl_command_buffer *cmd, mtl_texture *src,
+                                  size_t src_slice, size_t src_level,
+                                  struct mtl_origin src_origin,
+                                  struct mtl_size src_size, mtl_texture *dst,
+                                  size_t dst_slice, size_t dst_level,
+                                  struct mtl_origin dst_origin)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> c = (id<MTLCommandBuffer>)cmd;
+      id<MTLBlitCommandEncoder> enc = [c blitCommandEncoder];
+
+      MTLOrigin mtl_src_origin = MTLOriginMake(src_origin.x, src_origin.y, src_origin.z);
+      MTLSize mtl_src_size = MTLSizeMake(src_size.x, src_size.y, src_size.z);
+      MTLOrigin mtl_dst_origin = MTLOriginMake(dst_origin.x, dst_origin.y, dst_origin.z);
+      id<MTLTexture> mtl_dst_tex = (id<MTLTexture>)dst;
+      id<MTLTexture> mtl_src_tex = (id<MTLTexture>)src;
+      [enc copyFromTexture:mtl_src_tex
+               sourceSlice:src_slice
+               sourceLevel:src_level
+              sourceOrigin:mtl_src_origin
+                sourceSize:mtl_src_size
+                 toTexture:mtl_dst_tex
+          destinationSlice:dst_slice
+          destinationLevel:dst_level
+         destinationOrigin:mtl_dst_origin];
+      [enc endEncoding];
+   }
+}
+
+void
+mtl3_add_completed_handler(mtl_command_buffer *cmd, void (*callback)(void *),
+                           void *data)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> c = (id<MTLCommandBuffer>)cmd;
+      [c addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+        callback(data);
+        [cb release];
+      }];
+   }
+}
+
+void
+mtl3_present_drawable(mtl_command_buffer *cmd, void *drawable)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> c = (id<MTLCommandBuffer>)cmd;
+      id<CAMetalDrawable> d = (id<CAMetalDrawable>)drawable;
+
+      [c presentDrawable:d];
+   }
+}
+
+void
+mtl3_commit(mtl_command_buffer *cmd)
+{
+   @autoreleasepool {
+      id<MTLCommandBuffer> c = (id<MTLCommandBuffer>)cmd;
+      [c commit];
+   }
+}

