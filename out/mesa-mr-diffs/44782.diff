# kk: allow rendering to linear color images (not as input attachments)
# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/44782 state=closed
# This lets apps render into linear images with KosmicKrisp. Sharing images between processes as dma-bufs needs that, e.g. virglrenderer's Venus on macOS, which can only share linear images, so GPU-rendered frames can be shown by a guest compositor.

KosmicKrisp didn't report COLOR_ATTACHMENT (or BLIT_DST) for linear tiling and rejected linear images with color attachment usage. Metal can render to linear, buffer-backed textures, though. What it can't do is use them as input attachments, which KosmicKrisp implements with texture arrays. So this allows linear color attachments and keeps rejecting linear input and depth/stencil attachments.

Tested with virglrenderer's Venus render server on KosmicKrisp: a Linux guest renders into linear images that are then shared with the host.
--- src/kosmickrisp/vulkan/kk_image.c
+++ src/kosmickrisp/vulkan/kk_image.c
@@ -59,9 +59,11 @@ kk_get_image_plane_format_features(struct kk_physical_device *pdev,
       features |= VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_DEPTH_COMPARISON_BIT;
    }
 
-   /* We disable A8 format due to lower blend pass issues */
-   if (va_format->color && tiling != VK_IMAGE_TILING_LINEAR &&
-       vk_format != VK_FORMAT_A8_UNORM) {
+   /* We disable A8 format due to lower blend pass issues. Linear (buffer
+    * backed) textures can be render targets in Metal too: dma-buf sharing in
+    * virtual machines (virglrenderer on macOS) needs renderable linear images.
+    */
+   if (va_format->color && vk_format != VK_FORMAT_A8_UNORM) {
       features |= VK_FORMAT_FEATURE_2_COLOR_ATTACHMENT_BIT;
       features |= VK_FORMAT_FEATURE_2_BLIT_DST_BIT;
       // TODO_KOSMICKRISP Support snorm formats once the following spec issue is
@@ -278,7 +280,7 @@ kk_GetPhysicalDeviceImageFormatProperties2(
     */
    if (pImageFormatInfo->tiling == VK_IMAGE_TILING_LINEAR &&
        (pImageFormatInfo->usage &
-        (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+        (VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT |
          VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)))
       return VK_ERROR_FORMAT_NOT_SUPPORTED;
 

