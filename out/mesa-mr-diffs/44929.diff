     */
-   if (image->vk.usage & VK_IMAGE_USAGE_HOST_TRANSFER_BIT_EXT) {
+   if (image->vk.tiling == VK_IMAGE_TILING_OPTIMAL) {
       for (uint32_t i = 0; i < pdev->mem_type_count; i++) {
-         if (!(pdev->mem_types[i].propertyFlags &
-               VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+         if (pdev->mem_types[i].propertyFlags &
+             VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
             memory_types &= ~BITFIELD_BIT(i);
       }
    }

--- src/kosmickrisp/vulkan/kk_physical_device.c
+++ src/kosmickrisp/vulkan/kk_physical_device.c
@@ -1192,6 +1192,14 @@ kk_enumerate_physical_devices(struct vk_instance *_instance)
       .used = kk_get_sysmem_heap_used,
    };
 
+   /* Tiled images only take this type (kk_get_image_memory_requirements), so
+    * they can't be bound to memory imported from a host pointer, which has no
+    * heap for them */
