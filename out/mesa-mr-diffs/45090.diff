+    * At exit of B, constant c was evicted from W_exit.
+    * In D, evicted constant c must not cause the phi to be spilled to memory.
+    */
+   agx_spill(b->shader, 8, true);
+
+   /* Assert no memory registers were created */
+   agx_foreach_instr_global(b->shader, I) {
+      for (unsigned i = 0; i < I->nr_dests; ++i)
+         EXPECT_FALSE(I->dest[i].memory);
+      for (unsigned i = 0; i < I->nr_srcs; ++i)
+         EXPECT_FALSE(I->src[i].memory);
+   }
+}

