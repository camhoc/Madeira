+   b->cursor = agx_after_block(B);
+   agx_index c = agx_mov_imm(b, 32, 0x2222);
+   agx_index b_temp = agx_fadd(b, live2, wx);
+   agx_unit_test(b, b_temp);
+
+   /* C creates another value for the phi */
+   b->cursor = agx_after_block(C);
+   agx_index d = agx_fadd(b, live1, wx);
+
+   /* D joins with phi, plus use of live1.
+    * Peak in D is phi (2) + live1 (2) + result (2) = 6 <= 6. Fits without spill.
