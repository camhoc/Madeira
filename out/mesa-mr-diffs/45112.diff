--- src/kosmickrisp/vulkan/kk_image.c
+++ src/kosmickrisp/vulkan/kk_image.c
@@ -85,6 +85,11 @@ kk_get_image_plane_format_features(struct kk_physical_device *pdev,
    if (va_format == NULL)
