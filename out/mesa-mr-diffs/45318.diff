# kk: Fake depth bounds support for idTech
# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45318 state=merged
# Support for depth bounds is the only thing blocking Doom 2016 from running on Kosmickrisp on M1-M4.

ANV fakes depthBounds support for idTech and it seems to be fine.
So just do the same in Kosmickrisp.
--- src/kosmickrisp/vulkan/00-kk-defaults.conf
+++ src/kosmickrisp/vulkan/00-kk-defaults.conf
@@ -0,0 +1,12 @@
+<?xml version="1.0"?>
+<driconf>
+    <device driver="kk">
+        <engine engine_name_match="idTech">
+           <!--
+              IdTech 6+ requires support for the depth bounds test.
+              It only uses it as an optimization and renders correctly without it.
+           -->
+           <option name="kk_fake_depth_bounds" value="true" />
+       </engine>
+    </device>
+</driconf>

--- src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1460,7 +1460,7 @@ kk_flush_dynamic_state(struct kk_cmd_buffer *cmd)
 
    if ((IS_DIRTY(DS_DEPTH_BOUNDS_TEST_ENABLE) ||
         IS_DIRTY(DS_DEPTH_BOUNDS_TEST_BOUNDS)) &&
-       pdev->vk.supported_features.depthBounds) {
+       kk_gpu_supports_depth_bounds(&pdev->info)) {
       /* Metal does not expose a separate flag for enabling the depth bounds
        * test. Instead, it treats [0, 1] as disabled. */
       bool bounds_enable = dyn->ds.depth.bounds_test.enable;

--- src/kosmickrisp/vulkan/kk_drirc_gen.py
+++ src/kosmickrisp/vulkan/kk_drirc_gen.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+# Copyright 2024 Valve Corporation
+# Copyright 2024 Alyssa Rosenzweig
+# SPDX-License-Identifier: MIT
+
+import argparse
+import sys
+
+VALID_COMMON_VK_OPTIONS = {
+    "force_vk_vendor",
+}
+
+def declare_options():
+    import drirc_gen
+
+    B = drirc_gen.DrircBool
+
+    misc_options = [
+        B("kk_fake_depth_bounds", False,
+          "Reports support for depth bounds test even if the hardware does not support it",
+          c_name="fake_depth_bounds"),
+    ]
+    debug_options = []
+    features_options = []
+    performance_options = []
+
+    drirc_gen.add_common_vk_options(debug_options, features_options, misc_options,
+                                    valid_options=VALID_COMMON_VK_OPTIONS)
+    drirc_gen.add_common_vk_wsi_options(debug_options, performance_options)
+
+    return [
+        drirc_gen.DrircSection("Debugging", debug_options, c_name="debug"),
+        drirc_gen.DrircSection("Performance", performance_options, c_name="performance"),
+        drirc_gen.DrircSection("Miscellaneous", misc_options, c_name="misc"),
+    ]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('-p', '--import-path', required=True)
+    parser.add_argument('--drirc-src', required=True)
+    parser.add_argument('--drirc-hdr', required=True)
+    parser.add_argument('--validate', required=True)
+    args = parser.parse_args()
+
+    sys.path.insert(0, args.import_path)
+    import drirc_gen
+
+    options = declare_options()
+
+    drirc_gen.drirc_validate([args.validate], options)
+
+    drirc_gen.drirc_generate(args.drirc_src, args.drirc_hdr, "kk", options)
+
+
+if __name__ == '__main__':
+    main()

