+   /* WSI gets its own queue so waitForDrawable never stalls the app. */
+   simple_mtx_lock(&dev->blit_queue_mutex);
+   if (!dev->has_blit_queue) {
+      const VkDeviceQueueCreateInfo queue_info = {
+         .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+         .queueFamilyIndex = 0,
+         .queueCount = 1,
+      };
+      VkResult result = kk_queue_init(dev, &dev->blit_queue, &queue_info, 0);
+      if (result == VK_SUCCESS)
+         dev->has_blit_queue = true;
+      else
+         mesa_logw("kk: failed to create the WSI queue");
+   }
+   simple_mtx_unlock(&dev->blit_queue_mutex);
+
+   return dev->has_blit_queue ? &dev->blit_queue.vk : &dev->queue.vk;
 }
 
