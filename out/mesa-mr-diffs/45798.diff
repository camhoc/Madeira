--- src/poly/nir/tests/gs_side_effects_test.c
+++ src/poly/nir/tests/gs_side_effects_test.c
@@ -0,0 +1,293 @@
+/* SPDX-License-Identifier: MIT */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include "nir_builder.h"
+#include "poly_nir_gs_side_effects.h"
+
+#define CHECK(expr) do { \
+   if (!(expr)) { \
+      fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #expr); \
+      abort(); \
+   } \
+} while (0)
+
+static const nir_shader_compiler_options options = {0};
+
+static unsigned
+count_op(nir_shader *s, nir_intrinsic_op op)
+{
+   unsigned count = 0;
+   nir_foreach_function_impl(impl, s) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(instr)->intrinsic == op)
+               count++;
+         }
+      }
+   }
+   return count;
+}
+
+static void
+output(nir_builder *b, nir_def *value)
+{
+   nir_store_output(b, value, nir_imm_int(b, 0),
+                    .src_type = nir_type_uint32,
+                    .io_semantics.location = VARYING_SLOT_VAR0,
+                    .io_semantics.num_slots = 1);
+}
+
+static nir_builder
+builder(void)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_GEOMETRY,
+                                                 &options, "side effects");
+   b.shader->info.io_lowered = true;
+   b.shader->info.gs.invocations = 1;
+   b.shader->info.gs.vertices_out = 1;
+   b.shader->info.gs.input_primitive = MESA_PRIM_POINTS;
+   b.shader->info.gs.output_primitive = MESA_PRIM_POINTS;
+   b.shader->info.gs.active_stream_mask = 1;
+   return b;
+}
+
+static void
+check_clone(nir_builder *b, bool expected)
+{
+   nir_validate_shader(b->shader, "before side-effect separation");
+   nir_shader *copy = poly_nir_clone_gs_without_side_effects(b->shader);
+   if ((copy != NULL) != expected) {
+      nir_print_shader(b->shader, stderr);
+      fprintf(stderr, "expected clone: %d\n", expected);
+   }
+   CHECK((copy != NULL) == expected);
+   if (copy) {
+      nir_validate_shader(copy, "after side-effect separation");
+      CHECK(count_op(copy, nir_intrinsic_store_global) == 0);
+      CHECK(count_op(copy, nir_intrinsic_global_atomic) == 0);
+      CHECK(count_op(copy, nir_intrinsic_image_store) == 0);
+      CHECK(count_op(copy, nir_intrinsic_bindless_image_store) == 0);
+      CHECK(count_op(copy, nir_intrinsic_image_atomic) == 0);
+      CHECK(count_op(copy, nir_intrinsic_bindless_image_atomic) == 0);
+   }
+   ralloc_free(copy);
+   ralloc_free(b->shader);
+}
+
+static void
+store_and_atomic(bool atomic, bool used)
+{
+   nir_builder b = builder();
+   nir_def *addr = nir_imm_int64(&b, 4096);
+   nir_def *value = nir_imm_int(&b, 1);
+   if (atomic) {
+      nir_def *result = nir_global_atomic(&b, 32, addr, value,
+                                         .atomic_op = nir_atomic_op_iadd);
+      if (used)
+         value = result;
+   } else {
+      nir_store_global(&b, value, addr, .align_mul = 4);
+   }
+   output(&b, value);
+   nir_shader *copy = poly_nir_clone_gs_without_side_effects(b.shader);
+   CHECK((copy != NULL) == !used);
+   CHECK(count_op(b.shader, atomic ? nir_intrinsic_global_atomic
+                                  : nir_intrinsic_store_global) == 1);
+   ralloc_free(copy);
+   check_clone(&b, !used);
+}
+
+static void
+memory_load(unsigned kind, unsigned access, bool used)
+{
+   nir_builder b = builder();
+   nir_def *addr = nir_imm_int64(&b, 4096);
+   nir_def *value;
+   if (kind == 0) {
+      value = nir_load_global(&b, 1, 32, addr, .align_mul = 4, .access = access);
+   } else if (kind == 1) {
+      value = nir_load_global_bounded(&b, 1, 32, addr, nir_imm_int64(&b, 64),
+                                      nir_imm_int64(&b, 0),
+                                      .align_mul = 4, .access = access);
+   } else {
+      value = nir_load_ssbo(&b, 1, 32, nir_imm_int(&b, 0), nir_imm_int(&b, 0),
+                            .align_mul = 4, .access = access);
+   }
+   nir_store_global(&b, value, addr, .align_mul = 4);
+   output(&b, used ? value : nir_imm_int(&b, 0));
+   check_clone(&b, !used || ((access & ACCESS_CAN_REORDER) &&
+                             !(access & ACCESS_VOLATILE)));
+}
+
+static void
+texture(void)
+{
+   nir_builder b = builder();
+   nir_tex_instr *tex = nir_tex_instr_create(b.shader, 2);
+   tex->op = nir_texop_txf;
+   tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   tex->dest_type = nir_type_uint32;
+   tex->coord_components = 2;
+   tex->src[0].src_type = nir_tex_src_coord;
+   tex->src[0].src = nir_src_for_ssa(nir_imm_ivec2(&b, 0, 0));
+   tex->src[1].src_type = nir_tex_src_lod;
+   tex->src[1].src = nir_src_for_ssa(nir_imm_int(&b, 0));
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(&b, &tex->instr);
+   output(&b, nir_channel(&b, &tex->def, 0));
+   check_clone(&b, false);
+}
+
+static void
+barrier_and_fallback(void)
+{
+   nir_builder b = builder();
+   nir_store_global(&b, nir_imm_int(&b, 1), nir_imm_int64(&b, 4096),
+                     .align_mul = 4);
+   nir_barrier(&b, .memory_scope = SCOPE_DEVICE,
+                .memory_semantics = NIR_MEMORY_ACQ_REL,
+                .memory_modes = nir_var_mem_global);
+   output(&b, nir_imm_int(&b, 0));
+   nir_shader *copy = poly_nir_clone_gs_without_side_effects(b.shader);
+   CHECK(copy != NULL);
+   CHECK(count_op(copy, nir_intrinsic_barrier) == 0);
+   CHECK(count_op(b.shader, nir_intrinsic_barrier) == 1);
+   ralloc_free(copy);
+   poly_nir_strip_gs_side_effects(b.shader, false, false);
+   CHECK(count_op(b.shader, nir_intrinsic_store_global) == 1);
+   CHECK(count_op(b.shader, nir_intrinsic_barrier) == 1);
+   poly_nir_strip_gs_side_effects(b.shader, true, false);
+   CHECK(count_op(b.shader, nir_intrinsic_store_global) == 0);
+   CHECK(count_op(b.shader, nir_intrinsic_barrier) == 1);
+   ralloc_free(b.shader);
+}
+
+static void
+image_effect(bool bindless, unsigned operation)
+{
+   nir_builder b = builder();
+   nir_def *handle = bindless ? nir_imm_int64(&b, 4096) : nir_imm_int(&b, 0);
+   nir_def *coord = nir_imm_ivec4(&b, 0, 0, 0, 0);
+   nir_def *zero = nir_imm_int(&b, 0);
+   nir_def *value = nir_imm_int(&b, 1);
+   if (operation == 0) {
+      if (bindless)
+         nir_bindless_image_store(&b, handle, coord, zero, value, zero,
+                                  .image_dim = GLSL_SAMPLER_DIM_2D,
+                                  .format = PIPE_FORMAT_R32_UINT,
+                                  .src_type = nir_type_uint32);
+      else
+         nir_image_store(&b, handle, coord, zero, value, zero,
+                         .image_dim = GLSL_SAMPLER_DIM_2D,
+                         .format = PIPE_FORMAT_R32_UINT,
+                         .src_type = nir_type_uint32);
+   } else if (operation <= 2) {
+      nir_def *result = bindless
+         ? nir_bindless_image_atomic(&b, 32, handle, coord, zero, value,
+                                      .image_dim = GLSL_SAMPLER_DIM_2D,
+                                      .format = PIPE_FORMAT_R32_UINT,
+                                      .atomic_op = nir_atomic_op_iadd)
+         : nir_image_atomic(&b, 32, handle, coord, zero, value,
+                             .image_dim = GLSL_SAMPLER_DIM_2D,
+                             .format = PIPE_FORMAT_R32_UINT,
+                             .atomic_op = nir_atomic_op_iadd);
+      if (operation == 2)
+         value = result;
+   } else {
+      unsigned access = operation == 4 ? ACCESS_CAN_REORDER : 0;
+      value = bindless
+         ? nir_bindless_image_load(&b, 1, 32, handle, coord, zero, zero,
+                                    .image_dim = GLSL_SAMPLER_DIM_2D,
+                                    .format = PIPE_FORMAT_R32_UINT,
+                                    .dest_type = nir_type_uint32,
+                                    .access = access)
+         : nir_image_load(&b, 1, 32, handle, coord, zero, zero,
+                           .image_dim = GLSL_SAMPLER_DIM_2D,
+                           .format = PIPE_FORMAT_R32_UINT,
+                           .dest_type = nir_type_uint32, .access = access);
+   }
+   output(&b, value);
+   check_clone(&b, operation < 2 || operation == 4);
+}
+
+static void
+atomic_feeds_store_only(void)
+{
+   nir_builder b = builder();
+   nir_def *addr = nir_imm_int64(&b, 4096);
+   nir_def *result = nir_global_atomic(&b, 32, addr, nir_imm_int(&b, 1),
+                                      .atomic_op = nir_atomic_op_iadd);
+   nir_push_if(&b, nir_ieq_imm(&b, result, 0));
+   nir_store_global(&b, result, addr, .align_mul = 4);
+   nir_pop_if(&b, NULL);
+   check_clone(&b, true);
+}
+
+static void
+control_dependency(void)
+{
+   nir_builder b = builder();
+   nir_def *result = nir_global_atomic(&b, 32, nir_imm_int64(&b, 4096),
+                                      nir_imm_int(&b, 1),
+                                      .atomic_op = nir_atomic_op_iadd);
+   nir_push_if(&b, nir_ieq_imm(&b, result, 0));
+   output(&b, nir_imm_int(&b, 1));
+   nir_pop_if(&b, NULL);
+   check_clone(&b, false);
+}
+
+static void
+constant_input(void)
+{
+   nir_builder b = builder();
+   nir_def *value = nir_load_global_constant(&b, 1, 32,
+                                            nir_imm_int64(&b, 4096),
+                                            .align_mul = 4);
+   output(&b, value);
+   check_clone(&b, true);
+}
+
+static void
+unhandled_store(void)
+{
+   nir_builder b = builder();
+   nir_store_ssbo(&b, nir_imm_int(&b, 1), nir_imm_int(&b, 0),
+                  nir_imm_int(&b, 0), .align_mul = 4);
+   check_clone(&b, false);
+}
+
+int
+main(void)
+{
+   glsl_type_singleton_init_or_ref();
+   store_and_atomic(false, false);
+   store_and_atomic(true, false);
+   store_and_atomic(true, true);
+   for (unsigned kind = 0; kind < 3; kind++) {
+      memory_load(kind, 0, false);
+      memory_load(kind, 0, true);
+      memory_load(kind, ACCESS_CAN_REORDER, true);
+      memory_load(kind, ACCESS_VOLATILE, true);
+      memory_load(kind, ACCESS_VOLATILE, false);
+   }
+   for (unsigned bindless = 0; bindless < 2; bindless++)
+      for (unsigned op = 0; op < 5; op++)
+         image_effect(bindless, op);
+   atomic_feeds_store_only();
+   control_dependency();
+   constant_input();
+   unhandled_store();
+   texture();
+   barrier_and_fallback();
+   nir_builder b = builder();
+   output(&b, nir_read_first_invocation(&b, nir_load_primitive_id(&b)));
+   check_clone(&b, false);
+   b = builder();
+   output(&b, nir_channel(&b, nir_shader_clock(&b, .memory_scope = SCOPE_DEVICE), 0));
+   check_clone(&b, false);
+   glsl_type_singleton_decref();
+   puts("36 geometry side-effect cases passed");
+   return 0;
+}

