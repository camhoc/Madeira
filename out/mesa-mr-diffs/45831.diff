+bool
+kk_nir_lower_vbo_prolog(nir_shader *nir, uint32_t int_slots,
+                        uint32_t uint_slots)
+{
+   assert(nir->info.stage == MESA_SHADER_VERTEX);
+
+   struct prolog_ctx ctx = {int_slots, uint_slots};
+   return nir_shader_intrinsics_pass(nir, pass_prolog, nir_metadata_none, &ctx);
+}

