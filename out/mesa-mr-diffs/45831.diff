+
+#ifndef KK_VI_PROLOG_H
+#define KK_VI_PROLOG_H 1
+
+#include "kk_nir_lower_vbo.h"
+#include "kk_private.h"
+
+#include "kosmickrisp/bridge/mtl_types.h"
+
+struct kk_device;
+struct kk_shader;
+struct kk_shader_info;
+struct vk_vertex_input_state;
+
+/* Vertex input layout as seen by one vertex shader, indexed by attribute slot
+ * (compacted attribs_read index). */
+struct kk_vi_prolog_key {
+   /* kk_vbo_encode_format() | KK_VBO_FMT_INSTANCED, 0 if not bound */
+   uint32_t format[KK_MAX_ATTRIBS];
+   uint32_t divisor[KK_MAX_ATTRIBS];
+};
+
+void kk_vi_prolog_key_init(struct kk_vi_prolog_key *key,
+                           const struct kk_shader_info *info,
+                           const struct vk_vertex_input_state *vi);
+
+/* MSL source of the prolog functions for every slot the shader reads. With a
+ * NULL key, the functions read the layout from the root table instead. A
+ * linked source is a library of its own; otherwise it is meant to be placed
+ * in the vertex shader's source. */
+char *kk_vi_prolog_source(void *mem_ctx, const struct kk_shader_info *info,
+                          const struct kk_vi_prolog_key *key, bool linked);
+
+/* Keeps a copy of descriptor, which has the vertex and fragment functions and
+ * every other pipeline state set. */
+VkResult kk_vi_prologs_create(struct kk_device *dev, struct kk_shader *vs,
+                              mtl_render_pipeline_descriptor *descriptor);
+void kk_vi_prologs_destroy(struct kk_shader *vs);
+
+/* Render pipeline for vs with key's layout. The first use of a layout starts
+ * compiling its pipeline in the background and returns the generic one, with
+ * *pending set until the layout's own pipeline is ready. */
+mtl_render_pipeline_state *
+kk_vi_prolog_pipeline(struct kk_device *dev, struct kk_shader *vs,
+                      const struct kk_vi_prolog_key *key, bool *pending);
+
+#endif /* KK_VI_PROLOG_H */

