@@ -0,0 +1,420 @@
+/*
+ * Copyright 2026 Nilton Perim Neto
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Vertex input prologs for VK_EXT_vertex_input_dynamic_state.
+ *
+ * A vertex shader compiled without a static vertex input layout calls one
+ * extern function per attribute slot, kk_vi_<slot>(). Once the layout is
+ * known at draw time, the functions are generated with the format, input rate
+ * and divisor as constants, compiled as a small library and statically linked
+ * into a render pipeline with the shader's vertex and fragment functions. The
+ * Metal compiler can then fold the format decode like the static path does.
+ * Pipelines are cached per shader and layout.
+ *
+ * A vertex shader emulated as compute before tessellation or geometry is
+ * compiled up front, so its own source defines kk_vi_<slot>() reading the
+ * format, input rate and divisor from the root table instead.
+ */
+
+#include "kk_vi_prolog.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_debug.h"
+#include "kk_device.h"
+#include "kk_physical_device.h"
+#include "kk_shader.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include "util/hash_table.h"
+#include "util/ralloc.h"
+#include "util/simple_mtx.h"
+#include "util/string_buffer.h"
+#include "util/u_atomic.h"
+#include "util/u_math.h"
+#include "vk_format.h"
+#include "vk_graphics_state.h"
+
+/* A render pipeline for one layout, compiled on the device's vi_prolog
+ * queue. */
+struct kk_vi_prolog_variant {
+   struct kk_vi_prolog_key key;
+   struct kk_device *dev;
+   struct kk_shader *vs;
+   /* Signalled when the compile job finished, for destruction */
+   struct util_queue_fence ready;
+   /* Set with release semantics once pipeline is final; pipeline is NULL if
+    * the compile failed */
+   bool done;
+   mtl_render_pipeline_state *pipeline;
+};
+
+struct kk_vi_prologs {
+   simple_mtx_t lock;
+   /* struct kk_vi_prolog_key -> struct kk_vi_prolog_variant */
+   struct hash_table *variants;
+   mtl_render_pipeline_descriptor *descriptor;
+   /* Linked with prologs that read the layout from the root table. Used
+    * while a layout's own pipeline is compiling. */
+   mtl_render_pipeline_state *generic;
+};
+
+void
+kk_vi_prolog_key_init(struct kk_vi_prolog_key *key,
+                      const struct kk_shader_info *info,
+                      const struct vk_vertex_input_state *vi)
+{
+   memset(key, 0, sizeof(*key));
+
+   unsigned slot = 0;
+   u_foreach_bit(i, info->vs.attribs_read) {
+      if (vi->attributes_valid & BITFIELD_BIT(i)) {
+         const struct vk_vertex_attribute_state *attr = &vi->attributes[i];
+         const struct vk_vertex_binding_state *binding =
+            &vi->bindings[attr->binding];
+         uint32_t fmt =
+            kk_vbo_encode_format(vk_format_to_pipe_format(attr->format));
+         if (binding->input_rate == VK_VERTEX_INPUT_RATE_INSTANCE) {
+            fmt |= KK_VBO_FMT_INSTANCED;
+            key->divisor[slot] = binding->divisor;
+         }
+         key->format[slot] = fmt;
+      }
+      slot++;
+   }
+}
+
+static uint32_t
+key_hash(const void *key)
+{
+   return _mesa_hash_data(key, sizeof(struct kk_vi_prolog_key));
+}
+
+static bool
+key_equal(const void *a, const void *b)
+{
+   return memcmp(a, b, sizeof(struct kk_vi_prolog_key)) == 0;
+}
+
+/* Format decode shared by all slots. fmt is a literal in specialized prologs,
+ * so after inlining every branch on it folds away. */
+static void
+print_decode_helpers(struct _mesa_string_buffer *buf)
+{
+#define DEFINE(name)                                                           \
+   _mesa_string_buffer_printf(buf, "#define " #name " %uu\n", name)
+   DEFINE(KK_VBO_FMT_VALID);
+   DEFINE(KK_VBO_FMT_INSTANCED);
+   DEFINE(KK_VBO_FMT_RGB10A2);
+   DEFINE(KK_VBO_FMT_RG11B10F);
+   DEFINE(KK_VBO_FMT_SIZE_SHIFT);
+   DEFINE(KK_VBO_FMT_SIZE_MASK);
+   DEFINE(KK_VBO_FMT_COUNT_SHIFT);
+   DEFINE(KK_VBO_FMT_COUNT_MASK);
+   DEFINE(KK_VBO_FMT_TYPE_SHIFT);
+   DEFINE(KK_VBO_FMT_TYPE_MASK);
+   DEFINE(KK_VBO_FMT_SWIZZLE_SHIFT);
+   DEFINE(KK_VBO_FMT_SWIZZLE_MASK);
+   DEFINE(KK_VBO_TYPE_UNORM);
+   DEFINE(KK_VBO_TYPE_SNORM);
+   DEFINE(KK_VBO_TYPE_USCALED);
+   DEFINE(KK_VBO_TYPE_SSCALED);
+   DEFINE(KK_VBO_TYPE_SINT);
+#undef DEFINE
+
+   _mesa_string_buffer_append(
+      buf,
+      "static inline uint4 kk_vi_raw(ulong addr, uint fmt, bool fetch) {\n"
+      "   uint4 v = uint4(0);\n"
+      "   if (!fetch) return v;\n"
+      "   uint n = ((fmt >> KK_VBO_FMT_COUNT_SHIFT) & KK_VBO_FMT_COUNT_MASK) + 1;\n"
+      "   uint size = (fmt >> KK_VBO_FMT_SIZE_SHIFT) & KK_VBO_FMT_SIZE_MASK;\n"
+      "   if (size == 2) {\n"
+      "      constant uint *p = (constant uint *)addr;\n"
+      "      v.x = p[0]; if (n > 1) v.y = p[1]; if (n > 2) v.z = p[2]; if (n > 3) v.w = p[3];\n"
+      "   } else if (size == 1) {\n"
+      "      constant ushort *p = (constant ushort *)addr;\n"
+      "      v.x = p[0]; if (n > 1) v.y = p[1]; if (n > 2) v.z = p[2]; if (n > 3) v.w = p[3];\n"
+      "   } else {\n"
+      "      constant uchar *p = (constant uchar *)addr;\n"
+      "      v.x = p[0]; if (n > 1) v.y = p[1]; if (n > 2) v.z = p[2]; if (n > 3) v.w = p[3];\n"
+      "   }\n"
+      "   return v;\n"
+      "}\n"
+      "static inline uint4 kk_vi_unpack(uint4 v, uint fmt) {\n"
+      "   if (fmt & KK_VBO_FMT_RGB10A2)\n"
+      "      return (uint4(v.x) >> uint4(0, 10, 20, 30)) & uint4(1023, 1023, 1023, 3);\n"
+      "   return v;\n"
+      "}\n"
+      "static inline int4 kk_vi_signed(uint4 v, uint fmt) {\n"
+      "   if (fmt & KK_VBO_FMT_RGB10A2)\n"
+      "      return as_type<int4>(v << uint4(22, 22, 22, 30)) >> uint4(22, 22, 22, 30);\n"
+      "   uint size = (fmt >> KK_VBO_FMT_SIZE_SHIFT) & KK_VBO_FMT_SIZE_MASK;\n"
+      "   if (size == 0) return int4(as_type<char4>(uchar4(v)));\n"
+      "   if (size == 1) return int4(as_type<short4>(ushort4(v)));\n"
+      "   return as_type<int4>(v);\n"
+      "}\n"
+      "static inline float4 kk_vi_float(uint4 raw, uint fmt) {\n"
+      "   uint4 u = kk_vi_unpack(raw, fmt);\n"
+      "   uint type = (fmt >> KK_VBO_FMT_TYPE_SHIFT) & KK_VBO_FMT_TYPE_MASK;\n"
+      "   bool packed = (fmt & KK_VBO_FMT_RGB10A2) != 0;\n"
+      "   bool is8 = ((fmt >> KK_VBO_FMT_SIZE_SHIFT) & KK_VBO_FMT_SIZE_MASK) == 0;\n"
+      "   switch (type) {\n"
+      "   case KK_VBO_TYPE_UNORM:\n"
+      "      return float4(u) * (packed ? float4(1.0f/1023.0f, 1.0f/1023.0f, 1.0f/1023.0f, 1.0f/3.0f) : is8 ? float4(1.0f/255.0f) : float4(1.0f/65535.0f));\n"
+      "   case KK_VBO_TYPE_SNORM:\n"
+      "      return max(float4(kk_vi_signed(u, fmt)) * (packed ? float4(1.0f/511.0f, 1.0f/511.0f, 1.0f/511.0f, 1.0f) : is8 ? float4(1.0f/127.0f) : float4(1.0f/32767.0f)), -1.0f);\n"
+      "   case KK_VBO_TYPE_USCALED: return float4(u);\n"
+      "   case KK_VBO_TYPE_SSCALED: return float4(kk_vi_signed(u, fmt));\n"
+      "   default:\n"
+      "      if (fmt & KK_VBO_FMT_RG11B10F)\n"
+      "         return float4(float3(as_type<half3>(ushort3((raw.x & 0x7ffu) << 4, (raw.x & 0x3ff800u) >> 7, (raw.x & 0xffc00000u) >> 17))), 0.0f);\n"
+      "      if (((fmt >> KK_VBO_FMT_SIZE_SHIFT) & KK_VBO_FMT_SIZE_MASK) == 1)\n"
+      "         return float4(as_type<half4>(ushort4(raw)));\n"
+      "      return as_type<float4>(raw);\n"
+      "   }\n"
+      "}\n");
+}
+
+static void
+print_prolog(struct _mesa_string_buffer *buf, unsigned slot, nir_alu_type type,
+             bool robust2, bool linked, const struct kk_vi_prolog_key *key)
+{
+   const char *t = msl_vi_prolog_type(type);
+   _mesa_string_buffer_printf(buf,
+                              "%s %s " MSL_VI_PROLOG_NAME
+                              "(ulong root, uint vid, uint iid, uint bi) {\n",
+                              linked ? "[[visible]]" : "static inline", t,
+                              slot);
+
+   if (key) {
+      if (!(key->format[slot] & KK_VBO_FMT_VALID)) {
+         _mesa_string_buffer_printf(buf, "   return %s(0, 0, 0, 1);\n}\n", t);
+         return;
+      }
+      _mesa_string_buffer_printf(buf,
+                                 "   const uint fmt = %uu;\n"
+                                 "   const uint divisor = %uu;\n",
+                                 key->format[slot], key->divisor[slot]);
+   } else {
+      _mesa_string_buffer_printf(
+         buf,
+         "   const uint fmt = *(constant uint *)(root + %zu);\n"
+         "   const uint divisor = *(constant uint *)(root + %zu);\n"
+         "   if (!(fmt & KK_VBO_FMT_VALID)) return %s(0, 0, 0, 1);\n",
+         offsetof(struct kk_root_descriptor_table, draw.attrib_format[slot]),
+         offsetof(struct kk_root_descriptor_table, draw.attrib_divisor[slot]),
+         t);
+   }
+
+   _mesa_string_buffer_printf(
+      buf,
+      "   uint el = (fmt & KK_VBO_FMT_INSTANCED) ?\n"
+      "      (divisor == 0u ? 0u : iid / divisor) + bi : vid;\n"
+      "   ulong base = *(constant ulong *)(root + %zu);\n"
+      "   uint stride = *(constant uint *)(root + %zu);\n",
+      offsetof(struct kk_root_descriptor_table, draw.attrib_base[slot]),
+      offsetof(struct kk_root_descriptor_table, draw.attrib_stride[slot]));
+   if (robust2) {
+      _mesa_string_buffer_printf(
+         buf, "   bool fetch = el <= *(constant uint *)(root + %zu);\n",
+         offsetof(struct kk_root_descriptor_table, draw.attrib_clamps[slot]));
+   } else {
+      _mesa_string_buffer_append(buf, "   bool fetch = true;\n");
+   }
+   _mesa_string_buffer_append(
+      buf,
+      "   uint4 raw = kk_vi_raw(base + ulong(el * stride), fmt, fetch);\n");
+
+   if (type == nir_type_float32) {
+      _mesa_string_buffer_append(buf, "   float4 v = kk_vi_float(raw, fmt);\n");
+   } else {
+      _mesa_string_buffer_printf(
+         buf,
+         "   uint4 u = kk_vi_unpack(raw, fmt);\n"
+         "   %s v = %s(((fmt >> KK_VBO_FMT_TYPE_SHIFT) & KK_VBO_FMT_TYPE_MASK) == "
+         "KK_VBO_TYPE_SINT ? as_type<uint4>(kk_vi_signed(u, fmt)) : u);\n",
+         t, t);
+   }
+   _mesa_string_buffer_printf(
+      buf,
+      "   uint4 swz = (uint4(fmt) >> uint4(KK_VBO_FMT_SWIZZLE_SHIFT, "
+      "KK_VBO_FMT_SWIZZLE_SHIFT + 3, KK_VBO_FMT_SWIZZLE_SHIFT + 6, "
+      "KK_VBO_FMT_SWIZZLE_SHIFT + 9)) & uint4(KK_VBO_FMT_SWIZZLE_MASK);\n"
+      "   %s out = %s(v.x);\n"
+      "   out = select(out, %s(v.y), swz == uint4(1));\n"
+      "   out = select(out, %s(v.z), swz == uint4(2));\n"
+      "   out = select(out, %s(v.w), swz == uint4(3));\n"
+      "   out = select(out, %s(0), swz == uint4(4));\n"
+      "   return select(out, %s(1), swz == uint4(5));\n"
+      "}\n",
+      t, t, t, t, t, t, t);
+}
+
+char *
+kk_vi_prolog_source(void *mem_ctx, const struct kk_shader_info *info,
+                    const struct kk_vi_prolog_key *key, bool linked)
+{
+   struct _mesa_string_buffer *buf = _mesa_string_buffer_create(NULL, 8192);
+   if (linked)
+      _mesa_string_buffer_append(buf, "#include <metal_stdlib>\n"
+                                      "using namespace metal;\n");
+   print_decode_helpers(buf);
+
+   unsigned slots = util_bitcount(info->vs.attribs_read);
+   for (unsigned slot = 0; slot < slots; slot++) {
+      nir_alu_type type = nir_type_float32;
+      if (info->vs.vi_int_slots & BITFIELD_BIT(slot))
+         type = nir_type_int32;
+      else if (info->vs.vi_uint_slots & BITFIELD_BIT(slot))
+         type = nir_type_uint32;
+      print_prolog(buf, slot, type, info->vs.vi_robust2, linked, key);
+   }
+
+   char *source = ralloc_strdup(mem_ctx, buf->buf);
+   _mesa_string_buffer_destroy(buf);
+   return source;
+}
+
+static mtl_render_pipeline_state *
+compile_pipeline(struct kk_device *dev, struct kk_shader *vs,
+                 mtl_render_pipeline_descriptor *base,
+                 const struct kk_vi_prolog_key *key)
+{
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+   const struct kk_shader_info *info = &vs->info;
+   unsigned slots = util_bitcount(info->vs.attribs_read);
+
+   char *source = kk_vi_prolog_source(NULL, info, key, true);
+   if (KK_DEBUG(MSL))
+      mesa_logi("%s\n", source);
+   mtl_library *library = mtl_new_library(
+      dev->mtl_compiler_handle, source, pdev->info.msl_version,
+      MTL_MATH_MODE_FAST, MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST);
+   ralloc_free(source);
+   if (!library)
+      return NULL;
+
+   mtl_function_descriptor *functions[KK_MAX_ATTRIBS];
+   for (unsigned slot = 0; slot < slots; slot++) {
+      char name[16];
+      snprintf(name, sizeof(name), MSL_VI_PROLOG_NAME, slot);
+      functions[slot] = mtl_new_library_function_descriptor(library, name);
+   }
+
+   mtl_render_pipeline_descriptor *descriptor =
+      mtl_render_pipeline_descriptor_copy(base);
+   mtl_render_pipeline_descriptor_set_vertex_linked_functions(descriptor,
+                                                              functions, slots);
+   mtl_render_pipeline_state *pipeline =
+      mtl_new_render_pipeline(dev->mtl_compiler_handle, descriptor);
+
+   mtl_release(descriptor);
+   for (unsigned slot = 0; slot < slots; slot++)
+      mtl_release(functions[slot]);
+   mtl_release(library);
+   return pipeline;
+}
+
+VkResult
+kk_vi_prologs_create(struct kk_device *dev, struct kk_shader *vs,
+                     mtl_render_pipeline_descriptor *descriptor)
+{
+   assert(vs->info.vs.attribs_read);
+
+   struct kk_vi_prologs *p = rzalloc(NULL, struct kk_vi_prologs);
+   if (!p)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   p->variants = _mesa_hash_table_create(p, key_hash, key_equal);
+   if (!p->variants) {
+      ralloc_free(p);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   /* The pipeline that works for every layout is compiled with the shader,
+    * so draws never wait for a compile. */
+   p->generic = compile_pipeline(dev, vs, descriptor, NULL);
+   if (!p->generic) {
+      ralloc_free(p);
+      return VK_ERROR_INVALID_SHADER_NV;
+   }
+
+   simple_mtx_init(&p->lock, mtx_plain);
+   p->descriptor = mtl_render_pipeline_descriptor_copy(descriptor);
+   vs->vi_prologs = p;
+   return VK_SUCCESS;
+}
+
+void
+kk_vi_prologs_destroy(struct kk_shader *vs)
+{
+   struct kk_vi_prologs *p = vs->vi_prologs;
+   if (!p)
+      return;
+
+   hash_table_foreach(p->variants, entry) {
+      struct kk_vi_prolog_variant *variant = entry->data;
+      util_queue_fence_wait(&variant->ready);
+      util_queue_fence_destroy(&variant->ready);
+      mtl_release(variant->pipeline);
+   }
+   mtl_release(p->generic);
+   mtl_release(p->descriptor);
+   simple_mtx_destroy(&p->lock);
+   ralloc_free(p);
+   vs->vi_prologs = NULL;
+}
+
+static void
+compile_variant(void *job, void *gdata, int thread_index)
+{
+   struct kk_vi_prolog_variant *variant = job;
+   variant->pipeline =
+      compile_pipeline(variant->dev, variant->vs,
+                       variant->vs->vi_prologs->descriptor, &variant->key);
+   p_atomic_set(&variant->done, true);
+}
+
+mtl_render_pipeline_state *
+kk_vi_prolog_pipeline(struct kk_device *dev, struct kk_shader *vs,
+                      const struct kk_vi_prolog_key *key, bool *pending)
+{
+   struct kk_vi_prologs *p = vs->vi_prologs;
+   uint32_t hash = key_hash(key);
+
+   *pending = false;
+   if (KK_DEBUG(VI_PROLOG_GENERIC))
+      return p->generic;
+
+   simple_mtx_lock(&p->lock);
+   struct hash_entry *entry =
+      _mesa_hash_table_search_pre_hashed(p->variants, hash, key);
+   struct kk_vi_prolog_variant *variant = entry ? entry->data : NULL;
+   if (!variant) {
+      variant = rzalloc(p, struct kk_vi_prolog_variant);
+      if (variant) {
+         variant->key = *key;
+         variant->dev = dev;
+         variant->vs = vs;
+         util_queue_fence_init(&variant->ready);
+         _mesa_hash_table_insert_pre_hashed(p->variants, hash, &variant->key,
+                                            variant);
+         util_queue_add_job(&dev->vi_prolog_queue, variant, &variant->ready,
+                            compile_variant, NULL, 0);
+      }
+   }
+   simple_mtx_unlock(&p->lock);
+
+   if (variant && KK_DEBUG(VI_PROLOG_SYNC))
+      util_queue_fence_wait(&variant->ready);
+
+   if (variant && p_atomic_read(&variant->done))
+      return variant->pipeline ? variant->pipeline : p->generic;
+
+   *pending = variant != NULL;
+   return p->generic;
+}

