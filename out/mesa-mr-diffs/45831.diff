+const char *
+msl_vi_prolog_type(nir_alu_type type)
+{
+   switch (nir_alu_type_get_base_type(type)) {
+   case nir_type_int:
+      return "int4";
+   case nir_type_uint:
+      return "uint4";
+   default:
+      return "float4";
+   }
+}
+
+/* Declare the vertex input prolog functions this shader calls. Their
+ * definitions are linked into the render pipeline. */
+static void
+emit_vi_prolog_decls(struct nir_to_msl_ctx *ctx, nir_function_impl *impl)
+{
+   uint64_t declared = 0;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_load_vi_prolog_kk)
+            continue;
+         unsigned slot = nir_intrinsic_base(intr);
+         if (declared & BITFIELD64_BIT(slot))
+            continue;
+         declared |= BITFIELD64_BIT(slot);
+         P(ctx,
+           "[[visible]] extern %s " MSL_VI_PROLOG_NAME
+           "(ulong, uint, uint, uint);\n",
+           msl_vi_prolog_type(nir_intrinsic_dest_type(intr)), slot);
+      }
+   }
+}
+
