+| 2026-11-05: Workaround applied to multiplications that have a constant (macOS 27.2)
 
 KK_WORKAROUND_13
 ----------------

--- src/kosmickrisp/compiler/nir_to_msl.c
+++ src/kosmickrisp/compiler/nir_to_msl.c
@@ -272,6 +272,17 @@ alu_fcmp_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr,
    ALU_BINOP(op);
 }
 
+/* KK_WORKAROUND_14 */
+static bool
+alu_has_const_src(nir_alu_instr *instr)
+{
+   for (unsigned i = 0; i < nir_op_infos[instr->op].num_inputs; i++) {
+      if (nir_src_is_const(instr->src[i].src))
+         return true;
+   }
+   return false;
+}
+
 static void
 alu_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr)
 {
@@ -298,7 +309,8 @@ alu_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr)
    case nir_op_fmul:
       if (!(ctx->disabled_workarounds & BITFIELD64_BIT(14)) &&
           (nir_alu_instr_is_inf_preserve(instr) ||
-           nir_alu_instr_is_nan_preserve(instr)))
+           nir_alu_instr_is_nan_preserve(instr)) &&
+          alu_has_const_src(instr))
          P(ctx, "!&buf0.contents[0] ? 1 : ")
       ALU_BINOP("*");
       break;
@@ -477,7 +489,8 @@ alu_to_msl(struct nir_to_msl_ctx *ctx, nir_alu_instr *instr)
          P(ctx, ") * (");
          if (!(ctx->disabled_workarounds & BITFIELD64_BIT(14)) &&
              (nir_alu_instr_is_inf_preserve(instr) ||
-              nir_alu_instr_is_nan_preserve(instr)))
+              nir_alu_instr_is_nan_preserve(instr)) &&
+             alu_has_const_src(instr))
             P(ctx, "!&buf0.contents[0] ? 1 : ")
          alu_src_to_msl(ctx, instr, 2);
          P(ctx, ")");

