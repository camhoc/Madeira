# asahi: fix bg/eot shader cache races
# https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46059 state=opened
# ### What does this MR do and why?

Protect lookups, allocation and upload to the shader cache with the cache lock.  

Closes: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16812
--- src/asahi/lib/agx_bg_eot.c
+++ src/asahi/lib/agx_bg_eot.c
@@ -34,7 +34,8 @@ lower_tex_handle_to_u0(nir_builder *b, nir_intrinsic_instr *intr, void *data)
 static struct agx_bg_eot_shader *
 agx_compile_bg_eot_shader(struct agx_bg_eot_cache *cache, nir_shader *shader,
                           struct agx_shader_key *key,
-                          struct agx_tilebuffer_layout *tib)
+                          struct agx_tilebuffer_layout *tib,
+                          struct agx_bg_eot_key *bg_eot_key)
 {
    agx_nir_lower_texture(shader);
    agx_preprocess_nir(shader);
@@ -49,13 +50,23 @@ agx_compile_bg_eot_shader(struct agx_bg_eot_cache *cache, nir_shader *shader,
                nir_metadata_control_flow, NULL);
    }
 
-   struct agx_bg_eot_shader *res = rzalloc(cache->ht, struct agx_bg_eot_shader);
    struct agx_shader_part bin;
    agx_compile_shader_nir(shader, key, &bin);
 
-   res->info = bin.info;
-   res->ptr = agx_pool_upload_aligned_with_bo(
-      &cache->pool, bin.binary, bin.info.binary_size, 128, &res->bo);
+   simple_mtx_lock(&cache->lock);
+   /* Another thread may have cached the shader while we compiled. */
+   struct hash_entry *ent = _mesa_hash_table_search(cache->ht, bg_eot_key);
+   struct agx_bg_eot_shader *res = ent ? ent->data : NULL;
+   if (!res) {
+      res = rzalloc(cache->ht, struct agx_bg_eot_shader);
+      res->key = *bg_eot_key;
+      res->info = bin.info;
+      res->ptr = agx_pool_upload_aligned_with_bo(
+         &cache->pool, bin.binary, bin.info.binary_size, 128, &res->bo);
+      _mesa_hash_table_insert(cache->ht, &res->key, res);
+   }
+   simple_mtx_unlock(&cache->lock);
+
    free(bin.binary);
    ralloc_free(shader);
 
@@ -136,7 +147,8 @@ agx_build_background_shader(struct agx_bg_eot_cache *cache,
       b.shader->info.outputs_written |= BITFIELD64_BIT(FRAG_RESULT_DATA0 + rt);
    }
 
-   return agx_compile_bg_eot_shader(cache, b.shader, &compiler_key, &key->tib);
+   return agx_compile_bg_eot_shader(cache, b.shader, &compiler_key, &key->tib,
+                                    key);
 }
 
 static struct agx_bg_eot_shader *
@@ -177,18 +189,19 @@ agx_build_end_of_tile_shader(struct agx_bg_eot_cache *cache,
       .reserved_preamble = key->reserved_preamble,
    };
 
-   return agx_compile_bg_eot_shader(cache, b.shader, &compiler_key, NULL);
+   return agx_compile_bg_eot_shader(cache, b.shader, &compiler_key, NULL, key);
 }
 
 struct agx_bg_eot_shader *
 agx_get_bg_eot_shader(struct agx_bg_eot_cache *cache,
                       struct agx_bg_eot_key *key)
 {
+   simple_mtx_lock(&cache->lock);
    struct hash_entry *ent = _mesa_hash_table_search(cache->ht, key);
-   if (ent)
-      return ent->data;
-
-   struct agx_bg_eot_shader *ret = NULL;
+   struct agx_bg_eot_shader *ret = ent ? ent->data : NULL;
+   simple_mtx_unlock(&cache->lock);
+   if (ret)
+      return ret;
 
    for (unsigned rt = 0; rt < ARRAY_SIZE(key->op); ++rt) {
       if (key->op[rt] == AGX_EOT_STORE) {
@@ -200,8 +213,6 @@ agx_get_bg_eot_shader(struct agx_bg_eot_cache *cache,
    if (!ret)
       ret = agx_build_background_shader(cache, key);
 
-   ret->key = *key;
-   _mesa_hash_table_insert(cache->ht, &ret->key, ret);
    return ret;
 }
 

