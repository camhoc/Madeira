+static VkResult
+build_icb_generator(struct kk_device *dev)
+{
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+
+   dev->icb.enabled = false;
+   if (KK_DEBUG(NO_ICB))
+      return VK_SUCCESS;
+
+   /* Without the generator, draws take the existing indirect-count path */
+   mtl_library *library = mtl_new_library(
+      dev->mtl_compiler_handle, kk_icb_gen_msl, pdev->info.msl_version,
+      MTL_MATH_MODE_SAFE, MTL_MATH_FLOATING_POINT_FUNCTIONS_PRECISE);
+   if (library == NULL)
+      return VK_SUCCESS;
+
+   mtl_function_descriptor *fn_main =
+      mtl_new_library_function_descriptor(library, "kk_icb_gen_vs");
+   mtl_render_pipeline_descriptor *pdesc =
+      mtl_new_render_pipeline_descriptor();
+   mtl_render_pipeline_descriptor_set_vertex_shader(pdesc, fn_main);
+   mtl_render_pipeline_descriptor_set_rasterization_enabled(pdesc, false);
+   dev->icb.gen_vs = mtl_new_render_pipeline(dev->mtl_compiler_handle, pdesc);
+   mtl_release(pdesc);
+   mtl_release(fn_main);
+   mtl_release(library);
+
+   dev->icb.enabled = dev->icb.gen_vs != NULL;
+   return VK_SUCCESS;
+}
