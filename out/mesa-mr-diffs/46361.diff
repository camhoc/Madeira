+/* Returns an indirect command buffer of at least max_count commands from the
+ * command pool, or NULL if max_count is too large.  It goes back to the pool
+ * when the command buffer is reset or destroyed. */
+mtl_indirect_command_buffer *
+kk_cmd_get_icb(struct kk_cmd_buffer *cmd, uint32_t max_count)
+{
+   uint32_t log2 = MAX2(util_logbase2_ceil(max_count), KK_ICB_MIN_LOG2);
+   uint32_t cls = log2 - KK_ICB_MIN_LOG2;
+   if (cls >= KK_ICB_CLASSES)
+      return NULL;
+
+   mtl_indirect_command_buffer *icb =
+      kk_cmd_pool_get_icb(kk_cmd_buffer_pool(cmd), cls);
+   if (icb) {
+      struct kk_cmd_icb entry = {.icb = icb, .cls = cls};
+      util_dynarray_append(&cmd->icbs, entry);
+   }
+   return icb;
+}
