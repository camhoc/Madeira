@@ -0,0 +1,49 @@
+/*
+ * Copyright 2026 Sercan Firat, Nivogli
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl_icb.h"
+
+#include <Metal/MTLIndirectCommandBuffer.h>
+#include <Metal/MTL4RenderCommandEncoder.h>
+
+mtl_indirect_command_buffer *
+mtl_new_icb(mtl_device *device, uint32_t max_count)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLIndirectCommandBufferDescriptor *desc =
+         [[MTLIndirectCommandBufferDescriptor new] autorelease];
+      desc.commandTypes =
+         MTLIndirectCommandTypeDraw | MTLIndirectCommandTypeDrawIndexed;
+      desc.inheritPipelineState = YES;
+      desc.inheritBuffers = NO;
+      desc.maxVertexBufferBindCount = 3;
+      desc.maxFragmentBufferBindCount = 3;
+      return [dev newIndirectCommandBufferWithDescriptor:desc
+                                         maxCommandCount:max_count
+                                                 options:MTLResourceStorageModePrivate];
+   }
+}
+
+uint64_t
+mtl_icb_resource_id(mtl_indirect_command_buffer *icb)
+{
+   @autoreleasepool {
+      id<MTLIndirectCommandBuffer> i = (id<MTLIndirectCommandBuffer>)icb;
+      return i.gpuResourceID._impl;
+   }
+}
+
+void
+mtl_render_execute_icb_indirect(mtl_render_encoder *encoder,
+                                mtl_indirect_command_buffer *icb,
+                                uint64_t range_addr)
+{
+   @autoreleasepool {
+      id<MTL4RenderCommandEncoder> enc = (id<MTL4RenderCommandEncoder>)encoder;
+      [enc executeCommandsInBuffer:(id<MTLIndirectCommandBuffer>)icb
+                    indirectBuffer:range_addr];
+   }
+}

