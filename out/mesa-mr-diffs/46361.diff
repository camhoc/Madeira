+/* Whether an indirect-count draw can run from an indirect command buffer */
+static bool
+kk_draw_can_use_icb(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   /* The ICB is executed from the primary command buffer's render encoder */
+   if (!dev->icb.enabled || cmd->vk.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY)
+      return false;
+
+   /* The generator evaluates the draw count and conditional rendering only */
+   if ((data->predicate_count != 1 && data->predicate_count != 2) ||
+       data->predicate_op[0] != KK_PREDICATE_GT_DRAW_ID)
+      return false;
+
+   /* Tessellation and geometry shaders run as compute passes */
+   if (cmd->state.shaders[MESA_SHADER_TESS_EVAL] ||
+       cmd->state.shaders[MESA_SHADER_GEOMETRY])
+      return false;
+
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   if (!vs || vs->pipeline.gfx.icb_support != KK_ICB_SUPPORTED)
+      return false;
+
+   /* An ICB draw takes the index buffer as a pointer without a length, so
+    * nothing bounds its index reads.  Reading past the index buffer is only
+    * valid with robustBufferAccess2
+    * (VUID-VkDrawIndexedIndirectCommand-robustBufferAccess2-08798).  Also keep
+    * the existing path for pipelines that ask for that behavior for their
+    * vertex inputs. */
+   if (data->indexed && (dev->vk.enabled_features.robustBufferAccess2 ||
+                         vs->info.vs.robust2_vertex_inputs))
+      return false;
+
+   if (requires_unroll(cmd, data) || mesa_prim_has_adjacency(data->prim))
+      return false;
+
+   if (data->indexed) {
+      if (data->index_buffer_el_size_B != 2 &&
+          data->index_buffer_el_size_B != 4)
+         return false;
+
+      /* A null index buffer has no address to give the ICB */
+      if (data->index_buffer.addr == 0u || data->index_buffer.range == 0u)
+         return false;
+   }
+
+   return true;
+}
+
+/* Indirect-count draw without CPU work per draw and without ending the
+ * render encoder.  A rasterizer-disabled vertex shader (dev->icb.gen_vs)
+ * runs in the render encoder, encodes the first min(count, draw_count) draws
+ * into an ICB and writes its execution range, then a barrier orders it
+ * before executeCommandsInBuffer.  Returns false if the draw has to take the
+ * existing path.
+ *
+ * A shader write that feeds the count or indirect buffer inside the same
+ * render pass is only legal from a pre-rasterization stage in a VkRenderPass
+ * self-dependency (VUID-vkCmdPipelineBarrier2-None-07890 and
+ * VUID-vkCmdPipelineBarrier2-srcStageMask-09556).  kk_CmdPipelineBarrier2
+ * orders such writes before later vertex shaders in the encoder, which
+ * include the generator.
+ */
+static bool
+kk_draw_icb(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   if (unlikely(data->draw_count == 0))
+      return true;
+
+   if (!kk_draw_can_use_icb(cmd, data))
+      return false;
+
+   assert(data->predicate_addr[0] != 0u);
+
+   if (gfx->need_to_start_render_pass)
+      kk_flush_gfx_state(cmd);
+
+   /* kk_pool_alloc and kk_pool_upload set the command buffer error */
+   struct kk_ptr range = kk_pool_alloc(cmd, 2 * sizeof(uint32_t), 8u);
+   if (unlikely(!range.gpu))
+      return false;
+
+   /* The generator writes draw_id per draw.  The other fields are only used
+    * with tessellation and geometry shaders, which don't take this path. */
+   struct kk_per_draw_data tmpl_data = gfx->per_draw_data;
+   tmpl_data.draw_id = 0u;
+   uint32_t pd_size = sizeof(tmpl_data);
+   struct kk_ptr tmpl = kk_pool_upload(cmd, &tmpl_data, pd_size, 8u);
+
+   struct kk_ptr per_draw =
+      data->upload_mask
+         ? kk_pool_alloc(cmd, (uint64_t)pd_size * data->draw_count, 8u)
+         : (struct kk_ptr){0};
+
+   if (unlikely(!tmpl.gpu || (data->upload_mask && !per_draw.gpu)))
+      return false;
+
+   /* Last, so that no failure above leaves an unused ICB with the command
+    * buffer */
+   mtl_indirect_command_buffer *icb = kk_cmd_get_icb(cmd, data->draw_count);
+   if (unlikely(!icb))
+      return false;
+
+   struct kk_addr_range index = data->index_buffer;
+   struct kk_icb_gen_args args = {
+      .icb_id = mtl_icb_resource_id(icb),
+      .count_addr = data->predicate_addr[0],
+      .indirect_addr = data->indirect_command.addr,
+      .range_addr = range.gpu,
+      .index_addr = data->indexed ? index.addr : 0u,
+      .root_addr = cmd->state.root_addr,
+      .sampler_addr = dev->samplers.table.bo->gpu,
+      .per_draw_static = tmpl.gpu,
+      .per_draw_out = per_draw.gpu,
+      .per_draw_tmpl = tmpl.gpu,
+      .cond_addr = data->predicate_count == 2 ? data->predicate_addr[1] : 0u,
+      .max_draws = data->draw_count,
+      .in_stride_el = data->indirect_command.stride / sizeof(uint32_t),
+      .index_el_size_B = data->indexed ? data->index_buffer_el_size_B : 0u,
+      .prim_type = mesa_prim_to_mtl_primitive_type(data->prim),
+      .per_draw_size_el = data->upload_mask ? pd_size / sizeof(uint32_t) : 0u,
+      .cond_inverted = data->predicate_count == 2 &&
+                       data->predicate_op[1] == KK_PREDICATE_EQ_ZERO,
+   };
+
+   struct kk_ptr args_gpu = kk_pool_upload(cmd, &args, sizeof(args), 8u);
+   if (unlikely(!args_gpu.gpu))
+      return false;
+
+   mtl_render_encoder *enc = cs_get_render(cmd);
+   uint32_t view_mask = gfx->render.view_mask;
+   bool multiview = util_bitcount(view_mask) > 1u;
+   if (multiview) {
+      uint32_t zero_layer = 0u;
+      mtl_set_vertex_amplification_count(enc, &zero_layer, 1u);
+   }
+
+   mtl_set_address(cmd->argument_table, args_gpu.gpu, 0u);
+   mtl_render_set_pipeline_state(enc, dev->icb.gen_vs);
+   mtl_draw_primitives(enc, MTL_PRIMITIVE_TYPE_POINT, 0u, data->draw_count,
+                       1u, 0u);
+
+   /* Metal documents no stage for the ICB and execution range reads of
+    * executeCommandsInBuffer.  Vertex to vertex with device visibility was
+    * verified on Apple M5 Pro by a probe and by dEQP-VK. */
+   mtl_barrier_after_encoder_stages(
+      enc, MTL_STAGE_VERTEX, MTL_STAGE_VERTEX, MTL_VISIBILITY_OPTION_DEVICE);
+
+   if (multiview) {
+      uint32_t layer_ids[KK_MAX_MULTIVIEW_VIEW_COUNT] = {};
+      uint32_t count = 0u;
+      u_foreach_bit(id, view_mask)
+         layer_ids[count++] = id;
+      mtl_set_vertex_amplification_count(enc, layer_ids, count);
+   }
+
+   /* Restore the application's pipeline and root table */
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   mtl_render_set_pipeline_state(enc, vs->pipeline.gfx.render);
+   mtl_set_address(cmd->argument_table, cmd->state.root_addr, 0u);
+
+   mtl_render_execute_icb_indirect(enc, icb, range.gpu);
+   return true;
+}
