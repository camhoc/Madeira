+      const struct kk_cs_proof *p = &cs->info.cs.proofs[i];
+      const uint8_t *data;
+      size_t size;
+      if (desc->sets[p->set]) {
+         if (desc->sets[p->set]->layout->proof_unsafe)
+            return false;
+         data = desc->sets[p->set]->mapped_ptr;
+         size = desc->sets[p->set]->size;
+      } else if (desc->push[p->set] && desc->root.sets[p->set]) {
+         data = desc->push[p->set]->data;
+         size = sizeof(desc->push[p->set]->data);
+      } else {
+         return false;
+      }
+      struct kk_buffer_address d;
+      if (p->desc_offset + sizeof(d) > size)
+         return false;
+      memcpy(&d, data + p->desc_offset, sizeof(d));
+      if (d.size <= p->top)
+         return false;
+   }
+   return true;
+}
