+/* Is this read guarded by `constant offset < size`, where size is .z of the
+ * descriptor at a constant offset in a set whose address comes from the root
+ * table? If so, fills proof.
+ */
+static bool
+kk_proof_match(nir_intrinsic_instr *intr, struct kk_cs_proof *proof)
+{
+   if (intr->intrinsic != nir_intrinsic_load_global_constant_bounded ||
+       !nir_src_is_const(intr->src[1]))
+      return false;
+
+   nir_scalar size = nir_scalar_resolved(intr->src[2].ssa, 0);
+   if (size.comp != 2 || size.def->bit_size != 32 ||
+       !nir_scalar_is_intrinsic(size) ||
+       nir_scalar_intrinsic_op(size) !=
+          nir_intrinsic_load_global_constant_offset)
+      return false;
+   nir_intrinsic_instr *desc = nir_def_as_intrinsic(size.def);
+   if (!nir_src_is_const(desc->src[1]))
+      return false;
+
+   nir_scalar set_addr = nir_scalar_resolved(desc->src[0].ssa, 0);
+   if (!nir_scalar_is_intrinsic(set_addr) ||
+       nir_scalar_intrinsic_op(set_addr) != nir_intrinsic_load_global_constant)
+      return false;
+   nir_intrinsic_instr *load = nir_def_as_intrinsic(set_addr.def);
+
+   nir_scalar addr = nir_scalar_resolved(load->src[0].ssa, 0);
+   if (!nir_scalar_is_alu(addr) || nir_scalar_alu_op(addr) != nir_op_iadd)
+      return false;
+
+   uint64_t root_offset = UINT64_MAX;
+   bool has_root = false;
+   for (unsigned i = 0; i < 2; i++) {
+      nir_scalar s = nir_scalar_chase_alu_src(addr, i);
+      if (nir_scalar_is_alu(s) && nir_scalar_alu_op(s) == nir_op_u2u64)
+         s = nir_scalar_chase_alu_src(s, 0);
+      if (nir_scalar_is_const(s)) {
+         root_offset = nir_scalar_as_uint(s);
+      } else if (nir_scalar_is_intrinsic(s) &&
+                 nir_scalar_intrinsic_op(s) ==
+                    nir_intrinsic_load_buffer_ptr_kk &&
+                 nir_intrinsic_binding(nir_def_as_intrinsic(s.def)) == 0) {
+         has_root = true;
+      }
+   }
+
+   const uint64_t sets = offsetof(struct kk_root_descriptor_table, sets);
+   if (!has_root || root_offset == UINT64_MAX || root_offset < sets ||
+       (root_offset - sets) % sizeof(uint64_t) ||
+       (root_offset - sets) / sizeof(uint64_t) >= KK_MAX_SETS)
+      return false;
+
+   proof->set = (root_offset - sets) / sizeof(uint64_t);
+   proof->desc_offset = nir_src_as_uint(desc->src[1]);
+   proof->top = nir_src_as_uint(intr->src[1]);
+   return true;
+}
+
+/* Gathers one entry per descriptor. Returns 0 when there is nothing to prove
+ * or there are too many descriptors.
+ */
+static uint32_t
+kk_proof_gather(nir_shader *nir, struct kk_cs_proof *proofs)
+{
+   uint32_t count = 0;
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            struct kk_cs_proof p;
+            if (instr->type != nir_instr_type_intrinsic ||
+                !kk_proof_match(nir_instr_as_intrinsic(instr), &p))
+               continue;
+            uint32_t i;
+            for (i = 0; i < count; i++) {
+               if (proofs[i].set == p.set &&
+                   proofs[i].desc_offset == p.desc_offset)
+                  break;
+            }
+            if (i == KK_CS_PROOF_MAX)
+               return 0;
+            if (i == count) {
+               proofs[count++] = p;
+            } else {
+               proofs[i].top = MAX2(proofs[i].top, p.top);
+            }
+         }
+      }
+   }
+   return count;
+}
+
+/* Replaces each read kk_proof_match takes with the same read without the
+ * bounds check. Other reads keep their check.
+ */
+static void
+kk_proof_rewrite(nir_shader *nir)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr_safe(instr, block) {
+            struct kk_cs_proof p;
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (!kk_proof_match(intr, &p))
+               continue;
+            b.cursor = nir_before_instr(instr);
+            nir_def *load = nir_load_global_constant_offset(
+               &b, intr->def.num_components, intr->def.bit_size,
+               intr->src[0].ssa, intr->src[1].ssa,
+               .access = nir_intrinsic_access(intr),
+               .align_mul = nir_intrinsic_align_mul(intr),
+               .align_offset = nir_intrinsic_align_offset(intr));
+            nir_def_replace(&intr->def, load);
+         }
+      }
+      nir_progress(true, impl, nir_metadata_control_flow);
+   }
+   NIR_PASS(_, nir, nir_opt_dce);
+}
