--- src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -335,8 +335,24 @@ cs_get_compute(struct kk_cmd_buffer *cmd)
 static void
 end_encoder(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
 {
-   /* TODO_KOSMICKRISP This is probably overkill */
-   mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   /* Every encoder ends with a full ALL -> ALL barrier. Pipeline barriers
+    * recorded while no encoder is open and vkCmdWaitEvents2 emit nothing, so
+    * they rely on this one.
+    *
+    * Occlusion query results are written to the visibility buffer and read
+    * back through another address of the same memory, so a render encoder
+    * that had visibility results enabled flushes with ResourceAlias. Other
+    * render encoders only make their writes visible to the device. Compute
+    * encoders keep ResourceAlias.
+    */
+   const bool device_only = encoder == cmd->metal.render &&
+                            !cmd->state.gfx.occlusion.vis_enabled;
+   if (encoder == cmd->metal.render)
+      cmd->state.gfx.occlusion.vis_enabled = false;
+   mtl_barrier_after_stages_options(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL,
+                                    device_only
+                                       ? MTL_VISIBILITY_OPTION_DEVICE
+                                       : MTL_VISIBILITY_OPTION_RESOURCE_ALIAS);
    mtl_end_encoding(encoder);
    mtl_release(encoder);
 

