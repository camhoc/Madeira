+static int
+kk_ts_resolve_compare(const void *a, const void *b)
+{
+   const struct kk_ts_resolve *x = a, *y = b;
+   if (x->heap != y->heap)
+      return (uintptr_t)x->heap < (uintptr_t)y->heap ? -1 : 1;
+   if (x->index != y->index)
+      return x->index < y->index ? -1 : 1;
+   if (x->dst_addr != y->dst_addr)
+      return x->dst_addr < y->dst_addr ? -1 : 1;
+   return 0;
+}
+
+/* Each counter-heap resolve runs as a separate encoder that Metal inserts into
+ * the command buffer, and the GPU idles around each one. Pending resolves are
+ * therefore kept until the command buffer ends, or until a query reset or copy
+ * needs them, and runs of consecutive entries are merged into one resolve.
+ *
+ * Must be called with no encoder open, so that every timestamp write has passed
+ * its encoder's end barrier.
+ */
+void
+kk_cmd_flush_ts_resolves(struct kk_cmd_buffer *cmd)
+{
+   assert(!cmd->metal.render && !cmd->metal.compute);
 
-   /* Fold the pending timestamp counter-heap resolves into `cmd_buf` */
-   util_dynarray_foreach(&cmd->ts_resolves, struct kk_ts_resolve, r) {
-      mtl_command_resolve_counter_heap(cmd->metal.cmd_buf, r->heap, r->index,
-                                       1u, r->dst_addr);
+   const unsigned count =
+      util_dynarray_num_elements(&cmd->ts_resolves, struct kk_ts_resolve);
+   if (!count)
+      return;
+
+   struct kk_ts_resolve *r = cmd->ts_resolves.data;
+   qsort(r, count, sizeof(*r), kk_ts_resolve_compare);
+
+   /* A run of consecutive heap entries can be merged only if their reports are
+    * contiguous too. Both a timestamp heap entry and a query report are one
+    * uint64_t, and reports are laid out back to back.
+    */
+   for (unsigned i = 0; i < count;) {
+      unsigned n = 1;
+      while (i + n < count && r[i + n].heap == r[i].heap &&
+             r[i + n].index == r[i].index + n &&
+             r[i + n].dst_addr == r[i].dst_addr + n * sizeof(uint64_t))
+         n++;
+      mtl_command_resolve_counter_heap(cmd->metal.cmd_buf, r[i].heap,
+                                       r[i].index, n, r[i].dst_addr);
+      i += n;
    }
 
    util_dynarray_clear(&cmd->ts_resolves);

