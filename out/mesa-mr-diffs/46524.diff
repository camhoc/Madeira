+VKAPI_ATTR void VKAPI_CALL
+kk_CmdWaitEvents2(VkCommandBuffer commandBuffer, uint32_t eventCount,
+                  const VkEvent *pEvents,
+                  const VkDependencyInfo *pDependencyInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   /* The event is already set by the time we are here, only the ordering of
+    * its dependency is left. */
+   if (!kk_cmd_buffer_device(cmd)->barriers.narrow)
