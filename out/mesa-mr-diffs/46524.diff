+/* Everything not named in either list counts as both fragment and vertex, so an
+ * unknown stage conservatively adds a wait. */
+#define KK_BARRIER_VK_VERTEX_STAGES                                            \
+   (VK_PIPELINE_STAGE_2_VERTEX_INPUT_BIT |                                     \
+    VK_PIPELINE_STAGE_2_INDEX_INPUT_BIT |                                      \
+    VK_PIPELINE_STAGE_2_VERTEX_ATTRIBUTE_INPUT_BIT |                           \
+    VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |                                    \
+    VK_PIPELINE_STAGE_2_TESSELLATION_CONTROL_SHADER_BIT |                      \
+    VK_PIPELINE_STAGE_2_TESSELLATION_EVALUATION_SHADER_BIT |                   \
+    VK_PIPELINE_STAGE_2_GEOMETRY_SHADER_BIT |                                  \
+    VK_PIPELINE_STAGE_2_PRE_RASTERIZATION_SHADERS_BIT |                        \
+    VK_PIPELINE_STAGE_2_TASK_SHADER_BIT_EXT |                                  \
+    VK_PIPELINE_STAGE_2_MESH_SHADER_BIT_EXT)
+
+#define KK_BARRIER_VK_FRAGMENT_STAGES                                          \
+   (VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |                             \
+    VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |                              \
+    VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |                                  \
+    VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT)
+
+static void
+kk_barrier_record_member(struct kk_cmd_buffer *cmd, VkPipelineStageFlags2 src,
+                         VkPipelineStageFlags2 dst)
+{
+   const VkPipelineStageFlags2 common_src =
+      VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_HOST_BIT |
+      VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT;
+   /* A source mask also covers logically earlier stages, so a fragment source
+    * covers vertex work; a vertex source doesn't cover fragment work. */
+   const VkPipelineStageFlags2 non_vertex_dst =
+      KK_BARRIER_VK_FRAGMENT_STAGES | VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT |
+      VK_PIPELINE_STAGE_2_HOST_BIT | VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT;
+
+   const bool src_f = src & ~(common_src | KK_BARRIER_VK_VERTEX_STAGES);
+   const bool src_v = src & ~common_src;
+   const bool dst_v = dst & ~non_vertex_dst;
+
+   if (src_f || (src & cmd->state.barrier.chain_f)) {
+      cmd->state.barrier.chain_f |= dst;
+      if (dst_v)
+         cmd->state.barrier.wait_f = true;
+   }
+   if (src_v || (src & cmd->state.barrier.chain_v)) {
+      cmd->state.barrier.chain_v |= dst;
+      if (dst_v)
+         cmd->state.barrier.wait_v = true;
+   }
+}
+
+static void
+kk_barrier_record(struct kk_cmd_buffer *cmd, const VkDependencyInfo *dep)
+{
+   /* Everything earlier has finished, or will have before anything later
+    * starts, because of a compute encoder's ALL->ALL end. */
+   if (cmd->state.barrier.held ||
+       (cmd->metal.compute && cmd->state.barrier.compute_real))
+      return;
+
+   /* Twice, so that a chain inside one dependency is found in any order */
+   for (uint32_t pass = 0; pass < 2; pass++) {
+      for (uint32_t i = 0; i < dep->memoryBarrierCount; i++)
+         kk_barrier_record_member(cmd, dep->pMemoryBarriers[i].srcStageMask,
+                                  dep->pMemoryBarriers[i].dstStageMask);
+      for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++)
+         kk_barrier_record_member(cmd,
+                                  dep->pBufferMemoryBarriers[i].srcStageMask,
+                                  dep->pBufferMemoryBarriers[i].dstStageMask);
+      for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++)
+         kk_barrier_record_member(cmd,
+                                  dep->pImageMemoryBarriers[i].srcStageMask,
+                                  dep->pImageMemoryBarriers[i].dstStageMask);
+   }
+}
+
+/* Makes the recorded waits hold on the open render encoder. A consumer only
+ * covers work in earlier encoders. Returns true if it started a new encoder. */
+static bool
+kk_barrier_enforce(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->metal.render || kk_cmd_buffer_device(cmd)->barriers.nowait)
+      return false;
+
+   const bool need_f =
+      cmd->state.barrier.wait_f && !cmd->state.barrier.enc_wait_f;
+   const bool need_v =
+      cmd->state.barrier.wait_v && !cmd->state.barrier.enc_wait_v;
+   if (!need_f && !need_v)
+      return false;
+
+   if (!cmd->state.barrier.enc_had_draw) {
+      kk_barrier_apply_waits(cmd, need_f, need_v);
+      cmd->state.barrier.enc_wait_f |= need_f;
+      cmd->state.barrier.enc_wait_v |= need_v;
+      kk_barrier_count(cmd, KK_BARRIER_COUNT_IN_PLACE);
+      return false;
+   }
+
+   kk_barrier_count(cmd, KK_BARRIER_COUNT_SPLIT);
+   kk_apply_attachment_store_ops(cmd, true);
+   cs_end(cmd);
+   cs_start_render(cmd);
+   return true;
+}
+
+/* A vertex-stage timestamp must latch after earlier vertex work completes */
+void
+kk_barrier_vertex_timestamp(struct kk_cmd_buffer *cmd)
+{
+   if (!kk_cmd_buffer_device(cmd)->barriers.narrow || !cmd->metal.render)
+      return;
+
+   kk_barrier_count(cmd, KK_BARRIER_COUNT_VERTEX_TS);
+
+   /* For this encoder only: a later timestamp enforces for itself */
+   const bool wait_v = cmd->state.barrier.wait_v;
+   cmd->state.barrier.wait_v = true;
+   kk_barrier_enforce(cmd);
+   if (!wait_v)
+      cmd->state.barrier.wait_v = false;
+}
