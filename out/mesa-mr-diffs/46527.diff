+/* Null-descriptor stand-ins: one 1x1 texture per enum kk_null_texture_slot.
+ * The BO starts with their resource IDs and holds the backing store of the
+ * texel buffer stand-ins at KK_NULL_TEXEL_BUF_OFFSET. */
+#define KK_NULL_TEXTURES_BO_SIZE 512u
+#define KK_NULL_TEXEL_BUF_OFFSET 256u
+static_assert(KK_NULL_TEX_COUNT * sizeof(uint64_t) <= KK_NULL_TEXEL_BUF_OFFSET,
+              "null texture resource IDs overlap the texel buffer storage");
+
+static void
+kk_device_add_texture_to_residency_set(struct kk_device *dev, mtl_texture *tex)
+{
+   simple_mtx_lock(&dev->residency_set.mutex);
+   mtl_residency_set_add_allocation(dev->residency_set.handle, tex);
+   simple_mtx_unlock(&dev->residency_set.mutex);
+}
+
+static void
+kk_device_remove_texture_from_residency_set(struct kk_device *dev,
+                                            mtl_texture *tex)
+{
+   simple_mtx_lock(&dev->residency_set.mutex);
+   mtl_residency_set_remove_allocation(dev->residency_set.handle, tex);
+   simple_mtx_unlock(&dev->residency_set.mutex);
+}
+
+static void
+kk_device_finish_null_textures(struct kk_device *dev)
+{
+   if (dev->null_textures.bo == NULL)
+      return;
+
+   for (unsigned i = 0; i < KK_NULL_TEX_COUNT; i++) {
+      if (!dev->null_textures.tex[i])
+         continue;
+      if (!dev->null_textures.is_buf[i])
+         kk_device_remove_texture_from_residency_set(dev,
+                                                     dev->null_textures.tex[i]);
+      mtl_release(dev->null_textures.tex[i]);
+      dev->null_textures.tex[i] = NULL;
+   }
+
+   kk_destroy_bo(dev, dev->null_textures.bo);
+   dev->null_textures.bo = NULL;
+}
+
+static VkResult
+kk_device_init_null_textures(struct kk_device *dev)
+{
+   /* Storage images may be declared read_write in MSL, so stand-ins of the
+    * types that can be storage images need shader write usage even though
+    * they are never written. */
+   static const struct {
+      enum mtl_texture_type type;
+      uint8_t samples;
+      enum mtl_texture_usage usage;
+      enum pipe_format pipe_fmt;
+      enum mtl_pixel_format mtl_fmt;
+   } specs[KK_NULL_TEX_COUNT] = {
+#define COLOR_TRIPLE(slot_prefix, tex_type, samp, use)                         \
+   [KK_NULL_TEX_##slot_prefix##_FLOAT] = {tex_type, samp, use,                 \
+                                          PIPE_FORMAT_R32_FLOAT,               \
+                                          MTL_PIXEL_FORMAT_R32_FLOAT},         \
+   [KK_NULL_TEX_##slot_prefix##_SINT] = {tex_type, samp, use,                  \
+                                         PIPE_FORMAT_R32_SINT,                 \
+                                         MTL_PIXEL_FORMAT_R32_SINT},           \
+   [KK_NULL_TEX_##slot_prefix##_UINT] = {                                      \
+      tex_type, samp, use, PIPE_FORMAT_R32_UINT, MTL_PIXEL_FORMAT_R32_UINT}
+      COLOR_TRIPLE(
+         2D, MTL_TEXTURE_TYPE_2D, 1,
+         MTL_TEXTURE_USAGE_SHADER_READ | MTL_TEXTURE_USAGE_SHADER_WRITE),
+      COLOR_TRIPLE(
+         2D_ARRAY, MTL_TEXTURE_TYPE_2D_ARRAY, 1,
+         MTL_TEXTURE_USAGE_SHADER_READ | MTL_TEXTURE_USAGE_SHADER_WRITE),
+      COLOR_TRIPLE(
+         3D, MTL_TEXTURE_TYPE_3D, 1,
+         MTL_TEXTURE_USAGE_SHADER_READ | MTL_TEXTURE_USAGE_SHADER_WRITE),
+      COLOR_TRIPLE(CUBE, MTL_TEXTURE_TYPE_CUBE, 1,
+                   MTL_TEXTURE_USAGE_SHADER_READ),
+      COLOR_TRIPLE(CUBE_ARRAY, MTL_TEXTURE_TYPE_CUBE_ARRAY, 1,
+                   MTL_TEXTURE_USAGE_SHADER_READ),
+      COLOR_TRIPLE(2D_MS, MTL_TEXTURE_TYPE_2D_MULTISAMPLE, 4,
+                   MTL_TEXTURE_USAGE_SHADER_READ),
+      COLOR_TRIPLE(2D_MS_ARRAY, MTL_TEXTURE_TYPE_2D_ARRAY_MULTISAMPLE, 4,
+                   MTL_TEXTURE_USAGE_SHADER_READ),
+      COLOR_TRIPLE(
+         BUFFER, MTL_TEXTURE_TYPE_TEXTURE_BUFFER, 1,
+         MTL_TEXTURE_USAGE_SHADER_READ | MTL_TEXTURE_USAGE_SHADER_WRITE),
+#undef COLOR_TRIPLE
+      [KK_NULL_TEX_DEPTH_2D] = {MTL_TEXTURE_TYPE_2D, 1,
+                                MTL_TEXTURE_USAGE_SHADER_READ,
+                                PIPE_FORMAT_Z32_FLOAT,
+                                MTL_PIXEL_FORMAT_Z32_FLOAT},
+      [KK_NULL_TEX_DEPTH_2D_ARRAY] = {MTL_TEXTURE_TYPE_2D_ARRAY, 1,
+                                      MTL_TEXTURE_USAGE_SHADER_READ,
+                                      PIPE_FORMAT_Z32_FLOAT,
+                                      MTL_PIXEL_FORMAT_Z32_FLOAT},
+      [KK_NULL_TEX_DEPTH_CUBE] = {MTL_TEXTURE_TYPE_CUBE, 1,
+                                  MTL_TEXTURE_USAGE_SHADER_READ,
+                                  PIPE_FORMAT_Z32_FLOAT,
+                                  MTL_PIXEL_FORMAT_Z32_FLOAT},
+      [KK_NULL_TEX_DEPTH_CUBE_ARRAY] = {MTL_TEXTURE_TYPE_CUBE_ARRAY, 1,
+                                        MTL_TEXTURE_USAGE_SHADER_READ,
+                                        PIPE_FORMAT_Z32_FLOAT,
+                                        MTL_PIXEL_FORMAT_Z32_FLOAT},
+      [KK_NULL_TEX_DEPTH_2D_MS] = {MTL_TEXTURE_TYPE_2D_MULTISAMPLE, 4,
+                                   MTL_TEXTURE_USAGE_SHADER_READ,
+                                   PIPE_FORMAT_Z32_FLOAT,
+                                   MTL_PIXEL_FORMAT_Z32_FLOAT},
+   };
+
+   VkResult result = kk_alloc_bo(dev, &dev->vk.base, KK_NULL_TEXTURES_BO_SIZE,
+                                 8u, &dev->null_textures.bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   memset(dev->null_textures.bo->cpu, 0, KK_NULL_TEXTURES_BO_SIZE);
+   uint64_t *rids = (uint64_t *)dev->null_textures.bo->cpu;
+
+   for (unsigned i = 0; i < KK_NULL_TEX_COUNT; i++) {
+      const bool is_buf = specs[i].type == MTL_TEXTURE_TYPE_TEXTURE_BUFFER;
+      struct kk_image_layout layout = {
+         .width_px = 1u,
+         .height_px = 1u,
+         .depth_px = 1u,
+         .layers = 1u,
+         .type = specs[i].type,
+         .sample_count_sa = specs[i].samples,
+         .levels = 1u,
+         .linear = is_buf,
+         .optimized_layout = !is_buf && specs[i].samples == 1u,
+         .usage = specs[i].usage,
+         .format = {.pipe = specs[i].pipe_fmt, .mtl = specs[i].mtl_fmt},
+         .linear_stride_B = is_buf ? KK_MIN_TEXEL_BUFFER_ALIGNMENT : 0u,
+      };
+
+      mtl_texture *tex =
+         is_buf
+            ? mtl_new_texture_with_descriptor_linear(
+                 dev->null_textures.bo->map, &layout, KK_NULL_TEXEL_BUF_OFFSET)
+            : mtl_new_device_texture(dev->mtl_handle, &layout);
+      if (tex == NULL) {
+         kk_device_finish_null_textures(dev);
+         return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      }
+
+      dev->null_textures.tex[i] = tex;
+      dev->null_textures.is_buf[i] = is_buf;
+      /* Texel buffer stand-ins live in the BO, which is already resident */
+      if (!is_buf)
+         kk_device_add_texture_to_residency_set(dev, tex);
+      rids[i] = mtl_texture_get_gpu_resource_id(tex);
+   }
+
+   return VK_SUCCESS;
+}
