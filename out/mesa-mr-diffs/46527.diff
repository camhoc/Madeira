+static bool
+lower_read_or_query(nir_builder *b, nir_instr *instr, nir_src *handle_src,
+                    nir_def *def)
+{
+   nir_instr *parent = nir_def_instr(handle_src->ssa);
+   if (parent->type != nir_instr_type_intrinsic)
+      return false;
+
+   nir_intrinsic_instr *handle_intr = nir_instr_as_intrinsic(parent);
+   int slot = standin_index_for_handle(handle_intr);
+   if (slot < 0)
+      return false;
+
+   b->cursor = nir_before_instr(instr);
+
+   nir_def *orig_addr = handle_intr->src[0].ssa;
+   nir_def *rid = nir_build_load_global_constant(
+      b, 1, 64, orig_addr, .align_mul = 8, .access = ACCESS_CAN_SPECULATE);
+   nir_def *is_null = nir_ieq_imm(b, rid, 0);
+
+   nir_def *root = nir_load_buffer_ptr_kk(b, 1, 64, .binding = 0);
+   nir_def *table_base = nir_build_load_global_constant(
+      b, 1, 64,
+      nir_iadd_imm(b, root,
+                   offsetof(struct kk_root_descriptor_table, null_textures)),
+      .align_mul = 8, .access = ACCESS_CAN_SPECULATE);
+   nir_def *standin_addr =
+      nir_iadd_imm(b, table_base, (uint64_t)slot * sizeof(uint64_t));
+   nir_def *safe_addr = nir_bcsel(b, is_null, standin_addr, orig_addr);
+
+   nir_intrinsic_instr *clone =
+      nir_instr_as_intrinsic(nir_instr_clone(b->shader, &handle_intr->instr));
+   clone->src[0] = nir_src_for_ssa(safe_addr);
+   nir_builder_instr_insert(b, &clone->instr);
+   nir_src_rewrite(handle_src, &clone->def);
+
+   b->cursor = nir_after_instr(instr);
+   nir_def *zero = nir_imm_zero(b, def->num_components, def->bit_size);
+   nir_def *masked = nir_bcsel(b, is_null, zero, def);
+   nir_def_rewrite_uses_after(def, masked);
+
+   return true;
+}
