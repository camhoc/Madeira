+static int
+standin_index_for_handle(const nir_intrinsic_instr *handle_intr)
+{
+   enum glsl_sampler_dim dim = nir_intrinsic_image_dim(handle_intr);
+   bool is_array = nir_intrinsic_image_array(handle_intr);
+
+   if (handle_intr->intrinsic == nir_intrinsic_load_depth_texture_kk) {
+      switch (dim) {
+      case GLSL_SAMPLER_DIM_2D:
+         return is_array ? KK_NULL_TEX_DEPTH_2D_ARRAY : KK_NULL_TEX_DEPTH_2D;
+      case GLSL_SAMPLER_DIM_CUBE:
+         return is_array ? KK_NULL_TEX_DEPTH_CUBE_ARRAY
+                         : KK_NULL_TEX_DEPTH_CUBE;
+      case GLSL_SAMPLER_DIM_MS:
+         return is_array ? -1 : KK_NULL_TEX_DEPTH_2D_MS;
+      default:
+         return -1;
+      }
+   }
+
+   if (handle_intr->intrinsic != nir_intrinsic_load_texture_handle_kk)
+      return -1;
+
+   enum msl_tex_access_flag access = nir_intrinsic_flags(handle_intr);
+   if ((access == MSL_ACCESS_WRITE || access == MSL_ACCESS_READ_WRITE) &&
+       (dim == GLSL_SAMPLER_DIM_CUBE || dim == GLSL_SAMPLER_DIM_MS))
+      return -1;
+
+   int sc = -1;
+   switch (nir_intrinsic_dest_type(handle_intr)) {
+   case nir_type_float16:
+   case nir_type_float32:
+      sc = 0;
+      break;
+   case nir_type_int16:
+   case nir_type_int32:
+      sc = 1;
+      break;
+   case nir_type_uint16:
+   case nir_type_uint32:
+      sc = 2;
+      break;
+   default:
+      return -1;
+   }
+
+   switch (dim) {
+   case GLSL_SAMPLER_DIM_2D:
+      return (is_array ? KK_NULL_TEX_2D_ARRAY_FLOAT : KK_NULL_TEX_2D_FLOAT) +
+             sc;
+   case GLSL_SAMPLER_DIM_3D:
+      return is_array ? -1 : (KK_NULL_TEX_3D_FLOAT + sc);
+   case GLSL_SAMPLER_DIM_CUBE:
+      return (is_array ? KK_NULL_TEX_CUBE_ARRAY_FLOAT
+                       : KK_NULL_TEX_CUBE_FLOAT) +
+             sc;
+   case GLSL_SAMPLER_DIM_MS:
+      return (is_array ? KK_NULL_TEX_2D_MS_ARRAY_FLOAT
+                       : KK_NULL_TEX_2D_MS_FLOAT) +
+             sc;
+   case GLSL_SAMPLER_DIM_BUF:
+      return is_array ? -1 : (KK_NULL_TEX_BUFFER_FLOAT + sc);
+   default:
+      return -1;
+   }
+}
