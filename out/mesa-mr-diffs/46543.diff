+/* Interchange cannot be used for Z/S buffers or array textures */
+static inline bool
+ail_can_interchange(enum pipe_format format, bool is_array)
+{
+   return !util_format_is_depth_or_stencil(format) &&
+          !util_format_is_compressed(format) &&
+          !is_array;
+}
