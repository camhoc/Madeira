+
+#include "tests/nir_test.h"
+
+extern "C" {
+#include "msl_private.h"
+}
+
+#include <functional>
+#include <vector>
+
+typedef std::function<nir_def *(nir_builder *, nir_def *)> build_fn;
+typedef std::function<uint32_t(uint32_t)> eval_fn;
+
+/* Byte offset of the opaque zero in buffer 0 for the opaque-zero form. */
+#define ZERO_OFFSET 52
+#define WIDEN_FORM -1
+
+class msl_widen_u2u64_shifts_test : public nir_test {
+protected:
+   msl_widen_u2u64_shifts_test() : nir_test("msl_widen_u2u64_shifts_test")
+   {
+   }
+
+   unsigned count_alu(nir_op op)
+   {
+      unsigned n = 0;
+      nir_foreach_function_impl(impl, b->shader)
+         nir_foreach_block(block, impl)
+            nir_foreach_instr(instr, block)
+               n += instr->type == nir_instr_type_alu &&
+                    nir_instr_as_alu(instr)->op == op;
+      return n;
+   }
+
+   /* The opaque zero the pass loaded, or NULL. */
+   nir_intrinsic_instr *find_zero()
+   {
+      nir_intrinsic_instr *zero = NULL;
+      nir_foreach_function_impl(impl, b->shader)
+         nir_foreach_block(block, impl)
+            nir_foreach_instr(instr, block) {
+               if (instr->type != nir_instr_type_intrinsic ||
+                   nir_instr_as_intrinsic(instr)->intrinsic !=
+                      nir_intrinsic_load_global_constant)
+                  continue;
+               EXPECT_EQ(zero, nullptr) << "more than one opaque zero";
+               zero = nir_instr_as_intrinsic(instr);
+            }
+      return zero;
+   }
+
+   nir_intrinsic_instr *store(nir_def *value)
+   {
+      return nir_store_global(b, value, nir_imm_int64(b, 0));
+   }
+
+   /* Builds u2u64(build(x)) for every x, runs the pass and constant folding,
+    * and checks the result against the 32-bit result computed on the CPU.
+    */
+   void check_values(build_fn build, eval_fn eval, int32_t form)
+   {
+      static const uint32_t inputs[] = {
+         0x00000000, 0x00000001, 0x0000ffff, 0x10000001,
+         0x20000003, 0x7fffffff, 0x80000000, 0xe0000005,
+         0xf0000fff, 0xffffffff, 0x12345678, 0xdeadbeef,
+      };
+
+      std::vector<nir_intrinsic_instr *> stores;
+      for (uint32_t x : inputs)
+         stores.push_back(store(nir_u2u64(b, build(b, nir_imm_int(b, x)))));
+
+      ASSERT_TRUE(msl_nir_widen_u2u64_shifts(b->shader, form));
+      nir_validate_shader(b->shader, "after msl_nir_widen_u2u64_shifts");
+      if (form >= 0) {
+         /* The zero is opaque by design; fold it here to check the values. */
+         nir_intrinsic_instr *zero = find_zero();
+         ASSERT_NE(zero, nullptr);
+         EXPECT_EQ(nir_intrinsic_access(zero) & ACCESS_CAN_SPECULATE,
+                   ACCESS_CAN_SPECULATE);
+         b->cursor = nir_after_instr(&zero->instr);
+         nir_def_replace(&zero->def, nir_imm_int(b, 0));
+      }
+      nir_opt_constant_folding(b->shader);
+
+      for (unsigned i = 0; i < ARRAY_SIZE(inputs); i++) {
+         nir_src *value = &stores[i]->src[0];
+         ASSERT_TRUE(nir_src_is_const(*value));
+         EXPECT_EQ(nir_src_as_uint(*value), (uint64_t)eval(inputs[i]))
+            << "input 0x" << std::hex << inputs[i];
+      }
+   }
+
+   void check_values(build_fn build, eval_fn eval)
+   {
+      check_values(build, eval, WIDEN_FORM);
+      if (HasFatalFailure())
+         return;
+      /* Fresh shader for the opaque-zero form. */
+      ralloc_free(b->shader);
+      *b = nir_builder_init_simple_shader(MESA_SHADER_COMPUTE, &options,
+                                          "opaque_zero");
+      check_values(build, eval, ZERO_OFFSET);
+   }
+
+   /* Checks that the pass rewrites u2u64(build(x)) for a non-constant x into
+    * a 64-bit iand with 0xffffffff.
+    */
+   void check_rewritten(build_fn build)
+   {
+      nir_def *x = nir_load_local_invocation_index(b);
+      nir_intrinsic_instr *st = store(nir_u2u64(b, build(b, x)));
+
+      ASSERT_TRUE(msl_nir_widen_u2u64_shifts(b->shader, WIDEN_FORM));
+      nir_validate_shader(b->shader, "after msl_nir_widen_u2u64_shifts");
+
+      nir_scalar res = nir_get_scalar(st->src[0].ssa, 0);
+      ASSERT_TRUE(nir_scalar_is_alu(res));
+      EXPECT_EQ(nir_scalar_alu_op(res), nir_op_iand);
+      EXPECT_EQ(res.def->bit_size, 64);
+      nir_scalar mask = nir_scalar_chase_alu_src(res, 1);
+      ASSERT_TRUE(nir_scalar_is_const(mask));
+      EXPECT_EQ(nir_scalar_as_uint(mask), 0xffffffffull);
+   }
+};
