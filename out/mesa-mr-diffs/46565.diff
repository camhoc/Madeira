+/* KK_WORKAROUND_21
+ *
+ * Rewrites u2u64(x), where the 32-bit x is computed by a tree of ishl, iadd,
+ * ior and imul that contains a shift (or a multiplication by a constant), as
+ * iand(x', 0xffffffff), where x' is the same tree computed in 64 bits. The
+ * low 32 bits of these operations only depend on the low 32 bits of their
+ * operands, so the result is identical for every input.
+ *
+ * Limits: only scalar u2u64 is handled, other ways to zero-extend (such as
+ * pack_64_2x32_split(x, 0)) are not, and only the top WIDEN_MAX_DEPTH levels
+ * of the tree are rebuilt; anything below them stays in 32 bits.
+ *
+ * WIDEN_MAX_DEPTH bounds the rebuilt tree to 15 instructions per u2u64. The
+ * known failing pattern, a shifted index, needs one level.
+ *
+ * Opaque-zero form (opaque_zero_root_offset >= 0): instead of rebuilding the
+ * tree in 64 bits, xor its base with a 32-bit zero loaded from buffer 0 at
+ * that byte offset. The back end only miscompiles when it can see that the
+ * low 32 bits come straight from a shift or multiply; a value loaded from
+ * memory hides that, and everything stays in 32 bits. The base is the u2u64
+ * source with constant iadds peeled off, so struct fields (x + 4, x + 12...)
+ * and bounds checks built from the same x share one ixor. Bases are
+ * collected first and rewritten afterwards: an ixor already in the tree would
+ * hide its shift from widen_has_shift.
+ */
+#define WIDEN_MAX_DEPTH 4
+
+static bool
+widen_is_op(nir_scalar s)
+{
+   if (nir_def_instr_type(s.def) != nir_instr_type_alu || s.def->bit_size != 32 ||
+       s.def->num_components != 1)
+      return false;
+   switch (nir_scalar_alu_op(s)) {
+   case nir_op_ishl:
+   case nir_op_iadd:
+   case nir_op_ior:
+   case nir_op_imul:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static bool
+widen_has_shift(nir_scalar s, unsigned depth)
+{
+   if (depth == 0 || !widen_is_op(s))
+      return false;
+   nir_op op = nir_scalar_alu_op(s);
+   if (op == nir_op_ishl)
+      return true;
+   if (op == nir_op_imul && (nir_scalar_is_const(nir_scalar_chase_alu_src(s, 0)) ||
+                             nir_scalar_is_const(nir_scalar_chase_alu_src(s, 1))))
+      return true;
+   return widen_has_shift(nir_scalar_chase_alu_src(s, 0), depth - 1) ||
+          widen_has_shift(nir_scalar_chase_alu_src(s, 1), depth - 1);
+}
+
+static nir_def *
+widen_build(nir_builder *b, nir_scalar s, unsigned depth)
+{
+   if (depth == 0 || !widen_is_op(s))
+      return nir_u2u64(b, nir_mov_scalar(b, s));
+
+   nir_scalar s0 = nir_scalar_chase_alu_src(s, 0);
+   nir_scalar s1 = nir_scalar_chase_alu_src(s, 1);
+   nir_def *a = widen_build(b, s0, depth - 1);
+   switch (nir_scalar_alu_op(s)) {
+   case nir_op_ishl:
+      /* 32-bit ishl uses the shift count mod 32 */
+      return nir_ishl(b, a, nir_iand_imm(b, nir_mov_scalar(b, s1), 31));
+   case nir_op_iadd:
+      return nir_iadd(b, a, widen_build(b, s1, depth - 1));
+   case nir_op_ior:
+      return nir_ior(b, a, widen_build(b, s1, depth - 1));
+   case nir_op_imul:
+      return nir_imul(b, a, widen_build(b, s1, depth - 1));
+   default:
+      UNREACHABLE("widen_is_op");
+   }
+}
+
+/* Returns the scalar u2u64 if it needs the workaround (with its 32-bit source
+ * in *src), or NULL.
+ */
+static nir_alu_instr *
+widen_site(nir_instr *instr, nir_scalar *src)
+{
+   if (instr->type != nir_instr_type_alu)
+      return NULL;
+   nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->op != nir_op_u2u64 || alu->def.num_components != 1 ||
+       nir_src_bit_size(alu->src[0].src) != 32)
+      return NULL;
+
+   *src = nir_scalar_chase_alu_src(nir_get_scalar(&alu->def, 0), 0);
+   return widen_has_shift(*src, WIDEN_MAX_DEPTH) ? alu : NULL;
+}
+
+static bool
+widen_u2u64_shift(nir_builder *b, nir_instr *instr, void *data)
+{
+   nir_scalar src;
+   nir_alu_instr *alu = widen_site(instr, &src);
+   if (!alu)
+      return false;
+
+   b->cursor = nir_before_instr(instr);
+   nir_def *wide = widen_build(b, src, WIDEN_MAX_DEPTH);
+   nir_def *res = nir_iand_imm(b, wide, 0xffffffffull);
+   nir_def_replace(&alu->def, res);
+   return true;
+}
+
+/* Peels iadd(x, const) down to x. Only iadd: (x ^ z) | c would lose the
+ * known-zero low bits of x that let the back end fold c into the address.
+ */
+static nir_scalar
+widen_base(nir_scalar s)
+{
+   while (nir_scalar_is_alu(s) && nir_scalar_alu_op(s) == nir_op_iadd) {
+      nir_scalar s0 = nir_scalar_chase_alu_src(s, 0);
+      nir_scalar s1 = nir_scalar_chase_alu_src(s, 1);
+      if (nir_scalar_is_const(s1))
+         s = s0;
+      else if (nir_scalar_is_const(s0))
+         s = s1;
+      else
+         break;
+   }
+   return s;
+}
+
+static bool
+widen_opaque_zero_impl(nir_function_impl *impl, int32_t root_offset)
+{
+   /* Phase 1: collect the bases, read-only, in program order (the set only
+    * removes duplicates) so the output does not depend on pointer values.
+    */
+   struct set *seen = _mesa_pointer_set_create(NULL);
+   struct util_dynarray bases;
+   util_dynarray_init(&bases, NULL);
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         nir_scalar src;
+         if (!widen_site(instr, &src))
+            continue;
+         /* widen_has_shift held, and peeling only drops constants, so the
+          * base is a scalar 32-bit ALU op (widen_is_op).
+          */
+         nir_scalar base = widen_base(src);
+         assert(widen_is_op(base) && base.comp == 0);
+         bool found;
+         _mesa_set_search_or_add(seen, base.def, &found);
+         if (!found)
+            util_dynarray_append(&bases, base.def);
+      }
+   }
+   _mesa_set_destroy(seen, NULL);
+
+   if (!util_dynarray_num_elements(&bases, nir_def *)) {
+      util_dynarray_fini(&bases);
+      return nir_no_progress(impl);
+   }
+
+   /* Phase 2: one opaque zero per impl, one ixor per base. */
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *root = nir_load_buffer_ptr_kk(&b, 1, 64, .binding = 0);
+   nir_def *zero = nir_build_load_global_constant(
+      &b, 1, 32, nir_iadd_imm(&b, root, root_offset), .align_mul = 4,
+      .access = ACCESS_CAN_SPECULATE);
+
+   util_dynarray_foreach(&bases, nir_def *, xp) {
+      nir_def *x = *xp;
+      /* Bases are ALU ops (asserted above), so never phis. */
+      b.cursor = nir_after_instr(nir_def_instr(x));
+      nir_def *x_xor = nir_ixor(&b, x, zero);
+      nir_def_rewrite_uses_after(x, x_xor);
+   }
+
+   util_dynarray_fini(&bases);
+   return nir_progress(true, impl, nir_metadata_control_flow);
+}
+
+bool
+msl_nir_widen_u2u64_shifts(nir_shader *nir, int32_t opaque_zero_root_offset)
+{
+   if (opaque_zero_root_offset < 0)
+      return nir_shader_instructions_pass(nir, widen_u2u64_shift,
+                                          nir_metadata_control_flow, NULL);
+
+   bool progress = false;
+   nir_foreach_function_impl(impl, nir)
+      progress |= widen_opaque_zero_impl(impl, opaque_zero_root_offset);
+   return progress;
+}

