+    cs32_sel = ldt_alloc_entry( ldt_make_cs32_entry() );
+#endif
+
+    NtFreeVirtualMemory( GetCurrentProcess(), &stack.DeallocationStack, &size, MEM_RELEASE );
+    wow_teb->Tib.StackBase = 0;
+    wow_teb->Tib.StackLimit = 0;
+    wow_teb->DeallocationStack = 0;
+}
