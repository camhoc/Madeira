+        ok(IsEqualGUID(&key, &GUID_NULL), "Got key %s\n", debugstr_guid(&key));
+        ok(var.vt == VT_EMPTY, "Got type %d\n", var.vt);
+        memset(&key, 0, sizeof(key));
+        PropVariantClear(&var);
+
+        IUnknown_Release((IUnknown *)ptr);
+    }
