+        hr = IMFAttributes_GetItemByIndex(attr, 2, &key, &var);
+        ok(hr == S_OK, "Got hr %#lx\n", hr);
+        ok(IsEqualGUID(&key, &MF_BYTESTREAM_LAST_MODIFIED_TIME), "Got key %s\n", debugstr_guid(&key));
