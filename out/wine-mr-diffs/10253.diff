+        hr = IMFByteStreamBuffering_EnableBuffering(buffering, TRUE);
+        ok(hr == S_OK, "Got hr %#lx\n", hr);
+
+        hr = IMFByteStreamBuffering_StopBuffering(buffering);
+        ok(hr == S_OK || hr == S_FALSE, "Got hr %#lx\n", hr);
