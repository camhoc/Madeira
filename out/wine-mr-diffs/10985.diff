```
docker run --rm \
  -u "$(id -u):$(id -g)" \
  -v "$PWD:/work" \
  -w /work \
  registry.gitlab.steamos.cloud/proton/steamrt4/sdk/arm64-llvm:4.0.20260331.220802-0 \
  /opt/llvm-mingw/bin/x86_64-w64-mingw32-clang \
    -Wall -Wextra -O2 -g \
    -o repros/fex_exec_section_remap_repro.exe \
    scripts/fex_exec_section_remap_repro.c
```

