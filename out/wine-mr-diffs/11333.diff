+void macdrv_init_cocoa_threads(void)
+{
+    /* Make sure Cocoa is in multi-threading mode by detaching a
+       do-nothing thread. */
+    [NSThread detachNewThreadSelector:@selector(self)
+                             toTarget:[NSThread class]
+                           withObject:nil];
+}
 
