+static pthread_mutex_t follow_signal_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t follow_signal_cond = PTHREAD_COND_INITIALIZER;
+static unsigned int follow_generation; /* guarded by follow_signal_lock */
