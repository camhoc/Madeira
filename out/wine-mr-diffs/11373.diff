     void *pointer_info = get_ptr( &args );
+    size_t target_size32 = 0, target_size64 = 0;
+
+    switch (type)
+    {
+    case PT_POINTER:
+        target_size32 = sizeof(POINTER_INFO32);
+        target_size64 = sizeof(POINTER_INFO);
+        break;
+    case PT_PEN:
+        target_size32 = sizeof(POINTER_PEN_INFO32);
