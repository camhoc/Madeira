@@ -100,6 +102,35 @@ static inline DWORD BrowseFlagsToSHCONTF(UINT ulFlags)
     return SHCONTF_FOLDERS | (ulFlags & BIF_BROWSEINCLUDEFILES ? SHCONTF_NONFOLDERS : 0);
 }
 
+/* Some applications pass garbage instead of a pidl as BROWSEINFO.pidlRoot
+ * (e.g. a plain CSIDL value).  Windows doesn't crash on those, so check that
+ * the pidl is readable and fall back to the desktop folder if it isn't. */
+static LPCITEMIDLIST get_root_pidl( LPCITEMIDLIST pidl )
+{
+    DWORD size = 0;
+
+    if (!pidl) return NULL;
+
+    __TRY
+    {
+        size = ILGetSize( pidl );
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        size = 0;
+    }
+    __ENDTRY
+
+    if (!size)
+    {
+        WARN( "ignoring invalid root pidl %p\n", pidl );
+        return NULL;
+    }
+
+    TRACE( "root pidl %p, size %lu\n", pidl, size );
+    return pidl;
+}
+
 static void browsefolder_callback( LPBROWSEINFOW lpBrowseInfo, HWND hWnd,
                                    UINT msg, LPARAM param )
 {
@@ -188,7 +219,7 @@ static void InitializeTreeView( browse_info *info )
     IEnumIDList * pEnumChildren = NULL;
     HTREEITEM item;
     DWORD flags;
-    LPCITEMIDLIST root = info->lpBrowseInfo->pidlRoot;
+    LPCITEMIDLIST root = info->root;
 
     TRACE("%p\n", info );
     
@@ -925,7 +956,7 @@ static BOOL BrsFolder_OnSetExpanded(browse_info *info, LPVOID selection,
 
     /* Move pidlCurrent behind the SHITEMIDs in pidlSelection, which are the root of
      * the sub-tree currently displayed. */
-    pidlRoot = info->lpBrowseInfo->pidlRoot;
+    pidlRoot = info->root;
     pidlCurrent = pidlSelection;
     while (!_ILIsEmpty(pidlRoot) && _ILIsEqualSimple(pidlRoot, pidlCurrent)) {
         pidlRoot = ILGetNext(pidlRoot);
@@ -1221,6 +1252,7 @@ LPITEMIDLIST WINAPI SHBrowseForFolderW (LPBROWSEINFOW lpbi)
     info.hWnd = 0;
     info.pidlRet = NULL;
     info.lpBrowseInfo = lpbi;
+    info.root = get_root_pidl( lpbi->pidlRoot );
     info.hwndTreeView = NULL;
 
     icex.dwSize = sizeof( icex );

