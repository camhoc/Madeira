# ntdll: Detect circular export forwarders and return the appropriate error.
# https://gitlab.winehq.org/wine/wine/-/merge_requests/11701 state=opened
# When export forwarders have circular dependencies, Wine currently causes a stack overflow, which differs from Windows behavior.

This patch uses a stack to detect circular dependencies and returns the same error code as Windows.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60130

Signed-off-by: Kyle Yang kyle.chaoxin.yang@gmail.com
--- dlls/kernel32/tests/loader.c
+++ dlls/kernel32/tests/loader.c
@@ -90,6 +90,65 @@ static PVOID RVAToAddr(DWORD_PTR rva, HMODULE module)
     return ((char*) module) + rva;
 }
 
+static DWORD AddrToRVA(void *base, IMAGE_NT_HEADERS *nt_headers, void *addr)
+{
+    DWORD offset = (DWORD)((char *)addr - (char *)base);
+    IMAGE_SECTION_HEADER *section_header;
+    DWORD ret = 0;
+    int i;
+
+    section_header = IMAGE_FIRST_SECTION(nt_headers);
+
+    for (i = 0; i < nt_headers->FileHeader.NumberOfSections; i++)
+    {
+        if (section_header[i].PointerToRawData <= offset &&
+            offset <= section_header[i].PointerToRawData + section_header[i].SizeOfRawData)
+        {
+            ret = offset - section_header[i].PointerToRawData + section_header[i].VirtualAddress;
+            break;
+        }
+    }
+
+    return ret;
+}
+
+static void get_module_name( const char *file_name, char *module_name )
+{
+    const char *dot = strrchr(file_name, '.');
+    if (dot == NULL) memcpy(module_name, file_name, strlen(file_name));
+    else
+    {
+        UINT offset = dot - file_name;
+        memcpy(module_name, file_name, offset);
+        *(module_name + offset) = '\0';
+    }
+}
+
+const void*	PRD(void *base, DWORD total_len, unsigned long prd, unsigned long len)
+{
+    return (prd + len > total_len) ? NULL : (const char*)base + prd;
+}
+
+static const void* RVA(void *base, DWORD size, IMAGE_NT_HEADERS *nt_headers, DWORD rva, DWORD len)
+{
+    IMAGE_SECTION_HEADER *section_header;
+    int i;
+
+    if (rva == 0) return NULL;
+
+    section_header = IMAGE_FIRST_SECTION(nt_headers);
+    for (i = nt_headers->FileHeader.NumberOfSections - 1; i >= 0; i--)
+    {
+        if (section_header[i].VirtualAddress <= rva &&
+            rva + len <= (DWORD)section_header[i].VirtualAddress + section_header[i].SizeOfRawData)
+        {
+            return PRD(base, size, section_header[i].PointerToRawData + rva - section_header[i].VirtualAddress, len);
+        }
+    }
+
+    return NULL;
+}
