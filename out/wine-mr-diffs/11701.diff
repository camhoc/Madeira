+static const char *get_file_name(const char *full_path)
+{
+    const char *file_name = strrchr(full_path, '\\');
+    if (!file_name)
+        file_name = strrchr(full_path, '/');
+
+    return file_name ? (file_name + 1) : full_path;
+}
+
+static BOOL update_test_dll( const char *dll_name, const char *target_forward_name,
+                       const char **export_names, DWORD export_names_count )
+{
+    const char *last_name_start, *last_name_end, *choose_pos, *forward_name_offset;
+    DWORD file_size, read_size, nt_header_rva, export_rva, export_size;
+    DWORD forward_name_size, forward_name_pos, out_len;
+    IMAGE_EXPORT_DIRECTORY *export_directory;
+    HANDLE hfile, base, forward_name;
+    IMAGE_DOS_HEADER *dos_header;
+    IMAGE_NT_HEADERS *nt_header;
+    const UINT *pName, *pFunc;
+    char module_name[128];
+    const WORD *pOrdl;
+    UINT *funcs;
+    BOOL ret;
+    int i;
+
+    SetLastError(0xdeadbeef);
+    hfile = CreateFileA( dll_name, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, 0 );
+    ok( hfile != INVALID_HANDLE_VALUE, "failed to open exist file %s err %lu\n", dll_name, GetLastError() );
+    if (hfile == INVALID_HANDLE_VALUE) return FALSE;
+
+    SetLastError(0xdeadbeef);
+    file_size = GetFileSize( hfile, NULL );
+    assert( file_size > (sizeof(IMAGE_DOS_HEADER) + sizeof(IMAGE_NT_HEADERS)) );
+
+    SetLastError(0xdeadbeef);
+    base = HeapCreate( 0, file_size, file_size );
+    ok( !!base, "failed to allocate heap: error %ld\n", GetLastError());
+
+    SetLastError(0xdeadbeef);
+    ret = ReadFile( hfile, base, file_size, &read_size, NULL );
+    ok( ret && file_size == read_size, "ReadFile: error %ld\n", GetLastError());
+
+    dos_header = (IMAGE_DOS_HEADER *)base;
+
+    nt_header_rva = dos_header->e_lfanew;
+    nt_header = (IMAGE_NT_HEADERS *)( (char *)base + nt_header_rva );
+
+    if ( export_names && export_names_count > 0 )
+    {
+        export_rva = nt_header->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress;
+        export_size = nt_header->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].Size;
+
+        export_directory = (IMAGE_EXPORT_DIRECTORY *)RVA(base, file_size, nt_header, export_rva, export_size);
+
+        pName = RVA(base, file_size, nt_header, export_directory->AddressOfNames, export_directory->NumberOfNames * sizeof(DWORD));
+        pFunc = RVA(base, file_size, nt_header, export_directory->AddressOfFunctions, export_directory->NumberOfFunctions * sizeof(DWORD));
+        pOrdl = RVA(base, file_size, nt_header, export_directory->AddressOfNameOrdinals, export_directory->NumberOfNames * sizeof(WORD));
+
+        funcs = calloc( export_directory->NumberOfFunctions, sizeof(*funcs) );
+        for (i = 0; i < export_directory->NumberOfNames; i++) funcs[pOrdl[i]] = pName[i];
+
+        get_module_name(target_forward_name, module_name);
+
+        /* Reserve space for . and \0 */
+        forward_name_size = ( strlen(module_name) + 2) * export_names_count;
+        for (i = 0; i < export_names_count; i++)
+        {
+            forward_name_size += strlen(export_names[i]);
+        }
+
+        forward_name = HeapCreate(0, forward_name_size, forward_name_size);
+        forward_name_offset = HeapCreate(0, sizeof(UINT) * export_names_count, sizeof(UINT) * export_names_count);
+
+        forward_name_pos = 0;
+        for (i = 0; i < export_names_count; i++)
+        {
+            size_t size = strlen(module_name) + 2 + strlen(export_names[i]);
+            snprintf((char *)forward_name + forward_name_pos, size, "%s.%s", module_name, export_names[i]);
+            ((char *)forward_name_offset)[i] = forward_name_pos;
+            forward_name_pos += size;
+        }
+
+        last_name_start = RVA(base, file_size, nt_header, pName[export_directory->NumberOfNames - 1], 1);
+        last_name_end = (char *)last_name_start + strlen((char *)last_name_start);
+
+        /* Find empty space to place forward strings */
+        choose_pos = last_name_end + 1 + 0x20;
+
+        SetFilePointer(hfile, (char *)choose_pos - (char *)base, NULL, FILE_BEGIN);
+        SetLastError(0xdeadbeef);
+        ret = WriteFile(hfile, forward_name, forward_name_size, &out_len, NULL);
+        ok(ret && forward_name_size == out_len, "ret %d expect write size %ld, but write %ld error %ld\n",
+            ret, forward_name_size, out_len, GetLastError());
+
+        for (i = 0; i < export_names_count; i++)
+        {
+            char *addr = (char *)choose_pos + ((char *)forward_name_offset)[i];
+            DWORD pfunc_pos = AddrToRVA(base, nt_header, addr);
+
+            SetFilePointer(hfile, (char *)&pFunc[i] - (char *)base, NULL, FILE_BEGIN);
+            SetLastError(0xdeadbeef);
+            ret = WriteFile(hfile, &pfunc_pos, sizeof(pfunc_pos), &out_len, NULL);
+            ok(ret && sizeof(pfunc_pos) == out_len, "ret %d expect write size %Iu, but write %ld error %ld\n",
+                ret, sizeof(pfunc_pos), out_len, GetLastError());
+        }
+
+        HeapFree((HANDLE)forward_name_offset, 0, 0);
+        HeapFree(forward_name, 0, 0);
+    }
+
+    ret = CloseHandle( hfile );
+    ok( ret, "%lu\n", GetLastError() );
+
+    HeapFree(base, 0, 0);
+    return TRUE;
+}
