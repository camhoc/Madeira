+static BOOL has_circular_forward( const forward_stack *stack, const char *forward )
+{
+    forward_stack *elem;
+
+    LIST_FOR_EACH_ENTRY_REV(elem, &stack->entry, forward_stack, entry)
+    {
+        if (elem->forward == forward) {
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
