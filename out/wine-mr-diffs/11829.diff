--- server/symlink.c
+++ server/symlink.c
@@ -73,6 +73,16 @@ static const struct object_ops symlink_ops =
     .destroy     = symlink_destroy,
 };
 
+/* retrieve a symlink's target, or NULL if the object is not a symlink */
+const WCHAR *get_symlink_target( struct object *obj, data_size_t *len )
+{
+    struct symlink *symlink = (struct symlink *)obj;
+
+    if (obj->ops != &symlink_ops) return NULL;
+    *len = symlink->len;
+    return symlink->target;
+}
