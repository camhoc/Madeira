# winemac: replace hidden cursor with transparent cursor
# https://gitlab.winehq.org/wine/wine/-/merge_requests/11880 state=opened
# On macOS 26, moving the mouse while the native cursor is hidden can cause frame presentation to synchronize with the display refresh rate, even when VSync is disabled. In Overwatch, for example, the frame rate can drop from 250–300 FPS to 120 FPS, the refresh rate of the built-in display, whenever the mouse moves.

Using a transparent cursor instead of calling `[NSCursor hide]` avoids this hidden-cursor synchronization path while keeping the cursor visually hidden.

A demonstration of the problem is available in this

https://www.reddit.com/r/macgaming/comments/1umok4l/the_game_runs_a_stable_250300fps_but_as_soon_as_i/
--- dlls/winemac.drv/cocoa_app.h
+++ dlls/winemac.drv/cocoa_app.h
@@ -85,7 +85,6 @@ @interface WineApplicationController : NSObject <NSApplicationDelegate>
     NSTimer*    cursorTimer;
     NSCursor*   cursor;
     BOOL        cursorIsCurrent;
-    BOOL        cursorHidden;
     BOOL        clientWantsCursorHidden;
 
     NSTimeInterval lastSetCursorPositionTime;

--- dlls/winemac.drv/cocoa_app.m
+++ dlls/winemac.drv/cocoa_app.m
@@ -73,6 +73,21 @@ - (BOOL)activateFromApplication:(NSRunningApplication *)application
 }
 
 
+static NSCursor* WineTransparentCursor(void)
+{
+    static NSCursor* transparentCursor;
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        NSImage* image = [[NSImage alloc] initWithSize:NSMakeSize(1, 1)];
+        transparentCursor = [[NSCursor alloc] initWithImage:image hotSpot:NSZeroPoint];
+        [image release];
+    });
+
+    return transparentCursor;
+}
+
+
