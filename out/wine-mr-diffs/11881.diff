+static WORD hatswitch_to_xinput_buttons(ULONG value, const HIDP_VALUE_CAPS *caps) {
+    if (value < caps->LogicalMin || value > caps->LogicalMax) {
+        // NULL value when outside of range
+        return 0;
+    }
+
+    if (caps->LogicalMax - caps->LogicalMin == 7) {
+        // would map both [0, 7], [1, 8] encoding to [1, 8] (see: xinput_report_desc)
+        return value - caps->LogicalMin + 1;
+    }
+
+    WARN("HidP_GetUsageValue hatswitch should have 8 values range, but has %lu..=%lu", caps->LogicalMin, caps->LogicalMax);
+    return 0;
+}
