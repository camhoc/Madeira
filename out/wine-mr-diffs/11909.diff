+static void test_loadkeyboardlayout_process(void)
+{
+    static const WCHAR test_layout_name[] = L"00000429";
+    static const HKL test_hkl = (HKL)0x04290429;
+    HANDLE start, end;
+    HKL *layouts, *layouts2, hkl;
+    DWORD result;
+    UINT count, count2;
+
+    start = CreateEventA(NULL, FALSE, FALSE, "loadkeyboardlayout_test_start");
+    ok(start != NULL, "CreateEvent failed\n");
+    end = CreateEventA(NULL, FALSE, FALSE, "loadkeyboardlayout_test_end");
+    ok(end != NULL, "CreateEvent failed\n");
+
+    SetEvent( start );
+
+    result = WaitForSingleObject(end, 1000);
+    ok( result == WAIT_OBJECT_0, "Unexpected result %#lx\n", result );
+
+    layouts = get_keyboard_layouts( &count );
+
+    /* There is no refcounting of sorts */
+    hkl = LoadKeyboardLayoutW( test_layout_name, 0 );
+    todo_wine
+    ok_eq( test_hkl, hkl, HKL, "%p" );
+
+    layouts2 = get_keyboard_layouts( &count2 );
+    ok_eq( count, count2, UINT, "%u" );
+    todo_wine
+    ok_eq( test_hkl, layouts2[count2 - 1], HKL, "%p" );
+    ok( !memcmp( layouts, layouts2, count * sizeof(*layouts) ), "keyboard layouts changed\n" );
+    free( layouts2 );
+
+    result = UnloadKeyboardLayout( test_hkl );
+    todo_wine
+    ok( result, "UnloadKeyboardLayout failed, error %lu\n", GetLastError() );
+
+    layouts2 = get_keyboard_layouts( &count2 );
+    todo_wine
+    ok_eq( count, count2 + 1, UINT, "%u" );
+    ok( !memcmp( layouts, layouts2, count2 * sizeof(*layouts) ), "keyboard layouts changed\n" );
+
+    free(layouts2);
+    free(layouts);
+}
+
+static void test_LoadKeyboardLayout( const char * argv0, HKL orig_hkl )
+{
+    static const WCHAR test_layout_name[] = L"00000429";
+    static const HKL test_hkl = (HKL)0x04290429;
+
+    WCHAR klid[KL_NAMELENGTH], value[KL_NAMELENGTH];
+    DWORD ret, type, klid_size, value_size;
+    HKL *layouts2, *layouts, old_hkl, hkl;
+    PROCESS_INFORMATION process_info;
+    STARTUPINFOA startup_info;
+    UINT i, count, count2;
+    char path[MAX_PATH];
+    HANDLE start, end;
+    HKEY hkey;
+
+    old_hkl = GetKeyboardLayout( 0 );
+    ok_ne( 0, old_hkl, HKL, "%p" );
+
+    /* If we are dealing with a testbot setup that is prone to spurious
+     * layout changes, layout activations in this test are likely to
+     * not have the expected effect, invalidating the test assumptions. */
+    if (orig_hkl != old_hkl)
+    {
+        win_skip( "Spurious keyboard layout changed detected (expected: %p got: %p)\n",
+                  orig_hkl, old_hkl );
+        return;
+    }
+
+    layouts = get_keyboard_layouts( &count );
+    for (i = 0; i < count; i++) if (layouts[i] == test_hkl) break;
+    if (i != count)
+    {
+        skip( "Test HKL is already loaded (position %u), skipping tests\n", i );
+        free( layouts );
+        return;
+    }
+
+    start = CreateEventA(NULL, FALSE, FALSE, "loadkeyboardlayout_test_start");
+    ok(start != NULL, "CreateEvent failed\n");
+    end = CreateEventA(NULL, FALSE, FALSE, "loadkeyboardlayout_test_end");
+    ok(end != NULL, "CreateEvent failed\n");
+
+    memset(&startup_info, 0, sizeof(startup_info));
+    startup_info.cb = sizeof(startup_info);
+    startup_info.dwFlags = STARTF_USESHOWWINDOW;
+    startup_info.wShowWindow = SW_SHOWNORMAL;
+
+    sprintf(path, "%s input test_loadkeyboardlayout", argv0);
+    ret = CreateProcessA(NULL, path, NULL, NULL, TRUE, 0, NULL, NULL, &startup_info, &process_info );
+    ok(ret, "CreateProcess \"%s\" failed err %lu.\n", path, GetLastError());
+
+    ret = WaitForSingleObject(start, 1000);
+    ok( ret == WAIT_OBJECT_0, "Unexpected ret %#lx\n", ret );
+
+    hkl = LoadKeyboardLayoutW( test_layout_name, 0 );
+    todo_wine
+    ok_eq( test_hkl, hkl, HKL, "%p" );
+    layouts2 = get_keyboard_layouts( &count2 );
+    todo_wine
+    ok_eq( count + 1, count2, UINT, "%u" );
+    todo_wine
+    ok_eq( test_hkl, layouts2[count2 - 1], HKL, "%p" );
+    ok( !memcmp( layouts2, layouts, count * sizeof(*layouts) ), "keyboard layouts changed\n" );
+    free( layouts2 );
+    free( layouts );
+
+    if (!RegOpenKeyW( HKEY_CURRENT_USER, L"Keyboard Layout\\Substitutes", &hkey ))
+    {
+        i = 0;
+        type = REG_SZ;
+        klid_size = sizeof(klid);
+        value_size = ARRAY_SIZE(value);
+        while (!RegEnumValueW( hkey, i++, value, &value_size, NULL, &type, (void *)&klid, &klid_size ))
+        {
+            klid_size = sizeof(klid);
+            value_size = ARRAY_SIZE(value);
+            ok( wcsicmp( klid, test_layout_name ), "test layout found in the registry\n" );
+        }
+
+        RegCloseKey( hkey );
+    }
+
+    SetEvent( end );
+
+    ok_eq( old_hkl, GetKeyboardLayout( 0 ), HKL, "%p" );
+}
