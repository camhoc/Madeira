# ntdll decrease CPU overhead
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12137 state=opened
# Main reference MR: https://gitlab.winehq.org/wine/wine/-/merge_requests/12024
--- dlls/ntdll/locale.c
+++ dlls/ntdll/locale.c
@@ -685,21 +685,16 @@ LONG WINAPI RtlCompareUnicodeStrings( const WCHAR *s1, SIZE_T len1, const WCHAR
 BOOLEAN WINAPI RtlPrefixUnicodeString( const UNICODE_STRING *s1, const UNICODE_STRING *s2,
                                        BOOLEAN ignore_case )
 {
-    unsigned int i;
-
     if (s1->Length > s2->Length) return FALSE;
     if (ignore_case)
     {
+        unsigned int i;
         for (i = 0; i < s1->Length / sizeof(WCHAR); i++)
             if (casemap( nls_info.UpperCaseTable, s1->Buffer[i] ) !=
                 casemap( nls_info.UpperCaseTable, s2->Buffer[i] )) return FALSE;
+        return TRUE;
     }
-    else
-    {
-        for (i = 0; i < s1->Length / sizeof(WCHAR); i++)
-            if (s1->Buffer[i] != s2->Buffer[i]) return FALSE;
-    }
-    return TRUE;
+    return !memcmp( s1->Buffer, s2->Buffer, s1->Length );
 }
 
 

