+static void get_usb_udev_device_hub_path_and_port(struct udev_device *dev, struct device_desc *desc)
+{
+    struct udev_device *parent;
+    const char *path, *tmp;
+    char tmp_buf[MAX_PATH];
+    unsigned int class;
+    UINT hub_port;
+
+    /*
+     * This returns the last digits of the device sysname. For a "usb_device"
+     * that is not the root hub, these digits represent the port number of the
+     * USB hub that the device is connected to.
+     */
+    if (!(tmp = udev_device_get_sysnum(dev)) || !sscanf(tmp, "%u", &hub_port))
+    {
+        ERR("Failed to get sysnum for USB device.\n");
+        return;
+    }
+
+    if (!(parent = udev_device_get_parent_with_subsystem_devtype(dev, "usb", "usb_device"))
+            || !(tmp = udev_device_get_sysattr_value(parent, "bDeviceClass"))
+            || !(sscanf(tmp, "%02x", &class)))
+    {
+        ERR("Failed to get parent USB device%s.\n", !parent ? "" : " class");
+        return;
+    }
+    else if (class != 0x09)
+    {
+        ERR("Unexpected parent USB device class %02x.\n", class);
+        return;
+    }
+
+    if (!(path = udev_device_get_property_value(parent, "ID_PATH_WITH_USB_REVISION"))
+            && !(path = udev_device_get_property_value(parent, "ID_PATH")))
+    {
+        ERR("Failed to get path for parent USB hub.\n");
+        return;
+    }
+
+    /*
+     * Combine path and VID/PID of parent to uniquely identify a particular
+     * hub at a position in the USB device tree. This also prevents overlap
+     * for USBv2/USBv3 root hubs, which don't export ID_PATH_WITH_USB_REVISION.
+     */
+    snprintf(tmp_buf, sizeof(tmp_buf), "%s-%s", path, udev_device_get_property_value(parent, "PRODUCT"));
+    ntdll_umbstowcs(tmp_buf, strlen(tmp_buf) + 1, desc->path, ARRAY_SIZE(desc->path));
+    desc->index = hub_port;
+}
+
