+static UINT get_device_index(struct sdl_device *dev, struct list **before)
+{
+    struct sdl_device *impl;
+    UINT index = 0;
+
+    *before = NULL;
+
+    /* The device list is sorted, so just increment the index until it doesn't match an index already in the list */
+    LIST_FOR_EACH_ENTRY(impl, &device_list, struct sdl_device, unix_device.entry)
+    {
+        if (impl->vid == dev->vid && impl->pid == dev->pid && impl->axis_offset == 0)
+        {
+            if (impl->idx != index)
+            {
+                *before = &impl->unix_device.entry;
+                break;
+            }
+            index++;
+        }
+    }
+
+    return index;
+}
