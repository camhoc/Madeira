# msvcrt: Use the adjusted exception PC to look up throwing function on ARM64.
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12182 state=closed
# On ARM64 the unwound return address of a function ending with a noreturn call can lie outside its unwind range, so RtlLookupFunctionEntry() returns NULL and cxx_frame_handler() crashes. Use get_exception_pc() like the other lookups, and skip the nested exception check when no function entry is found.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60399
--- dlls/msvcrt/except.c
+++ dlls/msvcrt/except.c
@@ -381,8 +381,7 @@ static DWORD cxx_frame_handler(EXCEPTION_RECORD *rec, ULONG_PTR frame,
     cxx_exception_type *exc_type;
     ULONG_PTR orig_frame = frame;
     ULONG_PTR throw_base;
-    DWORD throw_func_off;
-    void *throw_func;
+    void *throw_func = NULL;
     UINT i, j;
     int unwindlevel = -1;
 
@@ -400,10 +399,18 @@ static DWORD cxx_frame_handler(EXCEPTION_RECORD *rec, ULONG_PTR frame,
         return ExceptionContinueSearch;  /* handle only c++ exceptions */
 
     /* update orig_frame if it's a nested exception */
-    throw_func_off = RtlLookupFunctionEntry(dispatch->ControlPc, &throw_base, NULL)->BeginAddress;
-    throw_func = cxx_rva(throw_func_off, throw_base);
-    TRACE("reconstructed handler pointer: %p\n", throw_func);
-    for (i=descr->tryblock_count; i>0; i--)
+    if (descr->tryblock_count)
+    {
+        RUNTIME_FUNCTION *throw_func_entry = RtlLookupFunctionEntry(dispatch->ControlPc, &throw_base, NULL);
+        if (throw_func_entry)
+        {
+            throw_func = cxx_rva(throw_func_entry->BeginAddress, throw_base);
+            TRACE("reconstructed handler pointer: %p\n", throw_func);
+        }
+        else 
+            WARN("no function entry for %p\n", (void *)dispatch->ControlPc);
+    }
+    for (i=descr->tryblock_count; throw_func && i>0; i--)
     {
         const tryblock_info *tryblock = cxx_rva(descr->tryblock, dispatch->ImageBase);
         tryblock = &tryblock[i-1];

