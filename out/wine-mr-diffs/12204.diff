+static VkColorSpaceKHR wayland_map_surface_colorspace(struct client_surface *client, VkColorSpaceKHR colorspace)
+{
+    struct wayland_client_surface *surface = client ? impl_from_client_surface(client) : NULL;
+    struct wp_image_description_v1 *desc = NULL;
+    VkColorSpaceKHR new = colorspace;
+
+    if (process_wayland.supports_win_scrgb && colorspace == VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT)
+        new = VK_COLOR_SPACE_PASS_THROUGH_EXT;
+    else if (process_wayland.supports_win_pq && colorspace == VK_COLOR_SPACE_HDR10_ST2084_EXT)
+        new = VK_COLOR_SPACE_PASS_THROUGH_EXT;
+
+    TRACE("mapping colorspace %u => %u\n", colorspace, new);
+
+    if (!surface) return new;
+    if (new == colorspace)
+    {
+        wayland_client_surface_attach_image_description(surface, NULL);
+        return colorspace;
+    }
+
+    switch (colorspace)
+    {
+    case VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT:
+        desc = wp_color_manager_v1_create_windows_scrgb(process_wayland.wp_color_manager_v1);
+        break;
+    case VK_COLOR_SPACE_HDR10_ST2084_EXT:
+        desc = wp_color_manager_v1_create_windows_bt2100(process_wayland.wp_color_manager_v1);
+        break;
+    default: break;
+    }
+
+    if (!desc) goto err;
+
+    wayland_client_surface_attach_image_description(surface, desc);
+    wl_display_flush(process_wayland.wl_display);
+    return new;
+
+err:
+    ERR("Failed to configure image description for client surface!\n");
+    return colorspace;
+}
+
 static void wayland_map_instance_extensions(struct vulkan_instance_extensions *extensions)
 {
     if (extensions->has_VK_KHR_win32_surface) extensions->has_VK_KHR_wayland_surface = 1;
@@ -90,6 +132,7 @@ static const struct vulkan_driver_funcs wayland_vulkan_driver_funcs =
 {
     .p_vulkan_surface_create = wayland_vulkan_surface_create,
     .p_get_physical_device_presentation_support = wayland_get_physical_device_presentation_support,
+    .p_map_surface_colorspace = wayland_map_surface_colorspace,
