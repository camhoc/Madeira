+static void test_VkKeyScanEx(void)
+{
+    static const struct
+    {
+        WORD lang;
+        WCHAR character;
+        SHORT expected;
+        BOOL todo;
+    } tests[] =
+    {
+        {0x0409, 'a', 'A'},
+        {0x0409, 'A', 0x0141},
+        {0x0409, '1', '1'},
+        {0x0409, '+', 0x01bb},
+        {0x0409, '*', 0x0138},
+        {0x0409, 0, 0x0332, TRUE},
+        {0x0409, 0x00e9, -1},
+        {0x0409, 0x0800, -1},
+        {0x040c, 0x00e9, '2'},
+        {0x040c, '^', VK_OEM_6, TRUE},
+        {0x040c, 0x00a8, 0x0100 | VK_OEM_6, TRUE},
+        {0x040c, '`', 0x0637, TRUE},
+        {0x040c, 0x0800, -1},
+    };
+    HKL layout = GetKeyboardLayout(0);
+    SHORT ret;
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        if (tests[i].lang != HIWORD(layout)) continue;
+        ret = VkKeyScanExW(tests[i].character, layout);
+        todo_wine_if(tests[i].todo)
+        ok(ret == tests[i].expected, "Layout %p, character %#x: got %#x, expected %#x\n",
+           layout, tests[i].character, (WORD)ret, (WORD)tests[i].expected);
     }
 }
 
