+static UINT map_virtual_key_scan( const KBDTABLES *tables, UINT code, BOOL vsc_to_vk )
+{
+    USHORT vsc2vk[0x300];
+    UINT ret;
+
+    kbd_tables_init_vsc2vk( tables, vsc2vk );
+    if (vsc_to_vk)
+    {
+        if (code >= ARRAY_SIZE(vsc2vk)) return 0;
+        return vsc2vk[code] & 0xff;
+    }
+
+    for (ret = 0; ret < ARRAY_SIZE(vsc2vk); ++ret) if ((vsc2vk[ret] & 0xff) == code) break;
+    if (ret >= ARRAY_SIZE(vsc2vk)) return 0;
+    return ret;
+}
+
+static UINT map_virtual_key_char( const KBDTABLES *tables, UINT code )
+{
+    UINT vk2char[0x100];
+
+    kbd_tables_init_vk2char( tables, vk2char );
+    if (code >= ARRAY_SIZE(vk2char)) return 0;
+    if (code >= 'A' && code <= 'Z') return code;
+    return vk2char[code];
+}
