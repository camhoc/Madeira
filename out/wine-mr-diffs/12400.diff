+static void _test_appcompat_version(DWORD index)
+{
+    RTL_OSVERSIONINFOEXW rtl_version;
+    OSVERSIONINFOEXW version;
+    DWORD status;
+
+    winetest_push_context("%ls", kernel_tests[index].compat_str);
+
+    memset(&version, 0, sizeof(version));
+    version.dwOSVersionInfoSize = sizeof(version);
+    status = GetVersionExW((OSVERSIONINFOW *)&version);
+    ok(!!status, "Unexpected ret %#lx\n", status);
+
+    ok(version.dwMajorVersion == kernel_tests[index].major, "Got unexpected value %lu\n", version.dwMajorVersion);
+    ok(version.dwMinorVersion == kernel_tests[index].minor, "Got unexpected value %lu\n", version.dwMinorVersion);
+    ok(version.dwBuildNumber == kernel_tests[index].build, "Got unexpected value %lu\n", version.dwBuildNumber);
+    ok(version.dwPlatformId == kernel_tests[index].platform_id, "Got unexpected value %lu\n", version.dwPlatformId);
+    ok(!wcscmp(version.szCSDVersion, kernel_tests[index].sp_name), "Got unexpected value %s\n", debugstr_w(version.szCSDVersion));
+    ok(version.wServicePackMajor == kernel_tests[index].sp_major, "Got unexpected value %u\n", version.wServicePackMajor);
+    ok(version.wServicePackMinor == kernel_tests[index].sp_minor, "Got unexpected value %u\n", version.wServicePackMinor);
+    ok(version.wProductType == rtl_tests[index].product_type, "Got unexpected value %#x\n", version.wProductType);
+
+    if (!wcscmp(rtl_tests[index].compat_str, L"WIN95") || !wcscmp(rtl_tests[index].compat_str, L"WIN98"))
+    {
+        winetest_pop_context();
+        return;
+    }
+
+    memset(&rtl_version, 0, sizeof(rtl_version));
+    rtl_version.dwOSVersionInfoSize = sizeof(rtl_version);
+    status = pRtlGetVersion(&rtl_version);
+    ok(!status, "Unexpected ret %#lx\n", status);
+
+    ok(rtl_version.dwMajorVersion == rtl_tests[index].major, "Got unexpected value %lu\n", rtl_version.dwMajorVersion);
+    ok(rtl_version.dwMinorVersion == rtl_tests[index].minor, "Got unexpected value %lu\n", rtl_version.dwMinorVersion);
+    ok(rtl_version.dwBuildNumber == rtl_tests[index].build, "Got unexpected value %lu\n", rtl_version.dwBuildNumber);
+    ok(rtl_version.dwPlatformId == rtl_tests[index].platform_id, "Got unexpected value %lu\n", rtl_version.dwPlatformId);
+    ok(!wcscmp(rtl_version.szCSDVersion, rtl_tests[index].sp_name), "Got unexpected value %s\n", debugstr_w(rtl_version.szCSDVersion));
+    ok(rtl_version.wServicePackMajor == rtl_tests[index].sp_major
+        || broken(!wcslen(rtl_version.szCSDVersion) && rtl_version.wServicePackMajor), "Got unexpected value %u\n", rtl_version.wServicePackMajor);
+    ok(rtl_version.wServicePackMinor == rtl_tests[index].sp_minor, "Got unexpected value %u\n", rtl_version.wServicePackMinor);
+    ok(rtl_version.wProductType == rtl_tests[index].product_type, "Got unexpected value %#x\n", rtl_version.wProductType);
+
+    winetest_pop_context();
+}
