+/**********************************************************************
+ *         set_compat_version
+ *
+ * Add workarounds for different Windows versions.
+ */
+static void apply_compat_workarounds( COMPAT_WINDOWS_VERSION version )
+{
+    switch (version)
+    {
+        case WIN95C:
+        case WIN98C:
+        {
+#ifdef __i386__
+            TRACE("applying workarounds for Windows 9x.\n");
+            RtlAddVectoredExceptionHandler( TRUE, compat_illegal_instruction_handler );
+            break;
+#endif
+        }
+        case WINXPSP2:
+        case WINXPSP3:
+        case VISTARTM:
+        case VISTASP2:
+        case WIN7RTM:
+        case WIN8RTM:
+        default:
+          break;
+        }
+}
+
+/**********************************************************************
+ *         set_compat_version
+ *
+ * Set different reported version when in compat mode.
+ */
+static BOOL set_compat_version( WCHAR *name )
+{
+    DWORD i;
+
+    if (!name || !name[0])
+        return FALSE;
+
+    for (i = 0; i < ARRAY_SIZE(compat_version_names); i++)
+    {
+        if (wcscmp( compat_version_names[i].name, name )) continue;
+        current_version = &compat_version_data[compat_version_names[i].ver];
+        TRACE( "setting compat version %s\n", debugstr_w(compat_version_names[i].name) );
+        apply_compat_workarounds(compat_version_names[i].ver);
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+static BOOL parse_appcompat(void)
+{
+    UNICODE_STRING layersW = RTL_CONSTANT_STRING( L"Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers" );
+    RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE root, key;
+    CHAR buffer[128];
+    WCHAR *wstr;
+    BOOL ret;
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    DWORD size = sizeof(buffer);
+
+    RtlOpenCurrentUser( KEY_ALL_ACCESS, &root );
+    InitializeObjectAttributes( &attr, &layersW, OBJ_CASE_INSENSITIVE, root, NULL );
+
+    ret = FALSE;
+    if (NtOpenKey( &key, KEY_ALL_ACCESS, &attr ))
+        return ret;
+
+    if ((!NtQueryValueKey( key, &params->ImagePathName, KeyValuePartialInformation, buffer, size, &size ))
+                            && info->Type == REG_SZ)
+    {
+        for (wstr = wcstok( (WCHAR *)info->Data, L" " ); wstr; wstr = wcstok( NULL, L" " ))
+        {
+            ret = set_compat_version(wstr);
+            if (ret) break;
+        }
+    }
+
+    NtClose(key);
+    return ret;
+}
 
