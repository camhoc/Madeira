+LONG WINAPI compat_illegal_instruction_handler( struct _EXCEPTION_POINTERS *e )
+{
+    EXCEPTION_RECORD *rec = e->ExceptionRecord;
+    CONTEXT *context = e->ContextRecord;
+
+    if (rec->ExceptionCode != EXCEPTION_PRIV_INSTRUCTION)
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    switch (*(BYTE *)rec->ExceptionAddress)
+    {
+        case 0xfa: /* cli */
+        case 0xfb: /* sti */
+            ++context->Eip;
+            return EXCEPTION_CONTINUE_EXECUTION;
+    }
+
+    return EXCEPTION_CONTINUE_SEARCH;
+}
 
