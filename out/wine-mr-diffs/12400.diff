+static void test_appcompat_version(void)
+{
+    const WCHAR *layersW = L"Software\\Microsoft\\Windows NT\\CurrentVersion\\AppCompatFlags\\Layers";
+    DWORD i, ret;
+    WCHAR name[MAX_PATH];
+    HKEY hkey;
+    char **argv;
+
+    ret = GetModuleFileNameW(NULL, name, MAX_PATH);
+    ok(!!ret, "Unexpected ret %#lx, gle %#lx\n", ret, GetLastError());
+
+    winetest_get_mainargs(&argv);
+
+    for (i = 0; i < ARRAY_SIZE(rtl_tests); i++)
+    {
+        PROCESS_INFORMATION pi;
+        STARTUPINFOA si;
+        char cmdline[MAX_PATH];
+
+#ifndef __i386__
+        if(rtl_tests[i].only_i386)
+        {
+            skip("32bit test.\n");
+            continue;
+        }
+#endif
+
+        ret = RegCreateKeyExW(HKEY_CURRENT_USER, layersW, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &hkey, NULL);
+        ok(!ret, "Unexpected ret %#lx\n", ret);
+
+        ret = RegSetValueExW(hkey, name, 0, REG_SZ, (BYTE *)rtl_tests[i].compat_str, (wcslen(rtl_tests[i].compat_str) + 1) * sizeof(WCHAR));
+        ok(!ret, "Unexpected ret %#lx\n", ret);
+
+        ret = RegFlushKey(hkey);
+        ok(!ret, "Unexpected ret %#lx\n", ret);
+
+        memset(&pi, 0, sizeof(pi));
+        memset(&si, 0, sizeof(si));
+        si.cb = sizeof(si);
+
+        sprintf(cmdline, "%s version appcompat %li", argv[0], i);
+        ret = CreateProcessA(NULL, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi);
+        ok(!!ret || GetLastError() == ERROR_ELEVATION_REQUIRED, "Failed to create child process %s, GetLastError() %ld\n", debugstr_a(cmdline), GetLastError());
+
+        if (GetLastError() == ERROR_ELEVATION_REQUIRED)
+            skip("Tests need elevation.\n");
+        else
+            wait_child_process(&pi);
+
+        RegDeleteValueW(hkey, name);
+        RegCloseKey(hkey);
+    }
+}
