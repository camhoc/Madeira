+static void _test_appcompat_exception_handler( CHAR *version )
+{
+    VOID *vh;
+
+    if (!pRtlAddVectoredExceptionHandler) return;
+
+    vh = pRtlAddVectoredExceptionHandler( FALSE, &compat_exception_handler );
+    ok(!!vh, "failed to register exception handler\n");
+
+    asm("cli");
+    asm("sti");
+
+    pRtlRemoveVectoredExceptionHandler(vh);
+}
