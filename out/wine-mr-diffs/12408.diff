+static NTSTATUS WINAPI User32LoadKeyboardLayout( void *args, ULONG size )
+{
+    UINT64 (CDECL *descriptor)(void);
+    ANSI_STRING entry = RTL_CONSTANT_STRING("KbdLayerDescriptor");
+    const void *tables;
+    UNICODE_STRING str;
+    HMODULE module;
+    NTSTATUS status;
+
+    RtlInitUnicodeString( &str, args );
+    if ((status = LdrLoadDll( L"c:\\windows\\system32", 0, &str, &module ))) return status;
+    if (!(status = LdrGetProcedureAddress( module, &entry, 0, (void **)&descriptor )))
+    {
+        if (!(tables = (void *)(UINT_PTR)descriptor())) status = STATUS_INVALID_PARAMETER;
+        else status = LdrAddRefDll( LDR_ADDREF_DLL_PIN, module );
+    }
+    LdrUnloadDll( module );
+    if (status) return status;
+    return NtCallbackReturn( &tables, sizeof(tables), STATUS_SUCCESS );
+}
