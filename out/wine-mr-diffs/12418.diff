+static HRESULT hid_joystick_poll( IDirectInputDevice8W *iface )
+{
+    struct hid_joystick *impl = impl_from_IDirectInputDevice8W( iface );
+
+    if (WaitForSingleObject( impl->base.read_event, 0 ) != WAIT_OBJECT_0)
+        return DI_NOEFFECT;
+
+    EnterCriticalSection( &impl->base.crit );
+    if (impl->base.status == STATUS_ACQUIRED && FAILED(hid_joystick_read( iface )))
+    {
+        hid_joystick_unacquire( iface );
+        impl->base.status = STATUS_UNPLUGGED;
+        LeaveCriticalSection( &impl->base.crit );
+        dinput_hooks_unacquire_device( iface );
+        return DIERR_INPUTLOST;
+    }
+    if (impl->base.status == STATUS_UNPLUGGED)
+    {
+        LeaveCriticalSection( &impl->base.crit );
+        return DIERR_INPUTLOST;
+    }
+    LeaveCriticalSection( &impl->base.crit );
+
+    return DI_NOEFFECT;
+}
