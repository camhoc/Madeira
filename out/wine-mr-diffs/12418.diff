# dinput: Check for pending device reads in Poll()
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12418 state=opened
# When a HID joystick is unplugged while acquired, its pending overlapped ReadFile completes and signals read_event, but the device status is only updated to STATUS_UNPLUGGED asynchronously on the worker thread. If GetDeviceState(), GetDeviceData(), or Poll() is called before the worker thread wakes up and processes read_event, the device still appears acquired.

Check read_event in hid_joystick_poll() and re-check the device status
after polling in dinput_device_GetDeviceData().

This also fixes the occasionally flaky test_input_lost() test.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60579
--- dlls/dinput/tests/hotplug.c
+++ dlls/dinput/tests/hotplug.c
@@ -110,6 +110,37 @@ static void check_interface_( unsigned int line, void *iface_ptr, REFIID iid, BO
     if (SUCCEEDED(hr)) IUnknown_Release( unk );
 }
 
+static HANDLE hook_start_event, hook_ready_event, hook_done_event;
+
+static LRESULT CALLBACK mouse_ll_hook_proc( int code, WPARAM wparam, LPARAM lparam )
+{
+    if (code == HC_ACTION && wparam == WM_MOUSEWHEEL)
+    {
+        SetEvent( hook_ready_event );
+        WaitForSingleObject( hook_done_event, 5000 );
+        return 1;
+    }
+    return CallNextHookEx( NULL, code, wparam, lparam );
+}
+
+static DWORD WINAPI mouse_ll_hook_thread( void *arg )
+{
+    HHOOK hook;
+    DWORD ret;
+
+    hook = SetWindowsHookExW( WH_MOUSE_LL, mouse_ll_hook_proc, GetModuleHandleW( NULL ), 0 );
+    ok( !!hook, "SetWindowsHookExW failed, error %lu\n", GetLastError() );
+    SetEvent( hook_ready_event );
+
+    ret = WaitForSingleObject( hook_start_event, 5000 );
+    ok( !ret, "WaitForSingleObject returned %#lx\n", ret );
+
+    mouse_event( MOUSEEVENTF_WHEEL, 0, 0, 0, 0 );
+
+    UnhookWindowsHookEx( hook );
+    return 0;
+}
