     test_security_cookie_readonly();
     test_import_resolution();
     test_export_forwarder_dep_chain();
+    test_export_forwarder_loop();
     test_ExitProcess();
     test_InMemoryOrderModuleList();
     test_LoadPackagedLibrary();

