# ntdll: Follow at most 32 export forwarders.
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12434 state=merged
# A DLL whose export forwards to itself makes GetProcAddress() recurse in find_forwarded_export() until the stack overflows,same thing happens with two DLLs forwarding to each other.
from what i found on Windows, GetProcAddress() returns NULL with ERROR_BAD_EXE_FORMAT.

To find out how Windows handles this, I ran probe tests on the TestBot (Windows 8.1, 10 and 11, 32- and 64-bit: [32-bit](https://testbot.winehq.org/JobDetails.pl?Key=164843), [32- and 64-bit](https://testbot.winehq.org/JobDetails.pl?Key=164844)). They show that Windows limits the forward depth to 32, a chain of 32 forwards across DLLs resolves, while a chain of 33 fails with (STATUS_INVALID_IMAGE_FORMAT), and a self-forward or a two-DLL loop fails the same way once it reaches that depth. This MR makes Wine do the same ([TestBot run of this MR's test](https://testbot.winehq.org/JobDetails.pl?Key=164845)).

It passes a forward depth through find_named_export(), find_ordinal_export() and find_forwarded_export(), stops after 32 forwards, and reports STATUS_INVALID_IMAGE_FORMAT from LdrGetProcedureAddress().

The test reuses gen_forward_chain_testdll(). It checks that a self-forwarding DLL and a chain of 33 forwards fail with ERROR_BAD_EXE_FORMAT, and that a chain of 32 forwards resolves to the target function.

Wine-Bug: https://bugs.winehq.org/show_bug.cgi?id=60130
--- dlls/kernel32/tests/loader.c
+++ dlls/kernel32/tests/loader.c
@@ -3070,6 +3070,52 @@ static void test_export_forwarder_dep_chain(void)
     winetest_pop_context();
 }
 
+static void test_export_forwarder_loop(void)
+{
+    char path[MAX_PATH], prev_path[MAX_PATH], loop_path[MAX_PATH];
+    HMODULE modules[34], module;
+    HANDLE files[34], file;
+    FARPROC proc;
+    unsigned int i;
+    BOOL ret;
+
+    /* A module forwarding an export to itself. */
+    GetTempPathA( ARRAY_SIZE(loop_path), loop_path );
+    strcat( loop_path, "fwdloop.dll" );
+    file = gen_forward_chain_testdll( path, loop_path, TRUE, FALSE, NULL, NULL );
+    ret = CopyFileA( path, loop_path, FALSE );
+    ok( ret, "CopyFile failed, error %lu.\n", GetLastError() );
+    module = LoadLibraryA( loop_path );
+    ok( !!module, "LoadLibrary failed, error %lu.\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    proc = GetProcAddress( module, "forward_test_func" );
+    ok( !proc, "Got %p.\n", proc );
+    ok( GetLastError() == ERROR_BAD_EXE_FORMAT, "Got error %lu.\n", GetLastError() );
+    FreeLibrary( module );
+    DeleteFileA( loop_path );
+    CloseHandle( file );
+
+    /* At most 32 forwards are followed. */
+    for (i = 0; i < ARRAY_SIZE(modules); i++)
+    {
+        files[i] = gen_forward_chain_testdll( path, i ? prev_path : NULL, TRUE, FALSE, NULL, NULL );
+        modules[i] = LoadLibraryA( path );
+        strcpy( prev_path, path );
+        ok( !!modules[i], "LoadLibrary failed, error %lu.\n", GetLastError() );
+    }
+    proc = GetProcAddress( modules[32], "forward_test_func" );
+    ok( proc == (FARPROC)((char *)modules[0] + page_size + 0x4), "Got %p.\n", proc );
+    SetLastError( 0xdeadbeef );
+    proc = GetProcAddress( modules[33], "forward_test_func" );
+    ok( !proc, "Got %p.\n", proc );
+    ok( GetLastError() == ERROR_BAD_EXE_FORMAT, "Got error %lu.\n", GetLastError() );
+    for (i = 0; i < ARRAY_SIZE(modules); i++)
+    {
+        FreeLibrary( modules[i] );
+        CloseHandle( files[i] );
+    }
+}
+
 #define MAX_COUNT 10
 static HANDLE attached_thread[MAX_COUNT];
 static DWORD attached_thread_count;
