# server, win32u, winex11: Fix sibling clipping during offscreen presentation and empty surface regions
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12493 state=opened
# This patch series fixes window surface and sibling clipping issues when combining GDI presentation with GPU-accelerated offscreen surfaces.

On modern Windows, surfaces rendered via DirectX or Vulkan are composited on the GPU by the Desktop Window Manager (DWM) in layer order, so applications do not set WS_CLIPSIBLINGS across window hierarchy. In Wine, presenting these offscreen client surfaces to a shared X11 window using GDI blits without sibling clipping causes overlapping windows to alternate over each other. Additionally, GDI flushes on parent window surfaces could overwrite 3D child surfaces when covered by custom pixel-format windows.

This series resolves these issues by ensuring empty clip regions are properly honored on window surfaces and emulating DWM layer composition for GPU client surfaces during presentation. eliminates the severe window flickering and content overwrites seen in GPU-accelerated multi-process applications, such as Steam with DXVK/Vulkan.
--- dlls/win32u/dce.c
+++ dlls/win32u/dce.c
@@ -1280,6 +1280,7 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
 
     if (flags & DCX_USESTYLE)
     {
+        DWORD explicit_flags = flags & DCX_CLIPSIBLINGS;
         flags &= ~(DCX_CLIPCHILDREN | DCX_CLIPSIBLINGS | DCX_PARENTCLIP);
 
         if (window_style & WS_CLIPSIBLINGS) flags |= DCX_CLIPSIBLINGS;
@@ -1291,6 +1292,7 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
             if (window_style & WS_CLIPCHILDREN && !(window_style & WS_MINIMIZE))
                 flags |= DCX_CLIPCHILDREN;
         }
+        flags |= explicit_flags;
     }
 
     if (flags & DCX_WINDOW) flags &= ~DCX_CLIPCHILDREN;

