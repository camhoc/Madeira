-        if (surface->offscreen) hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_USESTYLE );
+        if (surface->offscreen)
+        {
+            DWORD flags = DCX_CACHE | DCX_USESTYLE;
+            /* Emulate DWM layer composition for GPU surfaces */
