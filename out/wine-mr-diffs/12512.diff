# ntdll: Keep the SEH handlers that only asm refers to under LTO
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12512 state=opened
# The unwind info for the exception code names nested_exception_handler, unwind_exception_handler, user_callback_handler and call_unhandled_exception_handler from .seh_handler directives in module level asm. The compiler does not count that as a use, so when the PE modules are built with clang and LTO the functions are removed as dead and ntdll fails to link with undefined symbols. Marking them used fixes it. signal_arm64ec.c already uses __attribute__((used)) for functions that only asm calls

I tested this on x86_64 with clang and thin LTO, where ntdll now links with no files excluded from LTO. The Arm and Arm64 changes are the same edit and I have not built them
--- dlls/ntdll/exception.c
+++ dlls/ntdll/exception.c
@@ -311,8 +311,8 @@ NTSTATUS WINAPI dispatch_exception( EXCEPTION_RECORD *rec, CONTEXT *context )
  *
  * Exception handler for KiUserCallbackDispatcher.
  */
-EXCEPTION_DISPOSITION WINAPI user_callback_handler( EXCEPTION_RECORD *record, void *frame,
-                                                    CONTEXT *context, void *dispatch )
+EXCEPTION_DISPOSITION WINAPI __attribute__((used)) user_callback_handler( EXCEPTION_RECORD *record, void *frame,
+                                                                          CONTEXT *context, void *dispatch )
 {
     if (!(record->ExceptionFlags & (EXCEPTION_UNWINDING | EXCEPTION_EXIT_UNWIND)))
     {
@@ -447,8 +447,8 @@ LONG WINAPI call_unhandled_exception_filter( PEXCEPTION_POINTERS eptr )
 /*******************************************************************
  *         call_unhandled_exception_handler
  */
-EXCEPTION_DISPOSITION WINAPI call_unhandled_exception_handler( EXCEPTION_RECORD *rec, void *frame,
-                                                               CONTEXT *context, void *dispatch )
+EXCEPTION_DISPOSITION WINAPI __attribute__((used)) call_unhandled_exception_handler( EXCEPTION_RECORD *rec, void *frame,
+                                                                                     CONTEXT *context, void *dispatch )
 {
     EXCEPTION_POINTERS ep = { rec, context };
 

