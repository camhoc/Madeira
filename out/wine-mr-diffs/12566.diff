+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#import "config.h"
+#import "macdrv.h"
+
+#include <AvailabilityMacros.h>
+#ifdef MAC_OS_VERSION_11_0
+#import <AppKit/AppKit.h>
+#import <GameController/GameController.h>
+
+
+static NSMutableSet<GCMouse *> *configured_mice;
+
+
+static void configure_mouse(GCMouse *mouse)
+{
+    __block float remainder_x = 0, remainder_y = 0;
+    GCMouseInput *input;
+
+    if (!mouse || [configured_mice containsObject:mouse]) return;
+
+    if (!(input = [mouse mouseInput])) return;
+
+    [input setMouseMovedHandler:^(GCMouseInput *input, float delta_x, float delta_y) {
+        struct raw_mouse raw;
+
+        remainder_x += delta_x;
+        remainder_y -= delta_y;
+        raw.data[0].x = remainder_x;
+        raw.data[0].y = remainder_y;
+        remainder_x -= raw.data[0].x;
+        remainder_y -= raw.data[0].y;
+
+        raw.count = 1;
+        macdrv_send_mouse_input(NULL, 0, 0, 0, 0, NtGetTickCount(), &raw);
+    }];
+
+    [configured_mice addObject:mouse];
+}
+
+
+static void remove_mouse(GCMouse *mouse)
+{
+    if (!mouse || ![configured_mice containsObject:mouse]) return;
+
+    [[mouse mouseInput] setMouseMovedHandler:nil];
+    [configured_mice removeObject:mouse];
+}
+
+
+static void start_gcmouse_input(void)
+{
+    NSNotificationCenter *center;
+    GCMouse *mouse;
+
+    if (@available(macOS 14.0, *))
+    {
+        center = [NSNotificationCenter defaultCenter];
+        configured_mice = [[NSMutableSet alloc] init];
+
+        [center addObserverForName:GCMouseDidConnectNotification
+                            object:nil
+                             queue:nil
+                        usingBlock:^(NSNotification *notification) {
+            configure_mouse([notification object]);
+        }];
+        [center addObserverForName:GCMouseDidDisconnectNotification
+                            object:nil
+                             queue:nil
+                        usingBlock:^(NSNotification *notification) {
+            remove_mouse([notification object]);
+        }];
+
+        for (mouse in [GCMouse mice])
+            configure_mouse(mouse);
+    }
+}
+
+#endif
+
+void macdrv_start_gcmouse_input(void)
+{
+#ifdef MAC_OS_VERSION_11_0
+    dispatch_async(dispatch_get_main_queue(), ^{ start_gcmouse_input(); });
+#endif
+}
+
+
+bool macdrv_gcmouse_input_active(void)
+{
+#ifdef MAC_OS_VERSION_11_0
+    return [configured_mice count] != 0;
+#else
+    return false;
+#endif
+}

