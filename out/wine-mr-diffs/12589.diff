# crypt32: Don't close the certificate file twice.
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12589 state=merged
# import_certs_from_file() closes the descriptor with fclose(), and import_certs_from_path() then closes it once more. If another thread has been given the same descriptor number in the meantime, that descriptor is closed instead, for instance the pipe of a thread to the wineserver.

This looks like the cause of the mshtml:misc hangs in the CI (test-linux-32): the test prints nothing and is killed after 120 s. 

mshtml:misc loads an https page, so the root store is initialized while Gecko starts its threads. strace in the CI image shows close(N) = 0 followed by close(N) = -1 EBADF for the certificate bundle; with the patch there is a single close.
--- dlls/crypt32/unixlib.c
+++ dlls/crypt32/unixlib.c
@@ -832,16 +832,14 @@ static BOOL base64_to_cert( const char *str )
     return TRUE;
 }
 
-/* Reads the file fd, and imports any certificates in it into store. */
-static void import_certs_from_file( int fd )
+/* Reads the file fp, and imports any certificates in it into store. */
+static void import_certs_from_file( FILE *fp )
 {
-    FILE *fp = fdopen(fd, "r");
     char line[1024];
     BOOL in_cert = FALSE;
     struct DynamicBuffer saved_cert = { 0, 0, NULL };
     int num_certs = 0;
 
-    if (!fp) return;
     TRACE("\n");
     while (fgets(line, sizeof(line), fp))
     {
@@ -864,7 +862,6 @@ static void import_certs_from_file( int fd )
     }
     free( saved_cert.data );
     TRACE("Read %d certs\n", num_certs);
-    fclose(fp);
 }
 
 static void import_certs_from_path(LPCSTR path, BOOL allow_dir);
@@ -919,19 +916,19 @@ static void import_certs_from_dir( LPCSTR path )
  */
 static void import_certs_from_path(LPCSTR path, BOOL allow_dir)
 {
-    int fd;
+    FILE *fp;
 
     TRACE("(%s, %d)\n", debugstr_a(path), allow_dir);
 
-    fd = open(path, O_RDONLY);
-    if (fd != -1)
+    fp = fopen(path, "r");
+    if (fp)
     {
         struct stat st;
 
-        if (fstat(fd, &st) == 0)
+        if (fstat(fileno(fp), &st) == 0)
         {
             if (S_ISREG(st.st_mode))
-                import_certs_from_file(fd);
+                import_certs_from_file(fp);
             else if (S_ISDIR(st.st_mode))
             {
                 if (allow_dir)
@@ -943,7 +940,7 @@ static void import_certs_from_path(LPCSTR path, BOOL allow_dir)
             else
                 ERR("%s: invalid file type\n", path);
         }
-        close(fd);
+        fclose(fp);
     }
 }
 

