+/******************************************************************************
+ * GetSecurityDescriptorRMControl    (kernelbase.@)
+ */
+DWORD WINAPI GetSecurityDescriptorRMControl( PSECURITY_DESCRIPTOR descr, PUCHAR rm_control )
+{
+    TRACE( "(%p, %p)\n", descr, rm_control );
+
+    if (!RtlGetSecurityDescriptorRMControl( descr, rm_control ))
+        return ERROR_INVALID_DATA;
+    return ERROR_SUCCESS;
+}
+
 /******************************************************************************
  *  GetSecurityDescriptorSacl    (kernelbase.@)
  */
@@ -1228,6 +1240,17 @@ BOOL WINAPI SetSecurityDescriptorOwner( PSECURITY_DESCRIPTOR descr, PSID owner,
     return set_ntstatus( RtlSetOwnerSecurityDescriptor( descr, owner, defaulted ));
 }
 
+/******************************************************************************
+ * SetSecurityDescriptorRMControl    (kernelbase.@)
+ */
+DWORD WINAPI SetSecurityDescriptorRMControl( PSECURITY_DESCRIPTOR descr, PUCHAR rm_control )
+{
+    TRACE( "(%p, %p)\n", descr, rm_control );
+
+    RtlSetSecurityDescriptorRMControl( descr, rm_control );
+    return ERROR_SUCCESS;
+}
+
