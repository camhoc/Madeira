+/**************************************************************************
+ * RtlGetSecurityDescriptorRMControl		[NTDLL.@]
+ */
+UCHAR WINAPI RtlGetSecurityDescriptorRMControl( PSECURITY_DESCRIPTOR descr, PUCHAR rm_control )
+{
+    SECURITY_DESCRIPTOR *lpsd = descr;
+
+    TRACE( "(%p, %p)\n", descr, rm_control );
+
+    if (!(lpsd->Control & SE_RM_CONTROL_VALID))
+    {
+        *rm_control = 0;
+        return 0;
+    }
+
+    *rm_control = lpsd->Sbz1;
+    return 1;
+}
+
+/**************************************************************************
+ * RtlSetSecurityDescriptorRMControl		[NTDLL.@]
+ */
+void WINAPI RtlSetSecurityDescriptorRMControl( PSECURITY_DESCRIPTOR descr, PUCHAR rm_control )
+{
+    SECURITY_DESCRIPTOR *lpsd = descr;
+
+    TRACE( "(%p, %p)\n", descr, rm_control );
+
+    if (rm_control)
+    {
+        lpsd->Control |= SE_RM_CONTROL_VALID;
+        lpsd->Sbz1 = *rm_control;
+    }
+    else
+    {
+        lpsd->Control &= ~SE_RM_CONTROL_VALID;
+        lpsd->Sbz1 = 0;
+    }
+}
+
