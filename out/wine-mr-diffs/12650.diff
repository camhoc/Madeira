+static void test_security_descriptor_rm_control(void)
+{
+    SECURITY_DESCRIPTOR sd;
+    UCHAR rm, set_rm;
+    DWORD ret;
+    BOOL b_ret;
+
+    if (!pGetSecurityDescriptorRMControl || !pSetSecurityDescriptorRMControl)
+    {
+        win_skip("GetSecurityDescriptorRMControl or SetSecurityDescriptorRMControl not available.\n");
+        return;
+    }
+
+    b_ret = InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION);
+    ok(b_ret, "InitializeSecurityDescriptor failed, error %lu\n", GetLastError());
+
+    /* Before RMControl is set, SE_RM_CONTROL_VALID is not present */
+    rm = 0x55;
+    ret = pGetSecurityDescriptorRMControl(&sd, &rm);
+    ok(ret == ERROR_INVALID_DATA, "expected ERROR_INVALID_DATA, got %lu\n", ret);
+    ok(rm == 0, "expected rm 0, got %#x\n", rm);
+
+    /* Setting RMControl should set SE_RM_CONTROL_VALID and the control byte */
+    set_rm = 0x42;
+    ret = pSetSecurityDescriptorRMControl(&sd, &set_rm);
+    ok(ret == ERROR_SUCCESS, "SetSecurityDescriptorRMControl failed, error %lu\n", ret);
+
+    rm = 0;
+    ret = pGetSecurityDescriptorRMControl(&sd, &rm);
+    ok(ret == ERROR_SUCCESS, "GetSecurityDescriptorRMControl failed, error %lu\n", ret);
+    ok(rm == 0x42, "expected rm 0x42, got %#x\n", rm);
+
+    /* Setting NULL clears SE_RM_CONTROL_VALID */
+    ret = pSetSecurityDescriptorRMControl(&sd, NULL);
+    ok(ret == ERROR_SUCCESS, "SetSecurityDescriptorRMControl(NULL) failed, error %lu\n", ret);
+
+    rm = 0x55;
+    ret = pGetSecurityDescriptorRMControl(&sd, &rm);
+    ok(ret == ERROR_INVALID_DATA, "expected ERROR_INVALID_DATA, got %lu\n", ret);
+    ok(rm == 0, "expected rm 0, got %#x\n", rm);
+}
+
