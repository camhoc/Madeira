# ntoskrnl: Implement KeTryToAcquireGuardedMutex and ExTryToAcquireFastMutex
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12651 state=closed
# ### Summary

This series implements `KeTryToAcquireGuardedMutex` and `ExTryToAcquireFastMutex` in `ntoskrnl.exe`, adds their missing declarations in `ddk/wdm.h`, and adds unit test coverage in `driver.c`.

### Application / Game Context

Required by kernel drivers such as AntiCheatExpert (ACE) used by games like _Duet Night Abyss_ and _Arknights: Endfield_. When launching these games under Wine/Proton, the driver calls `KeTryToAcquireGuardedMutex` during initialization and immediately crashes with: `wine: Call from ... to unimplemented function ntoskrnl.exe.KeAcquireGuardedMutex / KeTryToAcquireGuardedMutex, aborting`

Reference: https://github.com/ValveSoftware/Proton/issues/9331 (also #8988, #9258)
--- dlls/ntoskrnl.exe/tests/driver.c
+++ dlls/ntoskrnl.exe/tests/driver.c
@@ -1012,6 +1012,53 @@ static void test_sync(void)
 
     run_thread(mutex_thread, (void *)0);
 
+    /* test guarded mutex */
+    {
+        KGUARDED_MUTEX guarded_mutex;
+        BOOLEAN success;
+
+        KeInitializeGuardedMutex(&guarded_mutex);
+        ok(guarded_mutex.Count == FM_LOCK_BIT, "got %ld\n", guarded_mutex.Count);
+
+        success = KeTryToAcquireGuardedMutex(&guarded_mutex);
+        ok(success, "KeTryToAcquireGuardedMutex failed\n");
+        ok(guarded_mutex.Count == 0, "got %ld\n", guarded_mutex.Count);
+
+        success = KeTryToAcquireGuardedMutex(&guarded_mutex);
+        ok(!success, "KeTryToAcquireGuardedMutex succeeded unexpectedly\n");
+
+        KeReleaseGuardedMutex(&guarded_mutex);
+        ok(guarded_mutex.Count == FM_LOCK_BIT, "got %ld\n", guarded_mutex.Count);
+
+        KeAcquireGuardedMutex(&guarded_mutex);
+        ok(guarded_mutex.Count == 0, "got %ld\n", guarded_mutex.Count);
+
+        success = KeTryToAcquireGuardedMutex(&guarded_mutex);
+        ok(!success, "KeTryToAcquireGuardedMutex succeeded unexpectedly\n");
+
+        KeReleaseGuardedMutex(&guarded_mutex);
+        ok(guarded_mutex.Count == FM_LOCK_BIT, "got %ld\n", guarded_mutex.Count);
+    }
+
+    /* test fast mutex */
+    {
+        FAST_MUTEX fast_mutex;
+        BOOLEAN success;
+
+        ExInitializeFastMutex(&fast_mutex);
+        ok(fast_mutex.Count == FM_LOCK_BIT, "got %ld\n", fast_mutex.Count);
+
+        success = ExTryToAcquireFastMutex(&fast_mutex);
+        ok(success, "ExTryToAcquireFastMutex failed\n");
+        ok(fast_mutex.Count == 0, "got %ld\n", fast_mutex.Count);
+
+        success = ExTryToAcquireFastMutex(&fast_mutex);
+        ok(!success, "ExTryToAcquireFastMutex succeeded unexpectedly\n");
+
+        ExReleaseFastMutex(&fast_mutex);
+        ok(fast_mutex.Count == FM_LOCK_BIT, "got %ld\n", fast_mutex.Count);
+    }
+
     /* test timers */
     KeInitializeTimerEx(&timer, NotificationTimer);
 

