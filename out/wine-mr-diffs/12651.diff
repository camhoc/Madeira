     /* FIXME: Leave Guarded Region */
 }
 
+/***********************************************************************
+ *           KeTryToAcquireGuardedMutex   (NTOSKRNL.EXE.@)
+ */
+DEFINE_FASTCALL1_WRAPPER(KeTryToAcquireGuardedMutex)
+BOOLEAN FASTCALL KeTryToAcquireGuardedMutex(PKGUARDED_MUTEX mutex)
+{
+    /* FIXME: Enter Guarded Region */
+    return ExTryToAcquireFastMutex((PFAST_MUTEX)mutex);
+}
+
 static void CALLBACK ke_timer_complete_proc(PTP_CALLBACK_INSTANCE instance, void *timer_, PTP_TIMER tp_timer)
 {
     KTIMER *timer = timer_;
@@ -917,6 +927,21 @@ void WINAPI ExReleaseFastMutex( FAST_MUTEX *mutex )
     /* FIXME: restore IRQL */
 }
 
+/***********************************************************************
+ *           ExTryToAcquireFastMutex    (NTOSKRNL.@)
+ */
+BOOLEAN WINAPI ExTryToAcquireFastMutex( FAST_MUTEX *mutex )
+{
+    TRACE("mutex %p.\n", mutex);
+
+    if (InterlockedCompareExchange( &mutex->Count, 0, FM_LOCK_BIT ) == FM_LOCK_BIT)
+    {
+        /* FIXME: lower IRQL */
+        return TRUE;
+    }
+    return FALSE;
+}
+
 #endif /* __i386__ */
 
