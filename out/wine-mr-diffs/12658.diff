# winemac: Update the clipboard asynchronously on app activation.
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12658 state=merged
# This fixes one of two possible hangs with Diablo 2 Resurrected (maybe there are more, at least these were the ones I could observe). The other one is related to window focus macdrv events (and an MR for it will follow shortly too, but it is a bit more complicated).

The issue is that the games main thread has a SRW lock and wine code paths reenter D2R's window procedure try to acquire that same SRW lock shared (which makes this bug kind of random, since the clipboard event here gets delivered to exactly 1 thread that picks it up first).
--- dlls/winemac.drv/clipboard.c
+++ dlls/winemac.drv/clipboard.c
@@ -1417,9 +1417,9 @@ LRESULT macdrv_ClipboardWindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 
 
 /**************************************************************************
- *              macdrv_UpdateClipboard
+ *              request_clipboard_update
  */
-void macdrv_UpdateClipboard(void)
+static void request_clipboard_update(BOOL wait)
 {
     static ULONG last_update;
     static HWND clipboard_manager;
@@ -1428,7 +1428,7 @@ void macdrv_UpdateClipboard(void)
 
     if (GetCurrentThreadId() == clipboard_thread_id) return;
 
-    TRACE("\n");
+    TRACE("%s\n", wait ? "wait" : "post");
 
     now = NtGetTickCount();
     if (last_update && (int)(now - last_update) <= CLIPBOARD_UPDATE_DELAY) return;
@@ -1444,9 +1444,24 @@ void macdrv_UpdateClipboard(void)
         }
     }
 
-    send_message_timeout(clipboard_manager, WM_USER, 0, 0,
-                         SMTO_ABORTIFHUNG, 5000, &ret);
-    last_update = now;
+    if (wait)
+    {
+        send_message_timeout(clipboard_manager, WM_USER, 0, 0,
+                             SMTO_ABORTIFHUNG, 5000, &ret);
+        last_update = now;
+        return;
+    }
+
+    NtUserPostMessage(clipboard_manager, WM_USER, 0, 0);
+}
+
+
+/**************************************************************************
+ *              macdrv_UpdateClipboard
+ */
+void macdrv_UpdateClipboard(void)
+{
+    request_clipboard_update(TRUE);
 }
 
 
@@ -1455,6 +1470,15 @@ void macdrv_UpdateClipboard(void)
  **************************************************************************/
 
 
+/**************************************************************************
+ *              macdrv_update_clipboard_async
+ */
+void macdrv_update_clipboard_async(void)
+{
+    request_clipboard_update(FALSE);
+}
+
