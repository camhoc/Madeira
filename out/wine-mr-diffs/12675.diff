 #undef NEXT_ENTRY
 
+struct keyboard_layout
+{
+    struct rb_entry entry;
+    UINT klid;            /* MAKELONG(lang, index) */
+    UINT id;              /* globally unique ID */
+
+    char *variant;        /* host layout variant */
+    UINT_PTR host_id;     /* host layout ID, -1 if not loaded */
+};
+
+static const char *debugstr_keyboard_layout( const struct keyboard_layout *layout )
+{
+    const char *host, *variant;
+    if (!layout) return "(null)";
+    host = layout->host_id == -1 ? "(none)" : wine_dbg_sprintf( "%#zx", layout->host_id );
+    variant = layout->variant && *layout->variant ? wine_dbg_sprintf( " (%s)", layout->variant ) : "";
+    return wine_dbg_sprintf( "%08x/%04x host %s%s", layout->klid, layout->id, host, variant );
+}
+
+static pthread_mutex_t keyboard_layouts_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct rb_tree keyboard_layouts;
+static BOOL keyboard_layouts_inited;
+static BOOL keyboard_layouts_loaded;
+
+static int keyboard_layouts_map_cmp(const void *key, const struct rb_entry *entry)
+{
+    int id = HandleToULong(key);
+    struct keyboard_layout *layout = RB_ENTRY_VALUE(entry, struct keyboard_layout, entry);
+
+    if (layout->id) return id - (int)layout->id;
+    return id - (int)LOWORD(layout->klid);
+}
+
+static UINT klid_from_lang( LANGID lang )
+{
+    struct keyboard_layout *layout;
+    UINT index = 0;
+
+    /* make up some new klid that doesn't conflict with the already loaded layouts */
+    RB_FOR_EACH_ENTRY( layout, &keyboard_layouts, struct keyboard_layout, entry )
+    {
+        if (LOWORD(layout->klid) != lang) continue;
+        if (!HIWORD(layout->klid) && layout->host_id == -1) return layout->klid;
+        if (HIWORD(layout->klid) >= 0x20) index++;
+    }
+
+    if (!index) return MAKELONG(lang, 0);
+    return MAKELONG(lang, index + 0x1f);
+}
+
+/* sorted by lang, then by variant */
+static const struct klid_map_entry
+{
+    LANGID lang;
+    const char *variant;
+    UINT klid;
+} klid_map[] =
+{
+    { 0x0409, "dvorak",   0x00010409 },
+    { 0x0409, "dvorak-l", 0x00030409 },
+    { 0x0409, "dvorak-r", 0x00040409 },
+};
+
+static int klid_map_cmp( const void *key, const void *element )
+{
+    const struct klid_map_entry *map_key = key;
+    const struct klid_map_entry *entry = element;
+    int c;
+
+    if ((c = (int)map_key->lang - (int)entry->lang)) return c;
+    return strcmp( map_key->variant, entry->variant );
+}
+
+static DWORD klid_from_lang_variant( LANGID lang, const char *variant )
+{
+    struct klid_map_entry key = { .lang = lang, .variant = variant };
+    const struct klid_map_entry *entry;
+    struct keyboard_layout *layout;
+    UINT index = 0;
+
+    entry = bsearch( &key, klid_map, ARRAY_SIZE(klid_map), sizeof(*klid_map), klid_map_cmp );
+    if (entry) return entry->klid;
+
+    WARN_(keyboard)( "Unknown lang %04x variant %s\n", lang, debugstr_a(variant) );
+
+    /* make up some new klid that doesn't conflict with the known layouts */
+    RB_FOR_EACH_ENTRY( layout, &keyboard_layouts, struct keyboard_layout, entry )
+    {
+        if (LOWORD(layout->klid) != lang) continue;
+        if (layout->variant && !strcmp( layout->variant, variant ))
+        {
+            if (layout->host_id != -1)
+                WARN_(keyboard)( "Duplicate layout %s\n", debugstr_keyboard_layout( layout ) );
+            return layout->klid;
+        }
+        if (HIWORD(layout->klid) >= 0x20) index++;
+    }
+
+    if (!index && !*variant) return MAKELONG(lang, 0);
+    return MAKELONG(lang, index + 0x20);
+}
+
+static void add_keyboard_layout( struct keyboard_layout *layout )
+{
+    ULONG id = layout->id ? layout->id : LOWORD(layout->klid);
+
+    if (rb_put( &keyboard_layouts, ULongToHandle(id), &layout->entry ))
+        ERR_(keyboard)("duplicated layout entry id %04x, klid %08x, layout id %04x\n", id, layout->klid, layout->id);
+}
+
+/* read the predefined keyboard layout list from the registry */
+static void read_keyboard_layouts( HKEY hkey )
+{
+    char buffer[4096];
+    KEY_NODE_INFORMATION *key = (KEY_NODE_INFORMATION *)buffer;
+    KEY_VALUE_PARTIAL_INFORMATION *value = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    struct keyboard_layout *layout;
+    WCHAR name[KL_NAMELENGTH];
+    UINT id, len, next_id = 0x100;
+    HKEY subkey;
+
+    for (UINT i = 0; !NtEnumerateKey( hkey, i, KeyNodeInformation, key, sizeof(buffer) - sizeof(WCHAR), &len ); i++)
+    {
+        if (!(subkey = reg_open_key( hkey, key->Name, key->NameLength ))) continue;
+        memcpy( name, key->Name, key->NameLength );
+        name[key->NameLength / sizeof(WCHAR)] = 0;
+
+        if (!query_reg_ascii_value( subkey, "Layout Id", value, sizeof(buffer) ) || value->Type != REG_SZ) id = 0;
+        else id = (wcstoul( (const WCHAR *)value->Data, NULL, 16 ) & 0xfff) | 0xf000;
+        NtClose( subkey );
+
+        if (!(layout = calloc( 1, sizeof(*layout) ))) break;
+        layout->klid = wcstoul( name, NULL, 16 );
+        if (!id && HIWORD(layout->klid))
+        {
+            if ((HIWORD(layout->klid) & 0xf000) == 0xe000) id = HIWORD(layout->klid);
+            else id = 0xf000 | next_id;
+        }
+        if ((id & 0xfff) >= next_id) next_id = (id & 0xfff) + 1;
+        layout->id = id;
+        layout->host_id = -1;
+        add_keyboard_layout( layout );
+        TRACE_(keyboard)( "Created empty layout %s\n", debugstr_keyboard_layout( layout ) );
+    }
+}
+
+static HKL get_hkl( struct keyboard_layout *layout )
+{
+    LCID locale = LOWORD(layout->klid);
+    if (layout->id) return ULongToHandle(MAKELONG(locale, layout->id));
+    return ULongToHandle(MAKELONG(locale, LOWORD(layout->klid)));
+}
+
+static struct keyboard_layout *get_keyboard_layout_from_klid( UINT klid, UINT *next_id )
+{
+    struct keyboard_layout *layout;
+    UINT id = 0x100;
+
+    RB_FOR_EACH_ENTRY( layout, &keyboard_layouts, struct keyboard_layout, entry )
+    {
+        if (klid == layout->klid) return layout;
+        if ((layout->id & 0xfff) >= id) id = (layout->id & 0xfff) + 1;
+    }
+
+    if (next_id) *next_id = id;
+    return NULL;
+}
+
+static HKL add_layout( LANGID lang, const char *variant, BOOL ime, UINT_PTR host_id )
+{
+    struct keyboard_layout *layout;
+    UINT next_id, klid;
+
+    TRACE_(keyboard)( "lang %04x variant %s ime %u host_id %#zx\n", lang, debugstr_a(variant), ime, host_id );
+
+    klid = variant && *variant ? klid_from_lang_variant( lang, variant ) : klid_from_lang( lang );
+    if (!variant) variant = ""; /* to avoid NULL checks from now on */
+
+    if ((layout = get_keyboard_layout_from_klid( klid, &next_id )))
+    {
+        BOOL loaded = layout->host_id != -1;
+        if (loaded && !strcmp( layout->variant, variant ))
+        {
+            WARN_(keyboard)( "Keeping duplicate layout %s\n", debugstr_keyboard_layout( layout ) );
+            goto done;
+        }
+
+        free( layout->variant );
+        layout->variant = strdup( variant );
+        layout->host_id = host_id;
+
+        if (loaded) WARN_(keyboard)( "Replacing layout with %s\n", debugstr_keyboard_layout( layout ) );
+        else TRACE_(keyboard)( "Loading known layout %s\n", debugstr_keyboard_layout( layout ) );
+    }
+    else if (!(layout = calloc( 1, sizeof(*layout) ))) return 0;
+    else
+    {
+        layout->klid = klid;
+        layout->id = HIWORD(klid) ? (ime ? 0xe000 : 0xf000) | next_id : 0;
+        layout->variant = strdup( variant );
+        layout->host_id = host_id;
+        add_keyboard_layout( layout );
+        TRACE_(keyboard)( "Created new layout %s\n", debugstr_keyboard_layout( layout ) );
+    }
+
+done:
+    return get_hkl( layout );
+}
+
+/* load the active keyboard layouts on the host */
+static void load_keyboard_layouts(void)
+{
+    const struct keyboard_funcs keyboard_funcs =
+    {
+        add_layout,
+    };
+
+    user_driver->pUpdateKeyboardLayouts( &keyboard_funcs );
+}
+
+static HANDLE get_keyboard_layout_preload_mutex( void )
+{
+    WCHAR bufferW[256];
+    UNICODE_STRING name = {.Buffer = bufferW};
+    OBJECT_ATTRIBUTES attr;
+    char buffer[256];
+    HANDLE mutex;
+
+    snprintf( buffer, ARRAY_SIZE(buffer), "\\Sessions\\%u\\BaseNamedObjects\\keyboard_layout_reg_init",
+              RtlGetCurrentPeb()->SessionId );
+    name.MaximumLength = asciiz_to_unicode( bufferW, buffer );
+    name.Length = name.MaximumLength - sizeof(WCHAR);
+
+    InitializeObjectAttributes( &attr, &name, OBJ_OPENIF, NULL, NULL );
+    if (NtCreateMutant( &mutex, MUTEX_ALL_ACCESS, &attr, FALSE ) < 0) return 0;
+    NtWaitForSingleObject( mutex, FALSE, NULL );
+    return mutex;
+}
+
+static void release_keyboard_layout_preload_mutex( HANDLE mutex )
+{
+    NtReleaseMutant( mutex, NULL );
+    NtClose( mutex );
+}
+
+static void update_layout_cache(void)
+{
+    struct keyboard_layout *layout;
+    HKEY hkey;
+
+    if (keyboard_layouts_loaded) return;
+
+    if (!keyboard_layouts_key && !(keyboard_layouts_key = reg_create_ascii_key( NULL, keyboard_layouts_keyA, 0, NULL ))) return;
+    if (!keyboard_layouts_inited)
+    {
+        rb_init(&keyboard_layouts, keyboard_layouts_map_cmp);
+        read_keyboard_layouts( keyboard_layouts_key );
+        keyboard_layouts_inited = TRUE;
+    }
+
+    RB_FOR_EACH_ENTRY( layout, &keyboard_layouts, struct keyboard_layout, entry )
+        layout->host_id = -1;
+    load_keyboard_layouts();
+
+    if ((hkey = reg_create_ascii_key( hkcu_key, "Keyboard Layout\\Preload", 0, NULL )))
+    {
+        char index[16], name[KL_NAMELENGTH];
+        HANDLE mutex;
+        int i = 0;
+
+        mutex = get_keyboard_layout_preload_mutex();
+        reg_empty_key( hkey, NULL, FALSE );
+
+        RB_FOR_EACH_ENTRY( layout, &keyboard_layouts, struct keyboard_layout, entry )
+        {
+            if (layout->host_id == -1) continue;
+            sprintf( index, "%u", ++i );
+            sprintf( name, "%08X", layout->klid );
+            set_reg_ascii_value( hkey, index, name );
+        }
+
+        release_keyboard_layout_preload_mutex( mutex );
+        NtClose( hkey );
+    }
+
+    keyboard_layouts_loaded = TRUE;
+}
+
+static void lock_keyboard_layouts(void)
+{
+    pthread_mutex_lock( &keyboard_layouts_lock );
+    update_layout_cache();
+}
+
+static void unlock_keyboard_layouts(void)
+{
+    pthread_mutex_unlock( &keyboard_layouts_lock );
+}
+
+void keyboard_layouts_init( BOOL changed )
+{
+    pthread_mutex_lock( &keyboard_layouts_lock );
+    if (changed) keyboard_layouts_loaded = FALSE;
+    else update_layout_cache();
+    pthread_mutex_unlock( &keyboard_layouts_lock );
+}
