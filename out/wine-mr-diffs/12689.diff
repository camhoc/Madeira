     {
@@ -1360,16 +1437,18 @@ int CDECL _vcomp_for_dynamic_next(unsigned int *begin, unsigned int *end)
     else if (thread_data->dynamic_type == VCOMP_DYNAMIC_FLAGS_CHUNKED ||
              thread_data->dynamic_type == VCOMP_DYNAMIC_FLAGS_GUIDED)
     {
-        unsigned int iterations = 0;
+        ULONG64 iterations = 0;
         EnterCriticalSection(&vcomp_section);
         if (thread_data->dynamic == task_data->dynamic &&
             task_data->dynamic_iterations != 0)
         {
             iterations = min(task_data->dynamic_iterations, task_data->dynamic_chunksize);
             if (thread_data->dynamic_type == VCOMP_DYNAMIC_FLAGS_GUIDED &&
+                task_data->dynamic_chunksize <= ~(ULONG64)0 / num_threads &&
                 task_data->dynamic_iterations > num_threads * task_data->dynamic_chunksize)
             {
-                iterations = (task_data->dynamic_iterations + num_threads - 1) / num_threads;
+                iterations = task_data->dynamic_iterations / num_threads;
+                if (task_data->dynamic_iterations % num_threads) iterations++;
             }
             *begin = task_data->dynamic_first;
             *end   = task_data->dynamic_first + (iterations - 1) * task_data->dynamic_step;
@@ -1385,6 +1464,28 @@ int CDECL _vcomp_for_dynamic_next(unsigned int *begin, unsigned int *end)
     return 0;
 }
 
+int CDECL _vcomp_for_dynamic_next(unsigned int *begin, unsigned int *end)
+{
+    ULONG64 b, e;
+    int ret;
+
+    TRACE("(%p, %p)\n", begin, end);
+
+    ret = vcomp_for_dynamic_next(&b, &e);
+    if (ret)
+    {
+        *begin = b;
+        *end   = e;
+    }
+    return ret;
+}
+
+int CDECL _vcomp_for_dynamic_next_i8(ULONG64 *begin, ULONG64 *end)
+{
+    TRACE("(%p, %p)\n", begin, end);
+    return vcomp_for_dynamic_next(begin, end);
+}
