+struct method_iterator
+{
+    statement_list_t *stmts_list;
+    const statement_t *stmt;
+    unsigned int count, pos;
+    const statement_t **methods;
+};
+
+bool method_iterator_next(struct method_iterator *mthiter)
+{
+    if (mthiter->methods)
+    {
+        if (mthiter->pos >= mthiter->count)
+        {
+            mthiter->stmt = NULL;
+            return false;
+        }
+        mthiter->stmt = mthiter->methods[mthiter->pos++];
+        return true;
+    }
+    if (!mthiter->stmt) return false;
+    for (;;)
+    {
+        mthiter->stmt = LIST_ENTRY((mthiter->stmt)->entry.next, statement_t, entry);
+        if (&mthiter->stmt->entry == mthiter->stmts_list) break;
+        if (mthiter->stmt->type == STMT_DECLARATION && mthiter->stmt->u.var->declspec.stgclass == STG_NONE &&
+            type_get_type_detect_alias(mthiter->stmt->u.var->declspec.type) == TYPE_FUNCTION)
+            return true;
+    }
+    mthiter->stmt = NULL;
+    return false;
+}
+
+void method_iterator_reset(struct method_iterator *mthiter)
+{
+    if (mthiter->methods)
+        mthiter->pos = 0;
+    else if (mthiter->stmts_list)
+        mthiter->stmt = LIST_ENTRY(mthiter->stmts_list, statement_t, entry);
+    else
+        mthiter->stmt = NULL;
+}
+
+void method_iterator_init(struct method_iterator *mthiter, const type_t *iface, bool msvc_order)
+{
+    mthiter->stmts_list = type_iface_get_stmts(iface);
+    mthiter->count = 0;
+    mthiter->pos = 0;
+    mthiter->methods = 0;
+    if (msvc_order)
+    {
+        const statement_t *stmt1, *stmt2;
+        const var_t *func1, *func2;
+        char func1_name[256];
+        unsigned int count = 0;
+        bool has_overloaded = false;
+
+        STATEMENTS_FOR_EACH_FUNC(stmt1, type_iface_get_stmts(iface))
+        {
+            count++;
+            if (has_overloaded) continue;
+
+            func1 = stmt1->u.var;
+            strcpy(func1_name, get_name(func1));
+
+            STATEMENTS_FOR_EACH_FUNC(stmt2, type_iface_get_stmts(iface))
+            {
+                if (stmt2 == stmt1) break;
+                func2 = stmt2->u.var;
+
+                if (!strcmp(func1_name, get_name(func2)))
+                {
+                    if (!get_attrp(func1->attrs, ATTR_METHOD_NAME))
+                        warning_at(&func1->where, "Suspicious overloaded methods without method_name\n");
+
+                    has_overloaded = true;
+                    break;
+                }
+            }
+        }
+        if (has_overloaded && count)
+        {
+            unsigned int i, j;
+            mthiter->count = count;
+            mthiter->methods = xmalloc(count * sizeof(mthiter->methods[0]));
+
+            i = 0;
+            STATEMENTS_FOR_EACH_FUNC(stmt1, type_iface_get_stmts(iface))
+            {
+                func1 = stmt1->u.var;
+                strcpy(func1_name, get_name(func1));
+
+                for (j = 0; j < i; j++)
+                    if (!strcmp(func1_name, get_name(mthiter->methods[j]->u.var))) break;
+
+                if (j < i)
+                {
+                    memmove(&mthiter->methods[j + 1], &mthiter->methods[j], (i - j) * sizeof(mthiter->methods[0]));
+                    mthiter->methods[j] = stmt1;
+                }
+                else
+                    mthiter->methods[i] = stmt1;
+                i++;
+            }
+            assert(i == count);
+        }
+    }
+    method_iterator_reset(mthiter);
+}
+
+void method_iterator_dispose(struct method_iterator *mthiter)
+{
+    free(mthiter->methods);
+}
