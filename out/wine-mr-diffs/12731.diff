+static HRESULT game_input_query_interface( struct game_input *impl, REFIID iid, void **out )
+{
+    TRACE( "impl %p, iid %s, out %p.\n", impl, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_v0_IGameInput ))
+        *out = &impl->v0_IGameInput_iface;
+    else if (IsEqualGUID( iid, &IID_v2_IGameInput ))
+        *out = &impl->v2_IGameInput_iface;
+    else
+    {
+        *out = NULL;
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG game_input_add_ref( struct game_input *impl )
+{
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "impl %p increasing refcount to %lu.\n", impl, ref );
+    return ref;
+}
+
+static ULONG game_input_release( struct game_input *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "impl %p decreasing refcount to %lu.\n", impl, ref );
+    return ref;
+}
+
+static uint64_t game_input_timestamp(void)
+{
+    LARGE_INTEGER counter, freq;
+
+    QueryPerformanceCounter( &counter );
+    QueryPerformanceFrequency( &freq );
+    return counter.QuadPart / freq.QuadPart * 1000000 + counter.QuadPart % freq.QuadPart * 1000000 / freq.QuadPart;
+}
+
+static inline struct game_input *impl_from_v0_IGameInput( v0_IGameInput *iface )
+{
+    return CONTAINING_RECORD( iface, struct game_input, v0_IGameInput_iface );
+}
