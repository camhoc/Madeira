+static HRESULT (WINAPI *pGameInputCreate)( v0_IGameInput **out );
+
+static BOOL load_gameinput(void)
+{
+    HMODULE module = LoadLibraryW( L"gameinput.dll" );
+
+    if (!module || !(pGameInputCreate = (void *)GetProcAddress( module, "GameInputCreate" )))
+    {
+        win_skip( "GameInputCreate not found, skipping tests.\n" );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static v0_IGameInput *create_game_input(void)
+{
+    v0_IGameInput *gi0 = (void *)0xdeadbeef;
+    HRESULT hr;
+
+    hr = pGameInputCreate( &gi0 );
+    ok( hr == S_OK || broken(hr == E_NOTIMPL), "GameInputCreate returned %#lx\n", hr );
+    if (hr != S_OK) return NULL;
+    return gi0;
+}
+
+static void check_query_interface( IUnknown *iface, const char *name, IUnknown *identity )
+{
+    static const IID *iids[] = {&IID_IUnknown, &IID_v0_IGameInput, &IID_v2_IGameInput};
+    IUnknown *unk;
+    HRESULT hr;
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(iids); i++)
+    {
+        unk = (void *)0xdeadbeef;
+        hr = IUnknown_QueryInterface( iface, iids[i], (void **)&unk );
+        ok( hr == S_OK || broken(i == 2 && hr == E_NOINTERFACE), "%s: QueryInterface %s returned %#lx\n",
+            name, debugstr_guid(iids[i]), hr );
+        if (hr != S_OK) continue;
+        if (i == 0) ok( unk == identity, "%s: got IUnknown %p, expected %p\n", name, unk, identity );
+        IUnknown_Release( unk );
+    }
+
+    unk = (void *)0xdeadbeef;
+    hr = IUnknown_QueryInterface( iface, &IID_IAgileObject, (void **)&unk );
+    ok( hr == E_NOINTERFACE, "%s: QueryInterface IAgileObject returned %#lx\n", name, hr );
+    ok( !unk, "%s: got %p\n", name, unk );
+}
+
+static void test_create(void)
+{
+    v0_IGameInput *gi0, *gi0_2;
+    v2_IGameInput *gi2;
+    IUnknown *unk;
+    HRESULT hr;
+    ULONG ref;
+
+    if (!(gi0 = create_game_input())) return;
+
+    ref = v0_IGameInput_AddRef( gi0 );
+    ok( ref == 2, "got ref %lu\n", ref );
+    ref = v0_IGameInput_Release( gi0 );
+    ok( ref == 1, "got ref %lu\n", ref );
+
+    hr = pGameInputCreate( NULL );
+    ok( hr == E_POINTER, "GameInputCreate returned %#lx\n", hr );
+
+    hr = pGameInputCreate( &gi0_2 );
+    ok( hr == S_OK, "GameInputCreate returned %#lx\n", hr );
+    ok( gi0_2 == gi0, "got %p, expected %p\n", gi0_2, gi0 );
+    ref = v0_IGameInput_Release( gi0_2 );
+    ok( ref == 1, "got ref %lu\n", ref );
+
+    hr = v0_IGameInput_QueryInterface( gi0, &IID_IUnknown, (void **)&unk );
+    ok( hr == S_OK, "QueryInterface IUnknown returned %#lx\n", hr );
+    check_query_interface( (IUnknown *)gi0, "v0", unk );
+
+    hr = v0_IGameInput_QueryInterface( gi0, &IID_v2_IGameInput, (void **)&gi2 );
+    ok( hr == S_OK || broken(hr == E_NOINTERFACE), "QueryInterface v2 returned %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        check_query_interface( (IUnknown *)gi2, "v2", unk );
+        ref = v2_IGameInput_Release( gi2 );
+        ok( ref == 2, "got ref %lu\n", ref );
+    }
+
+    ref = IUnknown_Release( unk );
+    ok( ref == 1, "got ref %lu\n", ref );
+    ref = v0_IGameInput_Release( gi0 );
+    ok( ref == 0, "got ref %lu\n", ref );
+}
+
+static UINT64 elapsed_us( LARGE_INTEGER start )
+{
+    LARGE_INTEGER now, freq;
+
+    QueryPerformanceCounter( &now );
+    QueryPerformanceFrequency( &freq );
+    return (now.QuadPart - start.QuadPart) * 1000000 / freq.QuadPart;
+}
+
+static void test_timestamp(void)
+{
+    UINT64 t0, t1, t2, elapsed;
+    v0_IGameInput *gi0;
+    v2_IGameInput *gi2;
+    LARGE_INTEGER start;
+    HRESULT hr;
+
+    if (!(gi0 = create_game_input())) return;
+
+    QueryPerformanceCounter( &start );
+    t0 = v0_IGameInput_GetCurrentTimestamp( gi0 );
+    Sleep( 100 );
+    t1 = v0_IGameInput_GetCurrentTimestamp( gi0 );
+    elapsed = elapsed_us( start );
+    ok( t1 > t0, "got %I64u then %I64u\n", t0, t1 );
+    ok( t1 - t0 >= elapsed / 2 && t1 - t0 <= elapsed * 2, "got %I64u then %I64u, elapsed %I64u us\n", t0, t1, elapsed );
+
+    hr = v0_IGameInput_QueryInterface( gi0, &IID_v2_IGameInput, (void **)&gi2 );
+    if (hr == S_OK)
+    {
+        t0 = v0_IGameInput_GetCurrentTimestamp( gi0 );
+        Sleep( 10 );
+        t1 = v2_IGameInput_GetCurrentTimestamp( gi2 );
+        Sleep( 10 );
+        t2 = v0_IGameInput_GetCurrentTimestamp( gi0 );
+        ok( t0 < t1 && t1 < t2, "got %I64u, %I64u, %I64u\n", t0, t1, t2 );
+        v2_IGameInput_Release( gi2 );
+    }
+
+    v0_IGameInput_Release( gi0 );
+}
+
+START_TEST(gameinput)
+{
+    if (!load_gameinput()) return;
+
+    test_create();
+    test_timestamp();
+}

