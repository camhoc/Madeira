+/* wait for handle while dispatching messages, at most 10 seconds */
+static DWORD wait_dispatching(HANDLE handle)
+{
+    DWORD start = GetTickCount(), elapsed, ret;
+    MSG msg;
+
+    while ((elapsed = GetTickCount() - start) < 10000)
+    {
+        ret = MsgWaitForMultipleObjects(1, &handle, FALSE, 10000 - elapsed, QS_ALLINPUT);
+        if (ret != WAIT_OBJECT_0 + 1) return ret;
+        while (PeekMessageA(&msg, NULL, 0, 0, PM_REMOVE)) DispatchMessageA(&msg);
+    }
+    return WAIT_TIMEOUT;
+}
+
+static DWORD WINAPI context_callback_remote_thread(void *arg)
+{
+    struct context_callback_arg *ctx = arg;
+    HRESULT hr;
+
+    CoInitializeEx(NULL, ctx->is_mta ? COINIT_APARTMENTTHREADED : COINIT_MULTITHREADED);
+
+    hr = CoGetCurrentLogicalThreadId(&ctx->logical_thread_id);
+    ok_ole_success(hr, "CoGetCurrentLogicalThreadId");
+
+    SET_EXPECT(context_callback_func);
+    hr = IContextCallback_ContextCallback(ctx->context_callback, context_callback_func,
+            (ComCallData *)ctx, &IID_IContextCallback, 2, NULL);
+    CHECK_CALLED(context_callback_func, 1);
+    ok(hr == S_FALSE, "got 0x%08lx\n", hr);
+
+    CoUninitialize();
+    return 0;
+}
+
+static BOOL call_context_callback_remote(struct context_callback_arg *arg)
+{
+    HANDLE thread;
+    DWORD ret;
+
+    thread = CreateThread(NULL, 0, context_callback_remote_thread, arg, 0, NULL);
+    ok(thread != NULL, "CreateThread failed\n");
+    ret = wait_dispatching(thread);
+    ok(!ret, "caller thread did not finish, ret %#lx\n", ret);
+    CloseHandle(thread);
+    return !ret;
+}
+
+struct context_callback_target
+{
+    struct context_callback_arg arg;
+    DWORD model;
+    HANDLE ready, done, thread;
+};
+
+static DWORD WINAPI context_callback_target_thread(void *arg)
+{
+    struct context_callback_target *t = arg;
+    HRESULT hr;
+    GUID id;
+
+    CoInitializeEx(NULL, t->model);
+
+    /* nothing is marshalled by this apartment */
+    hr = pCoGetObjectContext(&IID_IContextCallback, (void **)&t->arg.context_callback);
+    ok_ole_success(hr, "CoGetObjectContext");
+    hr = pCoGetContextToken(&t->arg.token);
+    ok_ole_success(hr, "CoGetContextToken");
+
+    SetEvent(t->ready);
+    wait_dispatching(t->done);
+
+    /* the incoming call does not leave the caller's logical thread id behind */
+    hr = CoGetCurrentLogicalThreadId(&id);
+    ok_ole_success(hr, "CoGetCurrentLogicalThreadId");
+    ok(!IsEqualGUID(&id, &GUID_NULL) && !IsEqualGUID(&id, &t->arg.logical_thread_id),
+            "thread_id = %s\n", wine_dbgstr_guid(&id));
+
+    IContextCallback_Release(t->arg.context_callback);
+    CoUninitialize();
+    return 0;
+}
+
+static BOOL start_context_callback_target(struct context_callback_target *t, DWORD model)
+{
+    DWORD ret;
+
+    t->model = model;
+    t->ready = CreateEventW(NULL, FALSE, FALSE, NULL);
+    t->done = CreateEventW(NULL, FALSE, FALSE, NULL);
+    t->thread = CreateThread(NULL, 0, context_callback_target_thread, t, 0, NULL);
+    ok(t->thread != NULL, "CreateThread failed\n");
+    ret = WaitForSingleObject(t->ready, 10000);
+    ok(!ret, "target thread not ready, ret %#lx\n", ret);
+    return !ret;
+}
+
+static BOOL stop_context_callback_target(struct context_callback_target *t)
+{
+    DWORD ret;
+
+    SetEvent(t->done);
+    ret = WaitForSingleObject(t->thread, 10000);
+    ok(!ret, "target thread did not finish, ret %#lx\n", ret);
+    CloseHandle(t->thread);
+    CloseHandle(t->ready);
+    CloseHandle(t->done);
+    return !ret;
+}
+
+static void test_ContextCallback_remote(void)
+{
+    static struct context_callback_target sta_target, mta_target;
+    static struct context_callback_arg arg;
+    GUID id, id2;
+    HRESULT hr;
+
+    if (!pCoGetObjectContext)
+    {
+        win_skip("CoGetObjectContext not present\n");
+        return;
+    }
+
+    /* main STA, nothing marshalled before the MTA caller calls into its context */
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    hr = CoGetCurrentLogicalThreadId(&id);
+    ok_ole_success(hr, "CoGetCurrentLogicalThreadId");
+    hr = pCoGetObjectContext(&IID_IContextCallback, (void **)&arg.context_callback);
+    ok_ole_success(hr, "CoGetObjectContext");
+    hr = pCoGetContextToken(&arg.token);
+    ok_ole_success(hr, "CoGetContextToken");
+    arg.is_mta = FALSE;
+    if (!call_context_callback_remote(&arg))
+    {
+        CoUninitialize();
+        return;
+    }
+    /* the incoming call restores this thread's logical thread id */
+    hr = CoGetCurrentLogicalThreadId(&id2);
+    ok_ole_success(hr, "CoGetCurrentLogicalThreadId");
+    ok(IsEqualGUID(&id2, &id), "thread_id = %s\n", wine_dbgstr_guid(&id2));
+    IContextCallback_Release(arg.context_callback);
+    CoUninitialize();
+
+    /* non-main STA, this thread keeps the main STA */
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    if (!start_context_callback_target(&sta_target, COINIT_APARTMENTTHREADED))
+    {
+        CoUninitialize();
+        return;
+    }
+    sta_target.arg.is_mta = FALSE;
+    if (!call_context_callback_remote(&sta_target.arg) || !stop_context_callback_target(&sta_target))
+    {
+        CoUninitialize();
+        return;
+    }
+    CoUninitialize();
+
+    /* MTA, called from an STA */
+    if (!start_context_callback_target(&mta_target, COINIT_MULTITHREADED)) return;
+    mta_target.arg.is_mta = TRUE;
+    if (call_context_callback_remote(&mta_target.arg))
+        stop_context_callback_target(&mta_target);
+}
