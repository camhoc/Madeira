+DEFINE_ASYNC_COMPLETED_HANDLER( async_storage_file_handler, IAsyncOperationCompletedHandler_StorageFile, IAsyncOperation_StorageFile )
+
+#define get_file_from_path( a, b, c, d ) get_file_from_path_( __LINE__, a, b, c, d )
+static void get_file_from_path_( unsigned int line, IStorageFileStatics *statics, const WCHAR *path, HRESULT expect_hr,
+                                 IStorageFile **file )
+{
+    IAsyncOperation_StorageFile *operation = NULL;
+    HSTRING str;
+    HRESULT hr;
+    DWORD ret;
+
+    *file = NULL;
+
+    hr = WindowsCreateString( path, wcslen( path ), &str );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IStorageFileStatics_GetFileFromPathAsync( statics, str, &operation );
+    WindowsDeleteString( str );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+
+    ret = await_IAsyncOperation_StorageFile( operation, 5000 );
+    ok_(__FILE__, line)( !ret, "await returned %#lx.\n", ret );
+    check_async_info_( line, operation, expect_hr == S_OK ? Completed : Error, expect_hr );
+
+    hr = IAsyncOperation_StorageFile_GetResults( operation, file );
+    ok_(__FILE__, line)( hr == expect_hr, "got hr %#lx.\n", hr );
+    if (expect_hr == S_OK) ok_(__FILE__, line)( *file != NULL, "got NULL file.\n" );
+    else if (*file)
+    {
+        IStorageFile_Release( *file );
+        *file = NULL;
+    }
+
+    IAsyncOperation_StorageFile_Release( operation );
+}
+
+#define check_hstring( a, b ) check_hstring_( __LINE__, a, b )
+static void check_hstring_( unsigned int line, HSTRING str, const WCHAR *expect )
+{
+    const WCHAR *buffer = WindowsGetStringRawBuffer( str, NULL );
+    ok_(__FILE__, line)( !wcscmp( buffer, expect ), "got %s, expected %s.\n", debugstr_w( buffer ), debugstr_w( expect ) );
+    WindowsDeleteString( str );
+}
+
+static void test_StorageFile(void)
+{
+    static const WCHAR *storage_file_name = L"Windows.Storage.StorageFile";
+    IStorageFileStatics *statics = (void *)0xdeadbeef;
+    IActivationFactory *factory = (void *)0xdeadbeef;
+    WCHAR dir[MAX_PATH], path[MAX_PATH], cwd[MAX_PATH];
+    WIN32_FILE_ATTRIBUTE_DATA data;
+    SYSTEMTIME system_time = {2037, 1, 4, 1};
+    IStorageItem *item;
+    IStorageFile *file;
+    FILETIME write_time;
+    FileAttributes attributes;
+    DateTime date;
+    boolean is_type;
+    HSTRING str;
+    HANDLE handle;
+    DWORD written, len;
+    HRESULT hr;
+
+    hr = WindowsCreateString( storage_file_name, wcslen( storage_file_name ), &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+
+    check_interface( factory, &IID_IUnknown, FALSE );
+    check_interface( factory, &IID_IInspectable, FALSE );
+    check_interface( factory, &IID_IAgileObject, TRUE /* Supported after Windows 10 1607 */ );
+
+    hr = IActivationFactory_QueryInterface( factory, &IID_IStorageFileStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    len = GetTempPathW( ARRAY_SIZE(dir), dir );
+    ok( len && len < ARRAY_SIZE(dir), "GetTempPathW returned %lu.\n", len );
+    len = GetLongPathNameW( dir, dir, ARRAY_SIZE(dir) );
+    ok( len && len < ARRAY_SIZE(dir), "GetLongPathNameW returned %lu.\n", len );
+    wcscpy( path, dir );
+    wcscat( path, L"wine_storagefile_test.txt" );
+
+    handle = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    ok( handle != INVALID_HANDLE_VALUE, "CreateFileW failed, error %lu.\n", GetLastError() );
+    ok( WriteFile( handle, "wine", 4, &written, NULL ), "WriteFile failed, error %lu.\n", GetLastError() );
+    ok( SystemTimeToFileTime( &system_time, &write_time ), "SystemTimeToFileTime failed.\n" );
+    ok( SetFileTime( handle, NULL, NULL, &write_time ), "SetFileTime failed, error %lu.\n", GetLastError() );
+    CloseHandle( handle );
+
+    get_file_from_path( statics, path, S_OK, &file );
+    if (file)
+    {
+        check_interface( file, &IID_IStorageItem, FALSE );
+        check_interface( file, &IID_IAgileObject, FALSE );
+
+        str = NULL;
+        hr = IStorageFile_GetRuntimeClassName( file, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, storage_file_name );
+
+        hr = IStorageFile_QueryInterface( file, &IID_IStorageItem, (void **)&item );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+        str = NULL;
+        hr = IStorageItem_get_Name( item, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, L"wine_storagefile_test.txt" );
+
+        str = NULL;
+        hr = IStorageItem_get_Path( item, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, path );
+
+        is_type = 2;
+        hr = IStorageItem_IsOfType( item, StorageItemTypes_File, &is_type );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( is_type == TRUE, "got %d.\n", is_type );
+        is_type = 2;
+        hr = IStorageItem_IsOfType( item, StorageItemTypes_Folder, &is_type );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( is_type == FALSE, "got %d.\n", is_type );
+
+        attributes = FileAttributes_ReadOnly | FileAttributes_Directory;
+        hr = IStorageItem_get_Attributes( item, &attributes );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( !(attributes & (FileAttributes_ReadOnly | FileAttributes_Directory)), "got %#x.\n", attributes );
+
+        ok( GetFileAttributesExW( path, GetFileExInfoStandard, &data ), "GetFileAttributesExW failed, error %lu.\n", GetLastError() );
+        date.UniversalTime = 0;
+        hr = IStorageItem_get_DateCreated( item, &date );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( date.UniversalTime == (((INT64)data.ftCreationTime.dwHighDateTime << 32) | data.ftCreationTime.dwLowDateTime),
+                      "got %I64d.\n", date.UniversalTime );
+
+        str = NULL;
+        hr = IStorageFile_get_FileType( file, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, L".txt" );
+
+        str = NULL;
+        hr = IStorageFile_get_ContentType( file, &str );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_hstring( str, L"text/plain" );
+
+        ok( SetFileAttributesW( path, FILE_ATTRIBUTE_READONLY ), "SetFileAttributesW failed, error %lu.\n", GetLastError() );
+        attributes = FileAttributes_ReadOnly;
+        hr = IStorageItem_get_Attributes( item, &attributes );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( !(attributes & FileAttributes_ReadOnly), "got %#x.\n", attributes );
+        SetFileAttributesW( path, FILE_ATTRIBUTE_NORMAL );
+
+        IStorageItem_Release( item );
+        IStorageFile_Release( file );
+    }
+
+    wcscpy( cwd, dir );
+    wcscat( cwd, L"wine_storagefile_missing.txt" );
+    get_file_from_path( statics, cwd, HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), &file );
+
+    GetCurrentDirectoryW( ARRAY_SIZE(cwd), cwd );
+    SetCurrentDirectoryW( dir );
+    get_file_from_path( statics, L"wine_storagefile_test.txt", E_INVALIDARG, &file );
+    SetCurrentDirectoryW( cwd );
+
+    get_file_from_path( statics, L"", E_INVALIDARG, &file );
+
+    dir[wcslen( dir ) - 1] = 0;
+    get_file_from_path( statics, dir, E_INVALIDARG, &file );
+
+    ok( DeleteFileW( path ), "DeleteFileW failed, error %lu.\n", GetLastError() );
+
+    IStorageFileStatics_Release( statics );
+    IActivationFactory_Release( factory );
+}
