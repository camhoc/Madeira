+static void test_tcp_initial_rto(void)
+{
+    static const TCP_INITIAL_RTO_PARAMETERS tests[] =
+    {
+        {TCP_INITIAL_RTO_UNSPECIFIED_RTT, TCP_INITIAL_RTO_UNSPECIFIED_MAX_SYN_RETRANSMISSIONS},
+        {TCP_INITIAL_RTO_DEFAULT_RTT, TCP_INITIAL_RTO_DEFAULT_MAX_SYN_RETRANSMISSIONS},
+        {TCP_INITIAL_RTO_UNSPECIFIED_RTT, TCP_INITIAL_RTO_NO_SYN_RETRANSMISSIONS},
+        {500, 2},
+    };
+    struct sockaddr_in addr;
+    SOCKET listener, client, server;
+    int ret, len;
+    DWORD size;
+    unsigned int i;
+
+    listener = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    ok(listener != INVALID_SOCKET, "got error %u\n", WSAGetLastError());
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    ret = bind(listener, (struct sockaddr *)&addr, sizeof(addr));
+    ok(!ret, "got error %u\n", WSAGetLastError());
+    len = sizeof(addr);
+    ret = getsockname(listener, (struct sockaddr *)&addr, &len);
+    ok(!ret, "got error %u\n", WSAGetLastError());
+    ret = listen(listener, 1);
+    ok(!ret, "got error %u\n", WSAGetLastError());
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("rtt %u, max retransmissions %u", tests[i].Rtt, tests[i].MaxSynRetransmissions);
+
+        client = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+        ok(client != INVALID_SOCKET, "got error %u\n", WSAGetLastError());
+
+        WSASetLastError(0xdeadbeef);
+        size = 0xdeadbeef;
+        ret = WSAIoctl(client, SIO_TCP_INITIAL_RTO, (void *)&tests[i], sizeof(tests[i]), NULL, 0, &size, NULL, NULL);
+        ok(!ret, "got %d, error %u\n", ret, WSAGetLastError());
+
+        ret = connect(client, (struct sockaddr *)&addr, sizeof(addr));
+        ok(!ret, "got error %u\n", WSAGetLastError());
+        server = accept(listener, NULL, NULL);
+        ok(server != INVALID_SOCKET, "got error %u\n", WSAGetLastError());
+
+        closesocket(server);
+        closesocket(client);
+        winetest_pop_context();
+    }
+
+    closesocket(listener);
+}
