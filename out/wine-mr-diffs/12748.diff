# Draft: ws2_32: Support IP_ECN / IPV6_ECN and implement SIO_TCP_INITIAL_RTO
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12748 state=opened
# Two missing socket features in ws2_32, with the matching ntdll/afd plumbing.

- Support the IP_ECN / IPV6_ECN socket options. IP_RECVECN / IPV6_RECVECN
  (value 50) are mapped to IP_RECVTOS / IPV6_RECVTCLASS, and the ECN bits of
  the received TOS / traffic class are reported in an IP_ECN / IPV6_ECN control
  message. Previously setsockopt() failed with WSAENOPROTOOPT. The ECN message is
  currently emitted whenever TOS / traffic class messages are received,
  regardless of whether the application requested ECN.

- Implement SIO_TCP_INITIAL_RTO. This adds the ioctl and the
  TCP_INITIAL_RTO_PARAMETERS structure, and maps MaxSynRetransmissions to
  TCP_SYNCNT on Linux. Linux has no per-socket initial retransmission timeout,
  so Rtt is currently ignored (a trace message is printed). "No SYN
  retransmissions" is approximated by a single retransmission, as TCP_SYNCNT
  does not accept 0. Previously the ioctl was reported as unimplemented, which
  produced two FIXME messages every time an application used it.

Tests are added to ws2_32:sock for both.

These were found while trying to get the software discussed in the link below
running under Wine. They are not the only fixes needed; I will submit the
remaining ones gradually, as separate merge requests split by topic.

Discussion: https://forum.winehq.org/viewtopic.php?t=34939
--- dlls/ntdll/unix/socket.c
+++ dlls/ntdll/unix/socket.c
@@ -437,6 +437,11 @@ static int convert_control_headers(struct msghdr *hdr, WSABUF *control)
                         ptr = fill_control_message( WS_IPPROTO_IP, WS_IP_TOS, ptr, &ctlsize,
                                                     &tos, sizeof(INT) );
                         if (!ptr) goto error;
+                        /* IP_RECVECN is mapped to IP_RECVTOS, report the ECN bits as well. */
+                        tos &= 3;
+                        ptr = fill_control_message( WS_IPPROTO_IP, WS_IP_ECN, ptr, &ctlsize,
+                                                    &tos, sizeof(INT) );
+                        if (!ptr) goto error;
                         break;
                     }
 #endif /* IP_TOS */
@@ -488,9 +493,15 @@ static int convert_control_headers(struct msghdr *hdr, WSABUF *control)
 #if defined(IPV6_TCLASS)
                     case IPV6_TCLASS:
                     {
+                        INT ecn;
                         ptr = fill_control_message( WS_IPPROTO_IPV6, WS_IPV6_TCLASS, ptr, &ctlsize,
                                                     CMSG_DATA(cmsg_unix), sizeof(INT) );
                         if (!ptr) goto error;
+                        /* IPV6_RECVECN is mapped to IPV6_RECVTCLASS, report the ECN bits as well. */
+                        ecn = *(INT *)CMSG_DATA(cmsg_unix) & 3;
+                        ptr = fill_control_message( WS_IPPROTO_IPV6, WS_IPV6_ECN, ptr, &ctlsize,
+                                                    &ecn, sizeof(INT) );
+                        if (!ptr) goto error;
                         break;
                     }
 #endif /* IPV6_TCLASS */
@@ -2068,6 +2079,46 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
             return STATUS_SUCCESS;
         }
 
+        case IOCTL_AFD_WINE_TCP_INITIAL_RTO:
+        {
+            const TCP_INITIAL_RTO_PARAMETERS *params = in_buffer;
+
+            if (!in_buffer || in_size < sizeof(*params))
+                return STATUS_BUFFER_TOO_SMALL;
+
+            if (get_sock_type( handle ) != SOCK_STREAM)
+                return STATUS_INVALID_PARAMETER;
+
+            if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
+                return status;
+
+            if (params->Rtt != TCP_INITIAL_RTO_UNSPECIFIED_RTT && params->Rtt != TCP_INITIAL_RTO_DEFAULT_RTT)
+                TRACE( "Initial RTO of %u ms is not implemented, ignoring.\n", params->Rtt );
+
+            if (params->MaxSynRetransmissions != TCP_INITIAL_RTO_UNSPECIFIED_MAX_SYN_RETRANSMISSIONS &&
+                params->MaxSynRetransmissions != TCP_INITIAL_RTO_DEFAULT_MAX_SYN_RETRANSMISSIONS)
+            {
+#ifdef TCP_SYNCNT
+                /* Linux does not accept a SYN retransmission count of 0, so "no retransmission"
+                 * is approximated by a single one. */
+                int syncnt = params->MaxSynRetransmissions == TCP_INITIAL_RTO_NO_SYN_RETRANSMISSIONS ?
+                             1 : min( params->MaxSynRetransmissions, 127 );
+
+                if (setsockopt( fd, IPPROTO_TCP, TCP_SYNCNT, &syncnt, sizeof(syncnt) ) < 0)
+                {
+                    status = sock_errno_to_status( errno );
+                    break;
+                }
+#else
+                TRACE( "SYN retransmission count is not implemented, ignoring.\n" );
+#endif
+            }
+
+            if (needs_close) close( fd );
+            file_complete_async( handle, options, event, apc, apc_user, io, STATUS_SUCCESS, 0 );
+            return STATUS_SUCCESS;
+        }
+
         case IOCTL_AFD_WINE_GETPEERNAME:
             if (in_size) FIXME( "unexpected input size %u\n", in_size );
 

