@@ -1004,6 +1020,48 @@ BOOL WAYLAND_SetCursorPos(INT x, INT y)
     return TRUE;
 }
 
+/* Returns the window of the toplevel Wayland surface that the surface of
+ * hwnd is (possibly indirectly) a subsurface of, or hwnd itself. */
+static HWND wayland_surface_root_hwnd(HWND hwnd)
+{
+    struct wayland_win_data *data;
+
+    while ((data = wayland_win_data_get(hwnd)))
+    {
+        HWND owner = NULL;
+
+        if (data->wayland_surface &&
+            data->wayland_surface->role == WAYLAND_SURFACE_ROLE_SUBSURFACE)
+            owner = data->wayland_surface->owner_hwnd;
+        wayland_win_data_release(data);
+        if (!owner) break;
+        hwnd = owner;
+    }
+
+    return hwnd;
+}
+
+/* Returns the window whose surface should get the pointer constraint for
+ * the foreground window. A constraint only activates while its surface has
+ * the pointer focus, so when the foreground window is part of a tree of
+ * subsurfaces (e.g. an owned popup), use the surface of the tree that has
+ * the focus, or the toplevel surface of the tree otherwise. */
+static HWND wayland_pointer_get_constraint_hwnd(HWND hwnd)
+{
+    HWND root = wayland_surface_root_hwnd(hwnd);
+    HWND focused = wayland_pointer_get_focused_hwnd();
+
+    if (focused && wayland_surface_root_hwnd(focused) == root) hwnd = focused;
+    else hwnd = root;
+
+    /* WAYLAND_ClipCursor uses the wl_surface of this window without holding
+     * its win data lock, which is only safe for a window of the current
+     * thread. Fall back to the foreground window otherwise. */
+    if (NtUserGetWindowThread(hwnd, NULL) != GetCurrentThreadId())
+        return NtUserGetForegroundWindow();
+    return hwnd;
+}
+
 /***********************************************************************
  *	     WAYLAND_ClipCursor
  */
@@ -1020,7 +1078,7 @@ BOOL WAYLAND_ClipCursor(const RECT *clip, BOOL reset)
     TRACE("clip=%s reset=%d\n", wine_dbgstr_rect(clip), reset);
 
     NtUserGetCursorPos(&cursor_pos);
-    hwnd = NtUserGetForegroundWindow();
+    hwnd = wayland_pointer_get_constraint_hwnd(NtUserGetForegroundWindow());
 
     if (!(data = wayland_win_data_get(hwnd))) return FALSE;
     if ((surface = data->wayland_surface))
@@ -1071,9 +1129,9 @@ BOOL WAYLAND_ClipCursor(const RECT *clip, BOOL reset)
         pthread_mutex_lock(&pointer->mutex);
     }
 
-   /* Since we are running in the context of the foreground thread we know
-    * that the wl_surface of the foreground HWND will not be invalidated,
-    * so we can access it without having the win data lock. */
+   /* Since we are running in the context of the foreground thread, and
+    * hwnd belongs to it, we know that the wl_surface of hwnd will not be
+    * invalidated, so we can access it without having the win data lock. */
     wayland_pointer_update_constraint(wl_surface,
                                       (clip && wl_surface) ? &confine_rect : NULL,
                                       FALSE);

--- dlls/winewayland.drv/window.c
+++ dlls/winewayland.drv/window.c
@@ -364,6 +364,28 @@ static inline HWND get_active_window(void)
     return NtUserGetGUIThreadInfo(GetCurrentThreadId(), &info) ? info.hwndActive : 0;
 }
 
+/* Checks whether the first managed window in the owner chain of hwnd is
+ * fullscreen. Popups may be owned by other unmanaged popups, e.g. nested
+ * dialogs, which are themselves attached to that window. */
+static BOOL is_owned_by_fullscreen(HWND hwnd)
+{
+    HWND owner = hwnd;
+    struct wayland_win_data *data;
+
+    while ((owner = NtUserGetWindowRelative(owner, GW_OWNER)))
+    {
+        BOOL managed, fullscreen;
+
+        if (!(data = wayland_win_data_get(owner))) return FALSE;
+        managed = data->managed;
+        fullscreen = data->is_fullscreen;
+        wayland_win_data_release(data);
+        if (managed) return fullscreen;
+    }
+
+    return FALSE;
+}
+
 /***********************************************************************
  *		is_window_managed
  *
@@ -376,6 +398,12 @@ static BOOL is_window_managed(HWND hwnd, UINT swp_flags, BOOL fullscreen)
     /* child windows are not managed */
     style = NtUserGetWindowLongW(hwnd, GWL_STYLE);
     if ((style & (WS_CHILD|WS_POPUP)) == WS_CHILD) return FALSE;
+    /* Undecorated popups owned by a fullscreen window (e.g. the menus of
+     * old DirectDraw games) stay attached to their owner, instead of
+     * becoming separate, competing fullscreen toplevels. */
+    if ((style & WS_POPUP) && (style & WS_CAPTION) != WS_CAPTION && !(style & WS_THICKFRAME) &&
+        is_owned_by_fullscreen(hwnd))
+        return FALSE;
     /* activated windows are managed */
     if (!(swp_flags & (SWP_NOACTIVATE|SWP_HIDEWINDOW))) return TRUE;
     if (hwnd == get_active_window()) return TRUE;

