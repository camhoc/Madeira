+static inline void apply_coverage_premul_simple(DWORD *pixels, const BYTE *coverage, INT n, UINT shift)
+{
+    INT i;
+
+    for (i = 0; i < n; i++)
+    {
+        DWORD px = pixels[i], a = ((px >> 24) * (DWORD)coverage[i] + (1u << (shift - 1))) >> shift,
+              b = ((px & 0xff) * a + 127) / 255, g = (((px >> 8) & 0xff) * a + 127) / 255,
+              r = (((px >> 16) & 0xff) * a + 127) / 255;
+        pixels[i] = (a << 24) | (r << 16) | (g << 8) | b;
+    }
+}
+
+#ifdef __SSE2__
+static inline void apply_coverage_premul_sse2(DWORD *pixels, const BYTE *coverage, INT n, UINT shift)
+{
+    const __m128i zero = _mm_setzero_si128(), round = _mm_set1_epi32(1 << (shift - 1)),
+                  shift_count = _mm_cvtsi32_si128(shift), c127 = _mm_set1_epi16(127),
+                  div_255 = _mm_set1_epi16((INT16)0x8081), rgb_mask = _mm_set1_epi32(0x00ffffff);
+    INT i;
+
+    for (i = 0; i + 4 <= n; i += 4)
+    {
+        __m128i c4, prev_alpha, new_alpha, a2, alpha_lo, alpha_hi, px_lo, px_hi, out,
+            px = _mm_loadu_si128((__m128i *)(pixels + i));
+
+        /* Load 4 coverage bytes for the next 4 pixels into bits [31..0]*/
+        c4 = _mm_loadu_si32(coverage + i);
+        /* Broadcast the coverage into the lower byte of every 32-bit lane */
+        c4 = _mm_unpacklo_epi16(_mm_unpacklo_epi8(c4, zero), zero);
+
+        /* Get the previous alpha value (pixels[i] >> 24) */
+        prev_alpha = _mm_srli_epi32(px, 24);
+        /* Equivalent to new_alpha = (prev_alpha + coverage[i] + ss_x) + ss_x*ss_y / 2*/
+        new_alpha = _mm_madd_epi16(prev_alpha, c4);
+        new_alpha = _mm_srl_epi32(_mm_add_epi32(new_alpha, round), shift_count);
+
+        /* Broadcast each alpha across the 4 channels (16-bit lanes) of its pixel
+         * [000000(A0),000000(A1),000000(A2),000000(A3)] -> [00(A0)00(A0),00(A1)00(A1),00(A2)00(A2),00(A3)00(A3)]
+         */
+        a2 = _mm_or_si128(new_alpha, _mm_slli_epi32(new_alpha, 16));
+        /* alpha_lo = [00(A0)00(A0), 00(A0)00(A0), 00(A1)00(A1), 00(A1)00(A1)]*/
+        alpha_lo = _mm_unpacklo_epi32(a2, a2);
+        /* alpha_hi = [00(A2)00(A2), 00(A2)00(A2), 00(A3)00(A3), 00(A3)00(A3)] */
+        alpha_hi = _mm_unpackhi_epi32(a2, a2);
+
+        /* Pixels are [0..31], [32..63], [64..95], [96..128]
+         * px_lo = [00(B0)00(G0), 00(R0)00(A0), 00(B1)00(G1), 00(R1)00(A1)]
+         */
+        px_lo = _mm_unpacklo_epi8(px, zero);
+        /* px_hi = [00(B2)00(G2),00(R2)00(A2),00(B3)00(G3),00(R3)00(A3)]*/
+        px_hi = _mm_unpackhi_epi8(px, zero);
+
+        /* Multiple each 16-bit channel by the new alpha value, add 127 to round.
+         * Channel and alpha can be max 255, so the result wouldn't exceed 255 * 255 + 127 = 65152 */
+        px_lo = _mm_add_epi16(_mm_mullo_epi16(px_lo, alpha_lo), c127);
+        px_hi = _mm_add_epi16(_mm_mullo_epi16(px_hi, alpha_hi), c127);
+        /* (ch * 0x8081) >> 23 gets us the same result as integer division by 255 */
+        px_lo = _mm_srli_epi16(_mm_mulhi_epu16(px_lo, div_255), 7);
+        px_hi = _mm_srli_epi16(_mm_mulhi_epu16(px_hi, div_255), 7);
+
+        /* Pack the premultiplied values into their respective pixel lanes */
+        out = _mm_packus_epi16(px_lo, px_hi);
+        /* Set the alpha-byte of each pixel lane to new_alpha */
+        out = _mm_or_si128(_mm_and_si128(out, rgb_mask), _mm_slli_epi32(new_alpha, 24));
+        _mm_storeu_si128((__m128i *)(pixels + i), out);
+    }
+    apply_coverage_premul_simple(pixels + i, coverage + i, n - i, shift);
+}
+#endif
+
+static void apply_coverage_premul(DWORD *pixels, const BYTE *coverage, INT n, UINT shift)
+{
+#ifdef __SSE2__
+    if (sse2_supported)
+        apply_coverage_premul_sse2(pixels, coverage, n, shift);
+    else
+        apply_coverage_premul_simple(pixels, coverage, n, shift);
+#else
+    apply_coverage_premul_simple(pixels, coverage, n, shift);
+#endif
+}
