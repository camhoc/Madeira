--- dlls/gdi32/tests/font.c
+++ dlls/gdi32/tests/font.c
@@ -7651,6 +7651,74 @@ static void test_char_width(void)
     ReleaseDC(NULL, dc);
 }
 
+static void test_mono_char_width(void)
+{
+    static const MAT2 mat = {{0, 1}, {0, 0}, {0, 0}, {0, 1}};
+    static const LONG weights[] = {FW_NORMAL, FW_BOLD};
+    HFONT hfont, old_hfont;
+    GLYPHMETRICS gm;
+    LOGFONTA lf;
+    char str[0x7f - 0x20];
+    int i, c, height, width, total, mismatches, extent_mismatches;
+    DWORD ret;
+    SIZE size;
+    HDC hdc;
+
+    if (!is_truetype_font_installed("Tahoma"))
+    {
+        skip("Tahoma is not installed\n");
+        return;
+    }
+
+    hdc = CreateCompatibleDC(0);
+    memset(&lf, 0, sizeof(lf));
+    strcpy(lf.lfFaceName, "Tahoma");
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lf.lfQuality = NONANTIALIASED_QUALITY;
+    for (c = 0x20; c < 0x7f; c++) str[c - 0x20] = c;
+
+    mismatches = extent_mismatches = 0;
+    for (i = 0; i < ARRAY_SIZE(weights); i++)
+    {
+        for (height = 8; height <= 16; height++)
+        {
+            winetest_push_context("weight %ld, height %d", weights[i], height);
+            lf.lfHeight = -height;
+            lf.lfWeight = weights[i];
+            hfont = CreateFontIndirectA(&lf);
+            ok(hfont != NULL, "CreateFontIndirectA failed\n");
+            old_hfont = SelectObject(hdc, hfont);
+
+            total = 0;
+            for (c = 0x20; c < 0x7f; c++)
+            {
+                ret = GetGlyphOutlineA(hdc, c, GGO_BITMAP, &gm, 0, NULL, &mat);
+                ok(ret != GDI_ERROR, "GetGlyphOutlineA(%#x) failed\n", c);
+                ret = GetCharWidth32A(hdc, c, c, &width);
+                ok(ret, "GetCharWidth32A(%#x) failed\n", c);
+                if (width != gm.gmCellIncX)
+                {
+                    if (winetest_debug > 1) trace("%#x: width %d, GGO_BITMAP advance %d\n", c, width, gm.gmCellIncX);
+                    mismatches++;
+                }
+                total += gm.gmCellIncX;
+            }
+            ret = GetTextExtentPoint32A(hdc, str, ARRAY_SIZE(str), &size);
+            ok(ret, "GetTextExtentPoint32A failed\n");
+            if (size.cx != total) extent_mismatches++;
+
+            SelectObject(hdc, old_hfont);
+            DeleteObject(hfont);
+            winetest_pop_context();
+        }
+    }
+    ok(!mismatches, "%d characters have a width different from the GGO_BITMAP advance\n", mismatches);
+    ok(!extent_mismatches, "%d text extents differ from the sum of the GGO_BITMAP advances\n",
+       extent_mismatches);
+
+    DeleteDC(hdc);
+}
