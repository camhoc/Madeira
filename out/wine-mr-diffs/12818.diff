# ntdll: Allow querying IPV6_V6ONLY on IPv4 sockets
# https://gitlab.winehq.org/wine/wine/-/merge_requests/12818 state=opened
# On Windows getsockopt(IPPROTO_IPV6, IPV6_V6ONLY) succeeds on an AF_INET socket
and returns 1, while Linux fails it with EOPNOTSUPP. Some applications query
the option on every UDP socket, including IPv4 ones, and fail to start when the
call fails.

Return 1 for IPv4 sockets, and remove the todo_wine from the corresponding
check in ws2_32:sock.

Discussion: https://forum.winehq.org/viewtopic.php?t=34939
--- dlls/ntdll/unix/socket.c
+++ dlls/ntdll/unix/socket.c
@@ -2524,7 +2524,29 @@ NTSTATUS sock_ioctl( HANDLE handle, HANDLE event, PIO_APC_ROUTINE apc, void *apc
 #endif
 
         case IOCTL_AFD_WINE_GET_IPV6_V6ONLY:
+        {
+            union unix_sockaddr addr;
+            socklen_t len = sizeof(addr);
+
+            if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
+                return status;
+
+            if (!getsockname( fd, &addr.addr, &len ) && addr.addr.sa_family == AF_INET)
+            {
+                /* querying IPV6_V6ONLY succeeds on an IPv4 socket, and returns 1 */
+                if (needs_close) close( fd );
+                memset( out_buffer, 0, out_size );
+                if (out_size) *(char *)out_buffer = 1;
+                if (io)
+                {
+                    io->Status = STATUS_SUCCESS;
+                    io->Information = out_size;
+                }
+                return STATUS_SUCCESS;
+            }
+            if (needs_close) close( fd );
             return do_getsockopt( handle, io, IPPROTO_IPV6, IPV6_V6ONLY, out_buffer, out_size );
+        }
 
         case IOCTL_AFD_WINE_SET_IPV6_V6ONLY:
         {

