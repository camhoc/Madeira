+    run_on_d3d10(test_composition_swapchain);
 
     if (!(d3d12_module = LoadLibraryA("d3d12.dll")))
     {
@@ -7736,6 +7866,7 @@ START_TEST(dxgi)
     run_on_d3d12(test_default_fullscreen_target_output);
     run_on_d3d12(test_mode_change);
