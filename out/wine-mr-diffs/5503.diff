-    NULL,                        /* flush */
     NULL,                        /* get_fd_type */
+    NULL,                        /* read */
+    NULL,                        /* write */
+    NULL,                        /* flush */
+    NULL,                        /* get_file_info */
+    NULL,                        /* get_volume_info */
     NULL,                        /* ioctl */
+    NULL,                        /* cancel_async */
     NULL,                        /* queue_async */
     NULL                         /* reselect_async */
 };

