+                    "Got unexpected colour %#lx, expected %#lx.\n", colour, expected_colour);
+            release_resource_readback(&rb);
+
+            IDXGISurface_Release(target_surface);
+            ID2D1Bitmap1_Release(target_bitmap);
+        }
